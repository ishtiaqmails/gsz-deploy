<%- include('../partials/store_top') %>
<%- include('../partials/auth_style') %>
<main class="auth">
  <div class="wrap" style="display:flex;justify-content:center">
    <div class="auth-card">
      <span class="auth-badge"><span class="dot"></span>Account recovery</span>
      <h1>Forgot password</h1>
      <p class="lead">Enter your email or phone number. We'll send a 6-digit reset code to your verified email and/or WhatsApp.</p>
      <% if (error) { %><div class="err"><%= error %></div><% } %>
      <form method="post" action="/forgot" autocomplete="on">
        <label class="fld" for="idf">Email or phone number</label>
        <input id="idf" type="text" name="idf" placeholder="you@email.com  or  92 300 1234567" required autocomplete="username">
        <button class="btn btn-p btn-full" type="submit">Send reset code</button>
      </form>
      <p class="alt">Remembered it? <a href="/login">Back to sign in</a></p>
    </div>
  </div>
</main>
<%- include('../partials/store_bottom') %>
