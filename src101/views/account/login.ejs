<%- include('../partials/store_top') %>
<%- include('../partials/auth_style') %>
<main class="auth">
  <div class="wrap" style="display:flex;justify-content:center">
    <div class="auth-card">
      <span class="auth-badge"><span class="dot"></span>Welcome back</span>
      <h1>Sign in</h1>
      <p class="lead">Access your orders, downloads and trials in one place.</p>
      <% if (error) { %><div class="err"><%= error %></div><% } %>
      <form method="post" action="/login" autocomplete="on">
        <input type="hidden" name="next" value="<%= next %>">
        <label class="fld" for="email">Email or phone number</label>
        <input id="email" type="text" name="email" value="<%= email %>" placeholder="you@email.com  or  92 300 1234567" required autocomplete="username">
        <label class="fld" for="password">Password</label>
        <input id="password" type="password" name="password" placeholder="Your password" required autocomplete="current-password">
        <button class="btn btn-p btn-full" type="submit">Sign in</button>
      </form>
      <p class="alt" style="margin-top:14px"><a href="/forgot">Forgot password?</a></p>
      <p class="alt">New here? <a href="/signup">Create an account</a></p>
    </div>
  </div>
</main>
<%- include('../partials/store_bottom') %>
