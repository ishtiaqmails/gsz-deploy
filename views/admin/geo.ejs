<%- include('_shell_top') %>

<% if (typeof flash!=='undefined' && flash) { %><div class="flash"><%= flash %></div><% } %>
<% if (typeof err!=='undefined' && err) { %><div class="flash" style="background:#fdecea;color:#b4231b;border-color:#f6c9c4"><%= err %></div><% } %>

<div class="stats">
  <div class="stat"><div class="lbl">Locations</div><b><%= (locs.total||0) %></b><div class="ssub"><%= (locs.country||0) %> countries · <%= (locs.city||0) %> cities</div></div>
  <div class="stat" style="--c:linear-gradient(118deg,#8a2bff,#2a7bff)"><div class="lbl">Pages</div><b><%= (pages.total||0) %></b><div class="ssub"><%= (pages.DRAFT||0) %> draft · <%= (pages.PUBLISHED||0) %> live</div></div>
  <div class="stat" style="--c:linear-gradient(118deg,#16b765,#2a7bff)"><div class="lbl">Indexed</div><b><%= (pages.index||0) %></b><div class="ssub">visible to Google</div></div>
  <div class="stat" style="--c:#c7cede"><div class="lbl">Noindex</div><b><%= (pages.noindex||0) %></b><div class="ssub">live, not indexed</div></div>
</div>

<div class="card">
  <h2>1 · Locations</h2>
  <p class="hint">Load the built-in list of Pakistan cities + international markets into the engine. Safe to run again — it only adds or updates.</p>
  <form method="post" action="/admin/geo/load-locations"><button class="btn btn-g" type="submit"><%= (locs.total||0) ? 'Reload locations' : 'Load locations' %></button></form>
</div>

<div class="card">
  <h2>2 · Generate pages</h2>
  <p class="hint">Create one page per location (as drafts). Nothing goes live until you publish it in the list below.</p>
  <form method="post" action="/admin/geo/generate">
    <label class="fld">Categories (comma-separated slugs)</label>
    <input type="text" name="categories" value="iptv" placeholder="iptv,vpns">
    <label class="fld">Max pages</label>
    <input type="number" name="limit" value="500" min="1" max="5000">
    <button class="btn btn-p" type="submit">Generate drafts</button>
  </form>
</div>

<div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap">
  <div><h2 style="margin:0">Re-check indexing</h2><p class="hint" style="margin:4px 0 0">Re-evaluate every published page's quality &amp; duplicate score and flip index/noindex if needed.</p></div>
  <form method="post" action="/admin/geo/recompute"><button class="btn btn-g" type="submit">Recompute</button></form>
</div>

<div class="card" style="padding:0;overflow:hidden">
  <% if (!rows.length) { %>
    <div style="padding:26px;color:var(--muted);font-size:14px">No geo pages yet. Load locations, then generate drafts above.</div>
  <% } else { %>
  <table class="rsp">
    <thead><tr><th>URL</th><th>Status</th><th>Index</th><th>Qual</th><th>Dup</th><th>Opp</th><th style="text-align:right">Actions</th></tr></thead>
    <tbody>
    <% rows.forEach(function(r){
      var st=(r.status||'DRAFT');
      var stColor = st==='PUBLISHED' ? 'background:#e9fbf1;color:#0b7a42' : (st==='ARCHIVED' ? 'background:#eef1f7;color:#737e9c' : 'background:#fff6e5;color:#9a6b00');
      var idxOn = (r.indexing_status==='INDEX');
    %>
      <tr>
        <td data-label="URL"><a href="<%= siteUrl + r.slug %>" target="_blank" rel="noopener" style="color:var(--brand);font-weight:600;word-break:break-all"><%= r.slug %></a></td>
        <td data-label="Status"><span class="spill" style="<%= stColor %>"><%= st.toLowerCase() %></span></td>
        <td data-label="Index"><span class="spill" style="<%= idxOn?'background:#e7f0ff;color:#2a7bff':'background:#eef1f7;color:#737e9c' %>"><%= idxOn?'index':'noindex' %></span></td>
        <td data-label="Quality"><%= r.quality_score==null?'—':r.quality_score %></td>
        <td data-label="Duplicate"><%= r.duplicate_score==null?'—':r.duplicate_score %></td>
        <td data-label="Opportunity"><%= r.opportunity_score==null?'—':r.opportunity_score %></td>
        <td data-label="Actions" style="text-align:right">
          <div style="display:inline-flex;gap:7px;flex-wrap:wrap;justify-content:flex-end">
            <a class="btn btn-g" style="padding:7px 11px;font-size:12.5px" href="<%= siteUrl + r.slug %>" target="_blank" rel="noopener">Preview</a>
            <% if (st==='PUBLISHED') { %>
              <form method="post" action="/admin/geo/unpublish" style="display:inline"><input type="hidden" name="id" value="<%= r.id %>"><button class="btn btn-g" style="padding:7px 11px;font-size:12.5px;color:#9a6b00" type="submit">Unpublish</button></form>
            <% } else { %>
              <form method="post" action="/admin/geo/publish" style="display:inline"><input type="hidden" name="id" value="<%= r.id %>"><button class="btn btn-p" style="padding:7px 11px;font-size:12.5px" type="submit">Publish</button></form>
            <% } %>
          </div>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
  <% } %>
</div>
<p style="color:var(--muted);font-size:12.5px;margin-top:6px">Publishing runs the quality + duplicate gate: thin or near-duplicate pages publish as <b>noindex</b> automatically (still reachable, just not indexed), and good pages ping IndexNow. Preview opens the live URL.</p>

<%- include('_shell_bottom') %>
