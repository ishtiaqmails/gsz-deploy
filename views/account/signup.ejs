<%- include('../partials/store_top') %>
<%- include('../partials/auth_style') %>
<main class="auth">
  <div class="wrap" style="display:flex;justify-content:center">
    <div class="auth-card su">
      <style>/*suCompact*/
        .su .lead{margin:0 0 15px;font-size:14px}
        .su .fld{margin:0 0 5px}
        .su input{margin:0 0 11px}
        .su .su-grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
        .su .hint{margin:0 0 12px}
        .su .pf input{margin:0}
        @media(max-width:460px){ .su .su-grid2{grid-template-columns:1fr} }
      </style>
      <span class="auth-badge"><span class="dot"></span>Create your account</span>
      <h1>Sign up</h1>
      <p class="lead">One account for your orders, downloads and free trials.</p>
      <% if (error) { %><div class="err"><%= error %></div><% } %>
      <form method="post" action="/signup" autocomplete="on">
        <div class="su-grid2">
          <div>
            <label class="fld" for="name">Full name</label>
            <input id="name" type="text" name="name" value="<%= form.name || '' %>" placeholder="Your name" required autocomplete="name">
          </div>
          <div>
            <label class="fld" for="email">Email address</label>
            <input id="email" type="email" name="email" value="<%= form.email || '' %>" placeholder="you@email.com" required autocomplete="email">
          </div>
        </div>
        <label class="fld" for="wa">WhatsApp number</label>
        <%- include('../partials/phone_field', {
              pfId: 'signup', pfNumName: 'wa', pfNumId: 'wa',
              pfNumValue: (form.wa || ''),
              pfSel: (form.wa_country || (typeof geoCountry!=='undefined' && geoCountry ? geoCountry : 'PK')),
              pfDisabled: false, pfRequired: true
            }) %>
        <p class="hint">Your country is detected automatically — change it above if it's wrong. Type your number in local format; you'll verify it on WhatsApp.</p>
        <div class="su-grid2">
          <div>
            <label class="fld" for="password">Password</label>
            <input id="password" type="password" name="password" placeholder="At least 8 characters" required autocomplete="new-password">
          </div>
          <div>
            <label class="fld" for="password2">Confirm password</label>
            <input id="password2" type="password" name="password2" placeholder="Re-enter password" required autocomplete="new-password">
          </div>
        </div>
        <button class="btn btn-p btn-full" type="submit">Create account</button>
      </form>
      <p class="alt">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </div>
</main>
<%- include('../partials/store_bottom') %>
