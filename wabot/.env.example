# Website base URL the bot calls back on. If the bot runs on the SAME VPS as
# the gsz site, localhost is correct. Otherwise use http://143.198.209.68:3900
WEBSITE_BASE=http://127.0.0.1:3900

# Shared secret — must equal wa_settings.wa_bot_webhook_secret on the website.
# The installer (step79.sh) fills this in for you automatically.
WA_WEBHOOK_SECRET=

# Port for the bot's own send API (website -> bot). Pick a free port.
BOT_PORT=8095

# Seconds before replying again to repeated unsupported (non-VERIFY) messages.
UNSUPPORTED_COOLDOWN=60

# Where the WhatsApp session is stored (keep it; deleting it forces a re-scan).
AUTH_DIR=./auth

# pino log level
LOG_LEVEL=warn
