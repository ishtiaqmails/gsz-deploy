    fetch('/account/tools/trials',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      var list=(j&&j.trials)||[]; trialsCache=list;
      var back='<button class="cthm-back" id="tBack">← Back</button>';
      if(!list.length){ body.innerHTML=back+'<div class="cthm-empty"><div style="font-size:30px">🎁</div><div style="font-weight:700;margin-top:6px">No trials yet</div><p class="muted">Tap “Get Free Trial” to try a service free.</p><button class="cbtn cbtn-p" id="tGet2" style="margin-top:6px">Get Free Trial</button></div>'; var b2=document.getElementById('tGet2'); if(b2) b2.addEventListener('click',getFreeTrial); var bk0=document.getElementById('tBack'); if(bk0) bk0.addEventListener('click',trials); return; }
      body.innerHTML=back+'<p class="muted" style="margin:0 0 12px">Tap a trial to see its login.</p>'+list.map(function(t){
        var pill = t.pending?'<span class="cthm-pill wait">Setting up…</span>':(t.active?'<span class="cthm-pill ok">'+((t.hours_left>0?t.hours_left:1))+'h left</span>':'<span class="cthm-pill bad">Expired</span>');
        return '<button class="cthm-ord" data-tr="'+t.id+'"><span style="flex:1;min-width:0"><span class="onm" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(t.server)+'</span><span class="osub">Claimed '+fmtd(t.claimed)+'</span></span>'+pill+'<svg viewBox="0 0 24 24" width="16" height="16" style="stroke:#9aa6c0;fill:none;stroke-width:2;flex:none"><path d="m9 18 6-6-6-6"/></svg></button>';
      }).join('');
      document.getElementById('tBack').addEventListener('click',trials);
      body.querySelectorAll('button[data-tr]').forEach(function(b){ b.addEventListener('click',function(){ var t=(trialsCache||[]).filter(function(x){return String(x.id)===b.getAttribute('data-tr');})[0]; if(t) trialDetail(t); }); });
    }).catch(function(){ body.innerHTML='<button class="cthm-back" id="tBack">← Back</button><div class="cthm-empty errmsg">Couldn’t load your trials.</div>'; var bk=document.getElementById('tBack'); if(bk) bk.addEventListener('click',trials); });
  }
  function trialDetail(t){
    var left = t.pending ? 'Setting up…' : (!t.active ? 'Expired' : ((t.hours_left>0?t.hours_left:1)+'h left'));
    var pill = t.pending?'<span class="cthm-pill wait">Setting up…</span>':(t.active?'<span class="cthm-pill ok">'+esc(left)+'</span>':'<span class="cthm-pill bad">Expired</span>');
    var cred = t.credentials?('<div class="cthm-cred"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><span class="muted">Trial login</span><button class="cbtn cbtn-g" style="padding:5px 12px;font-size:12px" id="tCpy">Copy</button></div><pre style="margin:0;white-space:pre-wrap;word-break:break-word;background:#0e1627;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px;font-size:13px">'+esc(t.credentials)+'</pre></div>'):('<div class="cthm-note">'+(t.pending?'Your trial is being set up — check back in a moment.':'No login available for this trial.')+'</div>');
    var cv = t.convertable ? '<div class="cthm-acts" style="margin-top:12px"><button class="cbtn cbtn-p" style="width:100%" data-convert="'+t.id+'">Convert to paid</button></div>' : '';
    body.innerHTML='<button class="cthm-back" id="tdBack">← Back to my trials</button>'
      +'<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin:2px 0 4px"><div style="font-weight:800;font-size:16px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(t.server)+'</div>'+pill+'</div>'
      +'<div class="muted" style="margin:0 0 14px">Claimed '+fmtd(t.claimed)+(t.expires?(' · expires '+fmtd(t.expires)):'')+'</div>'
      +cred+cv;
    document.getElementById('tdBack').addEventListener('click',myTrials);
    var cp=document.getElementById('tCpy'); if(cp) cp.addEventListener('click',function(){ try{ navigator.clipboard.writeText(t.credentials); cp.textContent='Copied ✓'; setTimeout(function(){cp.textContent='Copy';},1400);}catch(e){} });
    var cb=body.querySelector('[data-convert]'); if(cb) cb.addEventListener('click',function(){ convertTrialToPaid(t); });
  }
  function isLoggedIn(){ return (typeof window.__GSZAUTH!=='undefined') ? !!window.__GSZAUTH : authed; }
