  .cthm-auth{flex:1;min-width:0;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:11px 14px;border-radius:12px;font-weight:800;font-size:13.5px;cursor:pointer;border:0;font-family:inherit;text-decoration:none;white-space:nowrap}
