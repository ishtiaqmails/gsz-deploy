  .cthm-auth.in{background:linear-gradient(135deg,#33d98a,#1fb457);color:#05240f}
  .cthm-auth.reg{background:#16203a;color:#eef2fb;border:1px solid rgba(255,255,255,.18)}
  .cthm-auth.out{background:#16203a;color:#ff8f8a;border:1px solid rgba(240,85,78,.4);max-width:260px;margin:0 auto}
  .cthm-choice{display:flex;align-items:flex-start;gap:13px;width:100%;text-align:left;padding:15px;border:1px solid rgba(255,255,255,.1);border-radius:14px;margin-bottom:11px;background:#0e1627;color:#eef2fb;cursor:pointer;font-family:inherit}
