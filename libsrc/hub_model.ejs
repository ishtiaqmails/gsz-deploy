    if(isLoggedIn()){
      f.innerHTML='<div class="cthm-fwrap"><div class="cthm-fstat"><span class="dot on"></span><span id="cthmWho">Signed in to your Galaxy Hub</span></div><div class="cthm-frow"><button class="cthm-auth out" id="cthmSignOut"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>Sign Out</button></div></div>';
      var so=document.getElementById('cthmSignOut'); if(so) so.addEventListener('click',signOut);
      try{ fetch('/account/tools/profile',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){ var w=document.getElementById('cthmWho'); if(!w||!j) return; var p=(j&&j.profile)||j||{}; var nm=((p.name||'')+'').trim()||((p.email||'')+'').trim(); if(nm) w.textContent='Signed in as '+nm; }).catch(function(){}); }catch(e){}
    } else if(authScreen){
      /* an auth form is already on screen (sign in / create / forgot / reset) — its own buttons are
         right there, so the footer shows just the status, no duplicate Sign In / Create Account */
      f.innerHTML='<div class="cthm-fwrap"><div class="cthm-fstat"><span class="dot off"></span>You’re not signed in</div></div>';
    } else {
      f.innerHTML='<div class="cthm-fwrap"><div class="cthm-fstat"><span class="dot off"></span>You’re not signed in</div><div class="cthm-frow"><button class="cthm-auth in" id="cthmSignIn"><svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5M15 12H3"/></svg>Sign In</button><button class="cthm-auth reg" id="cthmCreate"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>Create Account</button></div></div>';
      var si=document.getElementById('cthmSignIn'); if(si) si.addEventListener('click',signinForm);
      var cr=document.getElementById('cthmCreate'); if(cr) cr.addEventListener('click',signupForm);
    } }
