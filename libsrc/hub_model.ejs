    body.innerHTML='<div class="cthm-load">Loading…</div>';
    fetch('/api/announcements',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      var items=(j&&j.items)||[];
      if(!items.length){ body.innerHTML='<div class="cthm-empty"><div style="font-size:30px">📣</div><p class="muted" style="margin-top:6px">No updates yet — check back soon.</p></div>'; return; }
      try{ localStorage.setItem('gsz_ann_seen', String(items[0].id||0)); }catch(e){}
      try{ document.querySelectorAll('[data-anndot]').forEach(function(d){ d.style.display='none'; }); }catch(e){}
      body.innerHTML=items.map(function(a){
        var k=String(a.kind||'').toLowerCase();
        var badge=(k==='promo')?'<span class="ann-k promo">Offer</span>':'<span class="ann-k news">News</span>';
        var prod=a.product?('<span class="ann-prod">'+esc(a.product)+'</span>'):'';
        var date=a.created_at?('<span class="ann-date">'+fmtd(a.created_at)+'</span>'):'';
        var coupon=a.coupon?('<button class="ann-code" data-cpy="'+esc(a.coupon)+'">🎟️ '+esc(a.coupon)+' · Copy</button>'):'';
        return '<div class="ann-card"><div class="ann-top">'+badge+prod+date+'</div><div class="ann-title">'+esc(a.title)+'</div><div class="ann-body">'+esc(a.body)+'</div>'+coupon+'</div>';
      }).join('');
      body.querySelectorAll('[data-cpy]').forEach(function(b){ b.addEventListener('click',function(){ try{ navigator.clipboard.writeText(b.getAttribute('data-cpy')); var o=b.innerHTML; b.innerHTML='Copied ✓'; setTimeout(function(){b.innerHTML=o;},1400);}catch(e){} }); });
    }).catch(function(){ body.innerHTML='<div class="cthm-empty"><p class="muted">Couldn’t load updates right now.</p></div>'; });
  }
  // subtle "new" dot on the Updates tab when there's an unseen announcement
  (function annDot(){ try{
    fetch('/api/announcements',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      var items=(j&&j.items)||[]; if(!items.length) return;
      var seen=0; try{ seen=parseInt(localStorage.getItem('gsz_ann_seen')||'0',10)||0; }catch(e){}
      if((items[0].id||0)>seen){ document.querySelectorAll('[data-anndot]').forEach(function(d){ d.style.display='inline-block'; }); }
    }).catch(function(){});
  }catch(e){} })();
  tabs.forEach(function(t){ t.addEventListener('click',function(){ setTab(t.getAttribute('data-tab')); }); });
  /* IPTV Free Trial (.trial-open) -> open the Hub Trials tab, not the old trial modal */
  document.addEventListener('click',function(e){ var t=(e.target&&e.target.closest)?e.target.closest('.trial-open'):null; if(t){ e.preventDefault(); e.stopImmediatePropagation(); if(window.__gszTools) window.__gszTools('trials'); } }, true);
  modal.querySelectorAll('[data-close]').forEach(function(x){ x.addEventListener('click',close); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  // app-nav hook: open the tools modal from anywhere (bottom bar), and auto-open via ?tool=
  var _HUBTABS=['purchases','code','renew','claim','support','trials','account','updates'];
  window.__gszTools=function(tab){ if(tab==='iptvrenew'){ openIptvRenew(); return; } open(_HUBTABS.indexOf(tab)>=0?tab:'purchases'); };
  window.__gszAuth=function(mode){ if(!modal.classList.contains('on')){ modal.classList.add('on'); window.__gszScrollLock.lock(); } renderFoot(); if(mode==='signup') signupForm(); else signinForm(); };
  try{ var _qp=new URLSearchParams(location.search); var _t=_qp.get('tool'); if(_t){ if(_t==='iptvrenew'){ openIptvRenew(); } else { open(_HUBTABS.indexOf(_t)>=0?_t:'purchases'); } if(history.replaceState) history.replaceState(null,'',location.pathname); } }catch(e){}
  // hijack the header's account / sign-in / create-account links -> open the Hub model (site-wide)
  function wireHeaderAuth(){ try{ [].slice.call(document.querySelectorAll('#hd a[href^="/login"],#hd a[href^="/signup"],#hd a[href="/account"]')).forEach(function(a){ if(a.getAttribute('data-gbwired')) return; a.setAttribute('data-gbwired','1'); var h=a.getAttribute('href')||'';
    a.addEventListener('click',function(e){ e.preventDefault(); e.stopPropagation();
      if(/^\/signup/.test(h)){ signupForm_open(); }
      else if(/^\/login/.test(h)){ signin_open(); }
      else { var inLogged=(typeof window.__GSZAUTH!=='undefined')?!!window.__GSZAUTH:isLoggedIn(); if(inLogged){ open('account'); } else { signin_open(); } }
    }); }); }catch(e){} }
  function signin_open(){ if(!modal.classList.contains('on')){ modal.classList.add('on'); window.__gszScrollLock.lock(); } renderFoot(); signinForm(); }
  function signupForm_open(){ if(!modal.classList.contains('on')){ modal.classList.add('on'); window.__gszScrollLock.lock(); } renderFoot(); signupForm(); }
  wireHeaderAuth();
})();
</script>
