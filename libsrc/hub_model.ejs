  /* ---- Renew IPTV Subscription (any line, paste-and-detect) ---- */
  var iptvSvcCache=null;
  function _matchSvc(list, server){
    if(!server) return null; var s=String(server).toLowerCase().trim();
    var ex=list.filter(function(x){ return String(x.name).toLowerCase().trim()===s; })[0]; if(ex) return ex;
    var c=list.filter(function(x){ var n=String(x.name).toLowerCase().trim(); return n && (s.indexOf(n)>=0 || n.indexOf(s)>=0); })[0]; if(c) return c;
    var t2=list.filter(function(x){ var w=(String(x.name).toLowerCase().split(/[^a-z0-9]+/).filter(Boolean)[0])||''; return w.length>=3 && s.indexOf(w)>=0; })[0];
    return t2||null;
  }
  function convertTrialToPaid(t){
    body.innerHTML='<button class="cthm-back" id="cvBack">← Back</button><div class="cthm-load">Finding your line…</div>';
    document.getElementById('cvBack').addEventListener('click',myTrials);
    fetch('/account/tools/iptv/options',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      var list=(j&&j.services)||[]; iptvSvcCache=list;
      var srv=_matchSvc(list, t.server);
      if(!srv){ iptvServices(); return; }
      var raw=t.credentials||t.server||'';
      function handleC(res){ if(res&&res.ok&&res.found){ iptvFound(srv, res, raw); return; } iptvEnter(srv); }
      function pollC(id, tries){ if(tries>48){ iptvEnter(srv); return; }
        fetch('/account/tools/iptv/lookup-status/'+encodeURIComponent(id),{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(st){ if(st&&st.status==='done'){ handleC(st.result||{}); return; } if(st&&st.status==='failed'){ iptvEnter(srv); return; } setTimeout(function(){ pollC(id,tries+1); },2500); }).catch(function(){ setTimeout(function(){ pollC(id,tries+1); },2500); });
      }
      fetch('/account/tools/iptv/lookup',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'fetch'},credentials:'same-origin',body:JSON.stringify({sku:srv.sku, raw:raw})}).then(function(r){return r.json();}).then(function(res){ if(res&&res.pending&&res.lookup_id){ pollC(res.lookup_id,0); return; } handleC(res); }).catch(function(){ iptvEnter(srv); });
    }).catch(function(){ iptvServices(); });
  }
  function iptvRenew(){
    body.innerHTML='<div class="cthm-load">Loading…</div>';
