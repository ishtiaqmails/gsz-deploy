  .cthm-choice .chi svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.85;stroke-linecap:round;stroke-linejoin:round}
  .cthm-choice b{font-size:14.5px;font-weight:700;display:block}
  .cthm-choice small{font-size:12px;color:#9aa6c0;display:block;margin-top:2px}
  .cthm-choice .chbadge{font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;background:rgba(244,182,76,.16);color:#f4b64c;margin-left:8px;vertical-align:middle}
  .wv-card{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid rgba(37,211,102,.32);border-radius:14px;margin:0 0 14px;background:rgba(37,211,102,.07)}
  .wv-card .wv-ic{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;flex:none;background:rgba(37,211,102,.16);color:#25d366}
  .wv-card .wv-ic svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .wv-card .wv-tx{flex:1;min-width:0}.wv-card .wv-tx b{font-size:14px;display:block}.wv-card .wv-tx small{font-size:11.5px;color:#9aa6c0;display:block;margin-top:2px}
  .wv-card .cbtn{flex:none}
  @media(max-width:460px){.wv-card{flex-wrap:wrap}.wv-card .cbtn{width:100%}}
  .wv-code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:28px;font-weight:800;letter-spacing:6px;color:#eef2fb;text-align:center;background:#0e1627;border:1px dashed rgba(37,211,102,.5);border-radius:12px;padding:14px;margin:4px 0 12px;cursor:pointer}
  .wv-num{text-align:center;margin:12px 0 0;font-size:12.5px;display:flex;flex-direction:column;align-items:center;gap:5px}
  .wv-numbtn{display:inline-flex;align-items:center;gap:6px;font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:800;font-size:15px;letter-spacing:1px;color:#25d366;background:rgba(37,211,102,.1);border:1px solid rgba(37,211,102,.32);border-radius:10px;padding:8px 14px;cursor:pointer}
  .wv-wait{display:flex;align-items:center;gap:9px;justify-content:center;color:#f4b64c;font-weight:700;font-size:13px;margin-top:12px}
  .wv-dot{width:9px;height:9px;border-radius:50%;background:#f4b64c;animation:wvp 1s infinite}
  @keyframes wvp{0%,100%{opacity:.3}50%{opacity:1}}
</style>

<div class="cthm" id="cthm" aria-hidden="true">
  <div class="cthm-scrim" data-close></div>
  <div class="cthm-card" role="dialog" aria-modal="true">
    <button class="cthm-x" data-close aria-label="Close">✕</button>
    <div class="cthm-head"><h3>Galaxy Hub</h3><p>Your orders, access, renewals, trials &amp; support — all in one place.</p></div>
    <div class="cthm-tabs">
      <button class="cthm-tab" data-tab="purchases" data-need="orders" style="display:none">Orders</button>
      <button class="cthm-tab" data-tab="code" data-need="access" style="display:none">Access</button>
      <button class="cthm-tab" data-tab="renew" data-need="renewable" style="display:none">Renew</button>
      <button class="cthm-tab" data-tab="trials">Trials</button>
      <button class="cthm-tab" data-tab="claim" data-need="orders" style="display:none">Claim</button>
      <button class="cthm-tab" data-tab="account">Account</button>
    </div>
    <div class="cthm-body" id="cthmBody"><div class="cthm-load">Loading…</div></div>
    <div class="cthm-foot" id="cthmFoot"></div>
  </div>
</div>
<script>
(function(){
  var modal=document.getElementById('cthm'); if(!modal) return;
  var body=document.getElementById('cthmBody');
  var tabs=modal.querySelectorAll('.cthm-tab');
  var cache=null, authed=true, ordFilter='all';
  var WANUM=<%- JSON.stringify(_wanum) %>;
  function esc(s){var d=document.createElement('div');d.textContent=(s==null?'':String(s));return d.innerHTML;}
  function money(n){ return 'Rs '+Math.round(Number(n||0)).toLocaleString('en-US'); }
  /* ---------- Quick Access entitlements (which tools a customer sees) ---------- */
  window.__gszEntitle = window.__gszEntitle || (function(){ var cache=null, waiting=[], fetching=false;
    return function(cb){ if(cache){ cb(cache); return; } waiting.push(cb); if(fetching) return; fetching=true;
      fetch('/account/tools/entitlements',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).catch(function(){return {ok:false,loggedIn:false,orders:false,access:false,renewable:false};}).then(function(j){ cache=j||{}; var w=waiting; waiting=[]; w.forEach(function(f){try{f(cache);}catch(e){}}); }); };
  })();
  function gszApplyNeeds(root){ var els=(root||document).querySelectorAll('[data-need]'); if(!els.length) return;
    window.__gszEntitle(function(f){ [].forEach.call(els,function(el){ var need=el.getAttribute('data-need'); var ok= need==='orders'?!!f.orders:(need==='access'?!!f.access:(need==='renewable'?!!f.renewable:true)); el.style.display= ok?'':'none'; }); }); }
  window.__gszApplyNeeds=gszApplyNeeds;
  window.__gszScrollLock = window.__gszScrollLock || (function(){ var n=0,y=0; return {
    lock:function(){ if(n++>0) return; y=window.scrollY||window.pageYOffset||0; var b=document.body; b.style.position='fixed'; b.style.top=(-y)+'px'; b.style.left='0'; b.style.right='0'; b.style.width='100%'; b.style.overflow='hidden'; },
    unlock:function(){ if(n>0)n--; if(n>0) return; var b=document.body; b.style.position=''; b.style.top=''; b.style.left=''; b.style.right=''; b.style.width=''; b.style.overflow=''; window.scrollTo(0,y); } }; })();
  function open(tab){ var want=tab||'purchases'; modal.classList.add('on'); window.__gszScrollLock.lock(); setTab(want);
    window.__gszEntitle(function(f){ gszApplyNeeds(modal);
      var btn=modal.querySelector('.cthm-tab[data-tab="'+want+'"]');
      if(btn && btn.style.display==='none'){ var pick=null; tabs.forEach(function(t){ if(!pick && t.style.display!=='none') pick=t.getAttribute('data-tab'); }); if(pick) setTab(pick); }
    });
  }
  function close(){ modal.classList.remove('on'); window.__gszScrollLock.unlock(); }
  function setTab(tab){ tabs.forEach(function(t){ t.classList.toggle('on', t.getAttribute('data-tab')===tab); }); render(tab); }
  function loadOrders(){ if(cache) return Promise.resolve(cache);
    return fetch('/account/tools/orders',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){ if(r.redirected && /\/login/.test(r.url)){ authed=false; return {orders:[]}; } return r.json(); }).then(function(j){ if(j&&j.auth===false) authed=false; cache=(j&&j.orders)||[]; return cache; }).catch(function(){ cache=[]; return []; }); }
  function pc(s){ s=String(s||'').toLowerCase(); if(s==='delivered'||s==='completed'||s==='done') return 'ok'; if(s==='failed'||s==='rejected'||s==='cancelled') return 'bad'; return 'wait'; }
  function signin(){ signinForm(); }
  function render(tab){ wvStop(); renderFoot(); if(tab==='support'){ support(); return; } body.innerHTML='<div class="cthm-load">Loading…</div>'; loadOrders().then(function(o){ if(!authed){ signin(); return; } if(tab==='purchases') pur(o); else if(tab==='code') code(o); else if(tab==='renew') renew(o); else if(tab==='trials') trials(); else if(tab==='account') account(); else claim(o); }); }
  function account(){
    body.innerHTML='<div class="cthm-load">Loading…</div>';
    fetch('/account/tools/profile',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      if(!j||!j.ok){ body.innerHTML='<div class="cthm-empty errmsg">Couldn’t load your details.</div>'; return; }
      var p=j.profile;
      function vbadge(ok){ return ok?'<span class="cthm-pill ok" style="margin-left:6px">Verified</span>':'<span class="cthm-pill wait" style="margin-left:6px">Unverified</span>'; }
      function fld(key,label,val){ var badge=key==='email'?vbadge(p.email_verified):(key==='wa'?vbadge(p.wa_verified):''); var isRef=key==='ref';
        var icon=isRef?'<button class="cbtn cbtn-g acc-ic acc-copy" aria-label="Copy" title="Copy"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></button>':'<button class="cbtn cbtn-g acc-ic acc-edit" aria-label="Edit '+esc(label)+'" title="Edit"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>';
        return '<div class="acc-fld" data-fld="'+key+'"><div class="acc-line"><span class="acc-lbl">'+label+'</span><span class="acc-val">'+esc(val||'—')+'</span>'+badge+icon+'</div><div class="acc-editbox" style="display:none;margin-top:9px"><input type="text" class="acc-input" value="'+esc(val||'')+'"><div style="display:flex;gap:8px;margin-top:8px"><button class="cbtn cbtn-p acc-save" style="flex:1">Save</button><button class="cbtn cbtn-g acc-cancel">Cancel</button></div><div class="acc-msg"></div></div></div>'; }
      body.innerHTML='<p class="muted" style="margin:0 0 11px;font-size:12px">Tap the pencil to edit.</p>'
        + (p.wa_verified?'':'<div class="wv-card"><div class="wv-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.2-5.4A8.5 8.5 0 1 1 21 11.5Z"/></svg></div><div class="wv-tx"><b>Verify your WhatsApp</b><small>Unlock free trials, faster support &amp; secure your account.</small></div><button class="cbtn cbtn-p wv-go">Verify now</button></div>')
        + fld('name','Name',p.name)
        + fld('wa','WhatsApp',p.wa_number)
        + fld('email','Email',p.email)
        + '<div class="acc-fld"><div class="acc-line"><span class="acc-lbl">Member since</span><span class="acc-val">'+fmtd(p.member_since)+'</span></div></div>'
        + (p.ref_code? fld('ref','Referral code',p.ref_code):'');
      body.querySelectorAll('.acc-fld').forEach(function(f){
        var key=f.getAttribute('data-fld');
        var edit=f.querySelector('.acc-edit'), box=f.querySelector('.acc-editbox'), cancel=f.querySelector('.acc-cancel'), save=f.querySelector('.acc-save'), input=f.querySelector('.acc-input'), msg=f.querySelector('.acc-msg'), copy=f.querySelector('.acc-copy'), val=f.querySelector('.acc-val');
        if(copy) copy.addEventListener('click',function(){ try{ navigator.clipboard.writeText(val.textContent); var o=copy.innerHTML; copy.innerHTML='<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#33d98a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'; setTimeout(function(){copy.innerHTML=o;},1400);}catch(e){} });
        if(edit) edit.addEventListener('click',function(){ box.style.display='block'; edit.style.display='none'; try{input.focus();}catch(e){} });
        if(cancel) cancel.addEventListener('click',function(){ box.style.display='none'; if(edit) edit.style.display=''; if(msg) msg.innerHTML=''; });
        if(save) save.addEventListener('click',function(){
          var v=input.value.trim(); save.disabled=true; save.textContent='Saving…'; if(msg) msg.innerHTML='';
          fetch('/account/tools/profile',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'fetch'},credentials:'same-origin',body:JSON.stringify({field:key,value:v})}).then(function(r){return r.json();}).then(function(jj){
