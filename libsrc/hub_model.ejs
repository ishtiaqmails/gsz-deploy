  modal.querySelectorAll('[data-close]').forEach(function(x){ x.addEventListener('click',close); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  // app-nav hook: open the tools modal from anywhere (bottom bar), and auto-open via ?tool=
  var _HUBTABS=['purchases','code','renew','claim','support','trials','account'];
  window.__gszTools=function(tab){ open(_HUBTABS.indexOf(tab)>=0?tab:'purchases'); };
  window.__gszAuth=function(mode){ if(!modal.classList.contains('on')){ modal.classList.add('on'); window.__gszScrollLock.lock(); } renderFoot(); if(mode==='signup') signupForm(); else signinForm(); };
  try{ var _qp=new URLSearchParams(location.search); var _t=_qp.get('tool'); if(_t){ open(_HUBTABS.indexOf(_t)>=0?_t:'purchases'); if(history.replaceState) history.replaceState(null,'',location.pathname); } }catch(e){}
  // hijack the header's account / sign-in / create-account links -> open the Hub model (site-wide)
  function wireHeaderAuth(){ try{ [].slice.call(document.querySelectorAll('#hd a[href^="/login"],#hd a[href^="/signup"],#hd a[href="/account"]')).forEach(function(a){ if(a.getAttribute('data-gbwired')) return; a.setAttribute('data-gbwired','1'); var h=a.getAttribute('href')||'';
    a.addEventListener('click',function(e){ e.preventDefault(); e.stopPropagation();
      if(/^\/signup/.test(h)){ signupForm_open(); }
      else if(/^\/login/.test(h)){ signin_open(); }
      else { var inLogged=(typeof window.__GSZAUTH!=='undefined')?!!window.__GSZAUTH:isLoggedIn(); if(inLogged){ open('account'); } else { signin_open(); } }
    }); }); }catch(e){} }
  function signin_open(){ if(!modal.classList.contains('on')){ modal.classList.add('on'); window.__gszScrollLock.lock(); } renderFoot(); signinForm(); }
  function signupForm_open(){ if(!modal.classList.contains('on')){ modal.classList.add('on'); window.__gszScrollLock.lock(); } renderFoot(); signupForm(); }
  wireHeaderAuth();
})();
</script>
