<div class="cthm" id="cthm" aria-hidden="true">
  <div class="cthm-scrim" data-close></div>
  <div class="cthm-card" role="dialog" aria-modal="true">
    <button class="cthm-x" data-close aria-label="Close">✕</button>
    <div class="cthm-head"><h3>Galaxy Hub</h3><p>Your orders, access, renewals, trials &amp; support — all in one place.</p></div>
    <div class="cthm-tabs">
      <button class="cthm-tab" data-tab="purchases">Orders</button>
      <button class="cthm-tab" data-tab="code">Access</button>
      <button class="cthm-tab" data-tab="renew">Renew</button>
      <button class="cthm-tab" data-tab="trials">Trials</button>
      <button class="cthm-tab" data-tab="claim">Claim</button>
      <button class="cthm-tab" data-tab="support">Support</button>
      <button class="cthm-tab" data-tab="updates">Updates<span class="ann-dot" data-anndot style="display:none"></span></button>
      <button class="cthm-tab" data-tab="account">Account</button>
    </div>
    <div class="cthm-body" id="cthmBody"><div class="cthm-load">Loading…</div></div>
    <div class="cthm-foot" id="cthmFoot"></div>
  </div>
</div>
<script>
(function(){
  var modal=document.getElementById('cthm'); if(!modal) return;
  var body=document.getElementById('cthmBody');
  var tabs=modal.querySelectorAll('.cthm-tab');
  var cache=null, authed=true, ordFilter='all', authScreen=false;
  var WANUM=<%- JSON.stringify(_wanum) %>;
  function esc(s){var d=document.createElement('div');d.textContent=(s==null?'':String(s));return d.innerHTML;}
  // CLEAN_CRED_v1 — some panels return a line/username wrapped in HTML (e.g. a
  // <span class="user-cred-cell" title="…">123</span> table cell). Strip tags and
  // collapse to the bare value so the renew UI never shows raw markup.
  function cleanField(s){ if(s==null) return ''; var d=document.createElement('div'); d.innerHTML=String(s); var t=(d.textContent||d.innerText||'').replace(/\s+/g,' ').trim(); return t; }
  function money(n){ return 'Rs '+Math.round(Number(n||0)).toLocaleString('en-US'); }
  window.__gszScrollLock = window.__gszScrollLock || (function(){ var n=0,y=0; return {
    lock:function(){ if(n++>0) return; y=window.scrollY||window.pageYOffset||0; var b=document.body; b.style.position='fixed'; b.style.top=(-y)+'px'; b.style.left='0'; b.style.right='0'; b.style.width='100%'; b.style.overflow='hidden'; },
    unlock:function(){ if(n>0)n--; if(n>0) return; var b=document.body; b.style.position=''; b.style.top=''; b.style.left=''; b.style.right=''; b.style.width=''; b.style.overflow=''; window.scrollTo(0,y); } }; })();
  function open(tab){ modal.classList.add('on'); window.__gszScrollLock.lock(); setTab(tab||'purchases'); }
