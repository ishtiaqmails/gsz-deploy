      +'<div id="auOut"></div>'
      +'<button class="cbtn cbtn-p" style="width:100%" id="auGo">Sign In</button>'
      +'<div style="text-align:center;margin-top:10px"><button type="button" class="cthm-back" id="auToForgot" style="padding:0;font-size:12.5px;color:#9aa6c0;font-weight:600">Forgot password?</button></div>'
      +'<div style="text-align:center;margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)" class="muted">New here? <button class="cthm-back" style="padding:0;font-size:13px" id="auToSignup">Create an account →</button></div>';
    var go=document.getElementById('auGo');
    function submit(){ var id=(document.getElementById('auId').value||'').trim(), pw=(document.getElementById('auPw').value||''); var out=document.getElementById('auOut');
      if(!id||!pw){ out.innerHTML=authErr('Enter your email/WhatsApp and password.'); return; }
      go.disabled=true; go.textContent='Signing in…'; out.innerHTML='';
      fetch('/login',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'fetch'},credentials:'same-origin',body:new URLSearchParams({email:id,password:pw}).toString()}).then(function(r){return r.json();}).then(function(j){
        if(j&&j.ok){ location.reload(); return; }
        out.innerHTML=authErr((j&&j.error)||'Sign in failed.'); go.disabled=false; go.textContent='Sign In';
      }).catch(function(){ out.innerHTML=authErr('Couldn’t sign in right now.'); go.disabled=false; go.textContent='Sign In'; });
    }
    go.addEventListener('click',submit);
    body.querySelectorAll('input').forEach(function(i){ i.addEventListener('keydown',function(e){ if(e.key==='Enter') submit(); }); });
    var su=document.getElementById('auToSignup'); if(su) su.addEventListener('click',signupForm);
    var fgb=document.getElementById('auToForgot'); if(fgb) fgb.addEventListener('click',forgotForm);
  }
  function signupForm(){
    tabs.forEach(function(t){ t.classList.remove('on'); });
    authScreen=true; renderFoot();
    body.innerHTML='<div style="text-align:center;margin:2px 0 16px"><div style="font-weight:800;font-size:17px">Create your account</div><p class="muted" style="margin:4px 0 0">Track orders, trials, renewals &amp; more.</p></div>'
      +'<div class="cthm-f"><label>Full name</label><input type="text" id="suName" placeholder="Your name"></div>'
      +'<div class="cthm-f"><label>Email</label><input type="text" id="suEmail" placeholder="you@email.com"></div>'
      +'<div class="cthm-f"><label>WhatsApp number</label><input type="text" id="suWa" placeholder="03xx… (add +country code if outside Pakistan)"></div>'
      +'<div class="cthm-f"><label>Password</label><input type="password" id="suPw" placeholder="At least 8 characters"></div>'
      +'<div class="cthm-f"><label>Confirm password</label><input type="password" id="suPw2" placeholder="Re-enter password"></div>'
      +'<div id="suOut"></div>'
      +'<button class="cbtn cbtn-p" style="width:100%" id="suGo">Create Account</button>'
      +'<div style="text-align:center;margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)" class="muted">Already have an account? <button class="cthm-back" style="padding:0;font-size:13px" id="suToSignin">Sign in →</button></div>';
    var go=document.getElementById('suGo');
    function submit(){ var out=document.getElementById('suOut');
      var name=(document.getElementById('suName').value||'').trim(), email=(document.getElementById('suEmail').value||'').trim(), wa=(document.getElementById('suWa').value||'').trim(), pw=(document.getElementById('suPw').value||''), pw2=(document.getElementById('suPw2').value||'');
      if(name.length<2){ out.innerHTML=authErr('Please enter your name.'); return; }
      if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ out.innerHTML=authErr('Enter a valid email.'); return; }
      if(wa.replace(/[^0-9]/g,'').length<8){ out.innerHTML=authErr('Enter a valid WhatsApp number.'); return; }
      if(pw.length<8){ out.innerHTML=authErr('Password must be at least 8 characters.'); return; }
      if(pw!==pw2){ out.innerHTML=authErr('Passwords do not match.'); return; }
      go.disabled=true; go.textContent='Creating…'; out.innerHTML='';
      var wc=/^\+|^00/.test(wa)?'':'PK';
      fetch('/signup',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'fetch'},credentials:'same-origin',body:new URLSearchParams({name:name,email:email,wa:wa,wa_country:wc,password:pw,password2:pw2}).toString()}).then(function(r){return r.json();}).then(function(j){
        if(j&&j.ok){ location.reload(); return; }
        out.innerHTML=authErr((j&&j.error)||'Could not create account.'); go.disabled=false; go.textContent='Create Account';
      }).catch(function(){ out.innerHTML=authErr('Couldn’t sign up right now.'); go.disabled=false; go.textContent='Create Account'; });
    }
    go.addEventListener('click',submit);
    var si=document.getElementById('suToSignin'); if(si) si.addEventListener('click',signinForm);
  }
  function forgotForm(){
    tabs.forEach(function(t){ t.classList.remove('on'); });
    authScreen=true; renderFoot();
    body.innerHTML='<div style="text-align:center;margin:2px 0 16px"><div style="font-weight:800;font-size:17px">Forgot password</div><p class="muted" style="margin:4px 0 0">We’ll send a 6-digit reset code to your email and your WhatsApp (if it’s verified).</p></div>'
      +'<div class="cthm-f"><label>Email or WhatsApp number</label><input type="text" id="fgId" placeholder="you@email.com or 03xx…"></div>'
      +'<div id="fgOut"></div>'
      +'<button class="cbtn cbtn-p" style="width:100%" id="fgGo">Send reset code</button>'
      +'<div style="text-align:center;margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)" class="muted"><button class="cthm-back" style="padding:0;font-size:13px" id="fgToSignin">← Back to sign in</button></div>';
    var go=document.getElementById('fgGo');
    function submit(){ var id=(document.getElementById('fgId').value||'').trim(), out=document.getElementById('fgOut');
      if(!id){ out.innerHTML=authErr('Enter your email or WhatsApp number.'); return; }
      go.disabled=true; go.textContent='Sending…'; out.innerHTML='';
