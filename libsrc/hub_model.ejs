      fetch('/forgot',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'fetch'},credentials:'same-origin',body:new URLSearchParams({idf:id,wa_country:wc}).toString()}).then(function(r){return r.json();}).then(function(j){
        if(j&&j.ok){ resetForm(); return; }
        out.innerHTML=authErr((j&&j.error)||'Could not send a code.'); go.disabled=false; go.textContent='Send reset code';
      }).catch(function(){ out.innerHTML=authErr('Couldn’t send a code right now.'); go.disabled=false; go.textContent='Send reset code'; });
    }
    go.addEventListener('click',submit);
    body.querySelectorAll('input').forEach(function(i){ i.addEventListener('keydown',function(e){ if(e.key==='Enter') submit(); }); });
    var bk=document.getElementById('fgToSignin'); if(bk) bk.addEventListener('click',signinForm);
  }
  function resetForm(){
    tabs.forEach(function(t){ t.classList.remove('on'); });
    authScreen=true; renderFoot();
    body.innerHTML='<div style="text-align:center;margin:2px 0 16px"><div style="font-weight:800;font-size:17px">Reset password</div><p class="muted" style="margin:4px 0 0">Code sent — check your WhatsApp and email (and spam). Enter it and set a new password.</p></div>'
      +'<div class="cthm-f"><label>Reset code</label><input type="text" id="rsCode" inputmode="numeric" maxlength="6" placeholder="6-digit code"></div>'
      +'<div class="cthm-f"><label>New password</label><input type="password" id="rsPw" placeholder="At least 8 characters"></div>'
      +'<div class="cthm-f"><label>Confirm new password</label><input type="password" id="rsPw2" placeholder="Re-enter new password"></div>'
      +'<div id="rsOut"></div>'
      +'<button class="cbtn cbtn-p" style="width:100%" id="rsGo">Change password</button>'
      +'<div style="text-align:center;margin-top:10px"><button class="cthm-back" style="padding:0;font-size:12.5px" id="rsOver">Didn’t get it? Start over</button></div>';
    var go=document.getElementById('rsGo');
    function submit(){ var out=document.getElementById('rsOut');
      var code=(document.getElementById('rsCode').value||'').replace(/[^0-9]/g,''), pw=(document.getElementById('rsPw').value||''), pw2=(document.getElementById('rsPw2').value||'');
      if(code.length!==6){ out.innerHTML=authErr('Enter the 6-digit code.'); return; }
      if(pw.length<8){ out.innerHTML=authErr('Password must be at least 8 characters.'); return; }
      if(pw!==pw2){ out.innerHTML=authErr('Passwords do not match.'); return; }
      go.disabled=true; go.textContent='Saving…'; out.innerHTML='';
      fetch('/reset',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'fetch'},credentials:'same-origin',body:new URLSearchParams({code:code,password:pw,password2:pw2}).toString()}).then(function(r){return r.json();}).then(function(j){
        if(j&&j.ok){ location.reload(); return; }
        out.innerHTML=authErr((j&&j.error)||'Could not reset password.'); go.disabled=false; go.textContent='Change password';
      }).catch(function(){ out.innerHTML=authErr('Couldn’t reset right now.'); go.disabled=false; go.textContent='Change password'; });
    }
    go.addEventListener('click',submit);
    body.querySelectorAll('input').forEach(function(i){ i.addEventListener('keydown',function(e){ if(e.key==='Enter') submit(); }); });
    var ov=document.getElementById('rsOver'); if(ov) ov.addEventListener('click',forgotForm);
  }
  function signOut(){ var btn=document.getElementById('cthmSignOut'); if(btn){ btn.disabled=true; btn.textContent='Signing out…'; } fetch('/logout',{method:'POST',credentials:'same-origin',headers:{'X-Requested-With':'fetch'}}).then(function(){ location.reload(); }).catch(function(){ var fm=document.createElement('form'); fm.method='POST'; fm.action='/logout'; document.body.appendChild(fm); fm.submit(); }); }
  function support(){
    body.innerHTML='<div class="sb-wrap">'
      +'<div class="sb-msgs" id="sbMsgs"></div>'
      +'<div class="sb-sugg" id="sbSugg"></div>'
      +'<div class="sb-inbar"><input id="sbIn" type="text" placeholder="Ask anything — prices, plans, your order…" autocomplete="off" maxlength="500"><button class="sb-send" id="sbSend" aria-label="Send"><svg viewBox="0 0 24 24"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg></button></div>'
      +'<a class="sb-wa" href="https://wa.me/'+WANUM+'" target="_blank" rel="noopener">Prefer WhatsApp? <b>Chat us →</b></a>'
      +'</div>';
    var msgs=document.getElementById('sbMsgs'), inp=document.getElementById('sbIn'), send=document.getElementById('sbSend'), sugg=document.getElementById('sbSugg');
    var queue=[], working=false;
    function scroll(){ msgs.scrollTop=msgs.scrollHeight; }
    function bubble(cls,html){ var d=document.createElement('div'); d.className='sb-b '+cls; d.innerHTML=html; msgs.appendChild(d); scroll(); return d; }
    function typing(){ var d=document.createElement('div'); d.className='sb-typing'; d.innerHTML='<i></i><i></i><i></i>'; msgs.appendChild(d); scroll(); return d; }
    function cards(list){ return (list||[]).map(function(p){ return '<a class="sb-card" href="'+esc(p.url)+'"><span class="nm">'+esc(p.name)+'</span>'+(p.priceFrom>0?('<span class="pr">from Rs '+Number(p.priceFrom).toLocaleString('en-US')+'</span>'):'')+'</a>'; }).join(''); }
    function chips(list){ sugg.innerHTML=(list||[]).map(function(t){ return '<button class="cthm-chip" data-q="'+esc(t)+'">'+esc(t)+'</button>'; }).join(''); sugg.querySelectorAll('.cthm-chip').forEach(function(b){ b.addEventListener('click',function(){ ask(b.getAttribute('data-q')); }); }); }
    function reply(j){
      var html=esc(j.reply||'').replace(/\n/g,'<br>');
      if(j.products&&j.products.length) html+=cards(j.products);
      var acts=(j.actions||[]).map(function(a){ return '<button class="cthm-chip on" data-tool="'+esc(a.tool)+'">'+esc(a.label)+'</button>'; });
      if(j.handoff || j.wa){ var wl=j.wa||('https://wa.me/'+WANUM); acts.push('<a class="cthm-chip on" href="'+esc(wl)+'" target="_blank" rel="noopener">Open WhatsApp</a>'); }
      if(acts.length) html+='<div class="sb-act">'+acts.join('')+'</div>';
      var b=bubble('sb-bot',html);
      b.querySelectorAll('[data-tool]').forEach(function(btn){ btn.addEventListener('click',function(){ var tl=btn.getAttribute('data-tool'); if(tl==='iptvrenew'){ openIptvRenew(); } else { setTab(tl); } }); });
      chips(j.suggestions||[]);
    }
    function ask(text){
      text=(text||'').trim(); if(!text) return;
      bubble('sb-me',esc(text)); inp.value=''; chips([]);
      queue.push(text); pump();
    }
    function pump(){
      if(working||!queue.length) return;
      working=true; var text=queue.shift(); var t=typing();
      fetch('/api/support/message',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({message:text})})
        .then(function(r){return r.json();}).then(function(j){ t.remove(); working=false; if(j&&j.ok!==false) reply(j); else bubble('sb-bot','Sorry, I hit a snag — please try again, or tap WhatsApp below.'); pump(); })
        .catch(function(){ t.remove(); working=false; bubble('sb-bot','Network issue — please try again, or tap WhatsApp below.'); pump(); });
    }
    send.addEventListener('click',function(){ ask(inp.value); });
    inp.addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); ask(inp.value); } });
    bubble('sb-bot','Hi! 👋 I’m your support assistant. Ask me about any product — prices, plans, delivery, offers — or your order.');
    chips(['What do you sell?','Best IPTV','Track my order','Talk to a human']);
    setTimeout(function(){ try{ inp.focus(); }catch(e){} },60);
  }
  function fmtd(iso){ if(!iso) return '—'; try{ return new Date(iso).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}); }catch(e){ return '—'; } }
  function subPill(o){ var s=o.sub_status; if(s==='active') return '<span class="cthm-pill ok">Active</span>'; if(s==='expiring') return '<span class="cthm-pill wait">Expiring soon</span>'; if(s==='expired') return '<span class="cthm-pill bad">Expired</span>'; return '<span class="cthm-pill wait">'+esc((o.status||'Pending').charAt(0).toUpperCase()+(o.status||'Pending').slice(1))+'</span>'; }
  function pur(orders){
    if(!orders.length){ body.innerHTML='<div class="cthm-empty">No orders yet.<br><a href="/" style="color:#29d3ff;font-weight:600">Browse products →</a></div>'; return; }
    var f=ordFilter;
    var list=orders.filter(function(o){ if(f==='active') return o.sub_status==='active'||o.sub_status==='expiring'; if(f==='expired') return o.sub_status==='expired'; return true; });
    var chips='<div class="cthm-chips">'+['all','active','expired'].map(function(k){ return '<button class="cthm-chip'+(f===k?' on':'')+'" data-f="'+k+'">'+(k==='all'?'All':k==='active'?'Active':'Expired')+'</button>'; }).join('')+'</div>';
    var rows=list.length? list.map(function(o){
      return '<button class="cthm-ord" data-ord="'+esc(o.order_no)+'"><span style="flex:1;min-width:0"><span class="onm" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(o.product_name||'Order')+'</span><span class="osub">'+esc(o.order_no)+' · '+fmtd(o.purchased)+(o.expiry?(' · exp '+fmtd(o.expiry)):'')+'</span></span>'+subPill(o)+'<svg viewBox="0 0 24 24" width="16" height="16" style="stroke:#9aa6c0;fill:none;stroke-width:2;flex:none"><path d="m9 18 6-6-6-6"/></svg></button>';
    }).join('') : '<div class="cthm-empty">No '+esc(f)+' orders.</div>';
    body.innerHTML=chips+rows;
    body.querySelectorAll('.cthm-chip').forEach(function(b){ b.addEventListener('click',function(){ ordFilter=b.getAttribute('data-f'); pur(cache); }); });
    body.querySelectorAll('.cthm-ord').forEach(function(b){ b.addEventListener('click',function(){ var o=cache.filter(function(x){return x.order_no===b.getAttribute('data-ord');})[0]; if(o) detail(o); }); });
  }
  function detail(o){
