<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Enter reset code · Galaxy Subz × Zayron</title>
<link rel="icon" href="/static/img/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Schibsted+Grotesk:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root{--ink:#0f1836;--muted:#737e9c;--hair:#e7ebf6;--brand:#2a7bff;--violet:#8a2bff;--grad:linear-gradient(118deg,#8a2bff,#2a7bff);--ok:#16b765}
  *{box-sizing:border-box}
  body{margin:0;font-family:'Hanken Grotesk',system-ui,'Segoe UI',sans-serif;color:var(--ink);min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:24px;
    background:#f4f6fc;background-image:radial-gradient(1100px 520px at 12% -12%,rgba(138,43,255,.10),transparent 60%),radial-gradient(1000px 460px at 112% 120%,rgba(42,123,255,.13),transparent 55%)}
  .wrap{width:100%;max-width:400px;animation:rise .5s cubic-bezier(.2,.7,.3,1) both}
  @keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .card{background:#fff;border-radius:22px;box-shadow:0 2px 6px rgba(15,24,54,.05),0 30px 60px -32px rgba(15,24,54,.35);padding:34px 30px 28px}
  .brand{display:flex;align-items:center;justify-content:center;margin-bottom:18px}
  .logo-img{height:52px;width:auto;max-width:240px;object-fit:contain;display:block}
  h1{font-family:'Schibsted Grotesk',sans-serif;font-size:24px;margin:0 0 6px;text-align:center;letter-spacing:-.02em}
  .sub{color:var(--muted);font-size:14px;margin:0 0 22px;text-align:center;line-height:1.5}
  label{display:block;font-size:13px;font-weight:600;margin-bottom:7px}
  input{width:100%;padding:12px 13px;border-radius:11px;border:1px solid var(--hair);background:#f8fafc;font-size:14.5px;margin-bottom:16px;font-family:inherit;color:var(--ink);transition:.15s}
  input:focus{outline:none;border-color:var(--brand);background:#fff;box-shadow:0 0 0 3px rgba(42,123,255,.14)}
  .code-in{letter-spacing:.35em;font-weight:700;font-size:18px;text-align:center}
  button{width:100%;background:var(--grad);color:#fff;font-weight:700;font-size:15px;border:0;border-radius:12px;padding:13px;cursor:pointer;margin-top:2px;box-shadow:0 14px 26px -12px rgba(42,123,255,.6);transition:.15s}
  button:hover{filter:brightness(1.05)}button:active{transform:translateY(1px)}
  .err{background:#fdecec;color:#b42318;border:1px solid #f6c9c4;border-radius:11px;padding:11px 13px;font-size:13.5px;font-weight:600;margin-bottom:16px}
  .info{background:#eaf6ef;color:#16823f;border:1px solid #bfe6cd;border-radius:11px;padding:11px 13px;font-size:13.5px;font-weight:600;margin-bottom:16px}
  .back{display:block;text-align:center;color:var(--muted);font-size:13px;margin-top:16px;font-weight:600}
  .back:hover{color:var(--brand)}
  .done{text-align:center}
  .done .big{width:66px;height:66px;border-radius:50%;display:grid;place-items:center;background:#e7f7ee;color:var(--ok);margin:4px auto 14px}
  .done .big svg{width:34px;height:34px;stroke:currentColor;fill:none;stroke-width:2.6}
  @media(max-width:420px){ .card{padding:28px 22px 24px;border-radius:18px} }
</style></head><body>
<div class="wrap">
  <div class="card">
    <div class="brand"><img src="/static/img/logo.png" alt="Galaxy Subz × Zayron" class="logo-img" onerror="this.style.display='none'"></div>
    <% if (typeof done !== 'undefined' && done) { %>
      <div class="done">
        <span class="big"><svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg></span>
        <h1>Password updated</h1>
        <p class="sub">Your admin password has been changed. You can sign in now.</p>
        <a href="/admin/login"><button type="button">Go to sign in</button></a>
      </div>
    <% } else { %>
      <h1>Enter reset code</h1>
      <p class="sub">Type the code sent to your WhatsApp and set a new password.</p>
      <% if (typeof info !== 'undefined' && info) { %><div class="info"><%= info %></div><% } %>
      <% if (typeof error !== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
      <form method="post" action="/admin/reset">
        <label>Reset code</label>
        <input class="code-in" name="code" inputmode="numeric" autocomplete="one-time-code" placeholder="6-digit code" autofocus required>
        <label>New password</label>
        <input type="password" name="password" autocomplete="new-password" placeholder="At least 8 characters" required>
        <label>Confirm new password</label>
        <input type="password" name="password2" autocomplete="new-password" placeholder="Re-type new password" required>
        <button type="submit">Reset Password</button>
      </form>
      <a class="back" href="/admin/login">Back to login</a>
    <% } %>
  </div>
</div>
</body></html>
