<%- include('_shell_top', { active:'dashboard', title:'Dashboard' }) %>
<style>
  .dcards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}
  @media(max-width:1000px){.dcards{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:620px){.dcards{grid-template-columns:1fr}}
  .dcard{display:flex;gap:14px;align-items:center;background:#fff;border-radius:16px;padding:17px 18px;box-shadow:0 1px 2px rgba(15,24,54,.04),0 16px 34px -26px rgba(15,24,54,.28);position:relative;overflow:hidden}
  .dcard:before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--t)}
  .dic{width:48px;height:48px;border-radius:13px;flex:none;display:grid;place-items:center;background:color-mix(in srgb,var(--t) 14%,#fff);color:var(--t)}
  .dic svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .dmeta{display:flex;flex-direction:column;min-width:0}
  .dlbl{font-size:11.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);font-weight:700}
  .dval{font-family:'Schibsted Grotesk',sans-serif;font-size:25px;font-weight:800;letter-spacing:-.02em;line-height:1.18;margin:2px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .dsub{font-size:12.5px;color:var(--muted);font-weight:600}
  .dsub.alert{color:#b26a00}

  .dacts{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
  @media(max-width:820px){.dacts{grid-template-columns:repeat(2,1fr)}}
  .dact{display:flex;align-items:center;gap:11px;background:#fff;border-radius:13px;padding:14px 16px;font-weight:700;font-size:14px;box-shadow:inset 0 0 0 1px var(--hair);transition:.16s}
  .dact:hover{box-shadow:inset 0 0 0 1.5px var(--brand);color:var(--brand);transform:translateY(-1px)}
  .dact svg{width:19px;height:19px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

  .dpanels{display:grid;grid-template-columns:1.25fr 1fr;gap:18px}
  @media(max-width:860px){.dpanels{grid-template-columns:1fr}}
  .dpanel{background:#fff;border-radius:16px;box-shadow:0 1px 2px rgba(15,24,54,.04),0 16px 34px -26px rgba(15,24,54,.28);overflow:hidden}
  .dph{display:flex;align-items:center;gap:9px;padding:15px 18px;border-bottom:1px solid var(--hair)}
  .dph b{font-size:15px}
  .dph .sp{flex:1}
  .dph a{font-size:13px;color:var(--brand);font-weight:700}
  .dph svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .drow{display:flex;align-items:center;gap:12px;padding:12px 18px;border-top:1px solid var(--hair)}
  .drow:first-of-type{border-top:0}
  .drow .main{flex:1;min-width:0}
  .drow .t{font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .drow .s{font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .dbadge{font-size:11.5px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap}
  .damt{font-weight:800;font-size:14px;white-space:nowrap}
  .dempty{padding:22px 18px;color:var(--muted);font-size:14px}
  .pill{font-size:11.5px;font-weight:800;padding:3px 10px;border-radius:20px;white-space:nowrap}
</style>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<%
  function money(v){ return 'Rs ' + Math.round(Number(v)||0).toLocaleString('en-US'); }
  function when(d){ try{ var x=new Date(d), n=new Date(); var s=(n-x)/1000;
    if(s<60) return 'just now'; if(s<3600) return Math.floor(s/60)+'m ago'; if(s<86400) return Math.floor(s/3600)+'h ago';
    return x.toLocaleDateString('en-GB',{day:'2-digit',month:'short'}); }catch(e){return '';} }
  var SB={ delivered:['#e7f8ee','#0b7a42'], delivering:['#e8f0ff','#1f5fd0'], approved:['#e8f0ff','#1f5fd0'],
           verifying:['#fff2db','#b26a00'], pending:['#fdecec','#b42318'] };
  function badge(st){ var c=SB[st]||['#eef1f6','#667']; return '<span class="dbadge" style="background:'+c[0]+';color:'+c[1]+'">'+st+'</span>'; }
%>

<div class="dcards">
  <div class="dcard" style="--t:#16b765">
    <span class="dic"><svg viewBox="0 0 24 24"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
    <div class="dmeta"><span class="dlbl">Today revenue</span><b class="dval"><%= money(m.rev_today) %></b><span class="dsub"><%= m.orders_today %> order<%= m.orders_today==1?'':'s' %> today</span></div>
  </div>
  <div class="dcard" style="--t:#8a2bff">
    <span class="dic"><svg viewBox="0 0 24 24"><path d="M3 9h18"/><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4"/></svg></span>
    <div class="dmeta"><span class="dlbl">This month</span><b class="dval"><%= money(m.rev_month) %></b><span class="dsub">Revenue, paid orders</span></div>
  </div>
  <div class="dcard" style="--t:#2a7bff">
    <span class="dic"><svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
    <div class="dmeta"><span class="dlbl">Total orders</span><b class="dval"><%= m.orders_total.toLocaleString('en-US') %></b><span class="dsub"><%= m.orders_today %> today</span></div>
  </div>
  <div class="dcard" style="--t:#f5a623">
    <span class="dic"><svg viewBox="0 0 24 24"><path d="M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
    <div class="dmeta"><span class="dlbl">Needs action</span><b class="dval"><%= m.orders_open %></b><span class="dsub <%= m.orders_open>0?'alert':'' %>"><%= m.orders_open>0 ? ('awaiting · '+money(m.open_value)) : 'all caught up' %></span></div>
  </div>
  <div class="dcard" style="--t:#e0459a">
    <span class="dic"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
    <div class="dmeta"><span class="dlbl">Customers</span><b class="dval"><%= m.customers.toLocaleString('en-US') %></b><span class="dsub">Registered accounts</span></div>
  </div>
  <div class="dcard" style="--t:#19b6c6">
    <span class="dic"><svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg></span>
    <div class="dmeta"><span class="dlbl">Products</span><b class="dval"><%= m.products.toLocaleString('en-US') %></b><span class="dsub"><%= m.products_live %> live · <%= m.categories %> categories</span></div>
  </div>
</div>

<div class="dacts">
  <a class="dact" href="/admin/products/new"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Add product</a>
  <a class="dact" href="/admin/inventory"><svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/></svg>Add stock</a>
  <a class="dact" href="/admin/orders"><svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/></svg>Manage orders</a>
  <a class="dact" href="/admin/coupons"><svg viewBox="0 0 24 24"><path d="M4 9V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 0 0 6v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-6z"/></svg>Discount codes</a>
</div>

<div class="dpanels">
  <div class="dpanel">
    <div class="dph"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><b>Recent orders</b><span class="sp"></span><a href="/admin/orders">View all →</a></div>
    <% if (!recent.length) { %><div class="dempty">No orders yet.</div><% } %>
    <% recent.forEach(function(o){ %>
      <a class="drow" href="/admin/orders/<%= o.id %>" style="color:inherit">
        <div class="main">
          <div class="t"><%= o.product_name || o.order_no || ('Order #'+o.id) %></div>
          <div class="s"><%= [o.plan_label, o.order_no].filter(Boolean).join(' · ') %> · <%= when(o.created_at) %></div>
        </div>
        <span class="damt"><%= money(o.amount_pkr) %></span>
        <%- badge(o.status) %>
      </a>
    <% }); %>
  </div>

  <div class="dpanel">
    <div class="dph"><svg viewBox="0 0 24 24"><path d="M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg><b>Low stock</b><span class="sp"></span><a href="/admin/inventory">Inventory →</a></div>
    <% var lows = low.filter(function(x){ return x.avail<=3; }); %>
    <% if (!low.length) { %><div class="dempty">No own-inventory plans yet. <a href="/admin/inventory" style="color:var(--brand);font-weight:600">Set one up →</a></div>
    <% } else if (!lows.length) { %><div class="dempty">All stock pools are healthy ✓</div>
    <% } else { lows.forEach(function(x){ %>
      <a class="drow" href="/admin/inventory/manage/<%= x.id %>" style="color:inherit">
        <div class="main"><div class="t"><%= x.product_name %></div><div class="s"><%= x.label %></div></div>
        <span class="pill" style="background:<%= x.avail==0?'#fdecec':'#fff2db' %>;color:<%= x.avail==0?'#b42318':'#b26a00' %>"><%= x.avail==0?'Out of stock':(x.avail+' left') %></span>
      </a>
    <% }); } %>
    <% if (waitlist>0) { %><div class="drow" style="background:#f7f9fe"><div class="main"><div class="s"><b style="color:var(--ink)"><%= waitlist %></b> customer<%= waitlist==1?'':'s' %> waiting on restock</div></div><a href="/admin/inventory" style="font-size:12.5px;color:var(--brand);font-weight:700">View →</a></div><% } %>
  </div>
</div>
<%- include('_shell_bottom') %>
