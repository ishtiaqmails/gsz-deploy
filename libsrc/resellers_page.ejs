<%- include('partials/store_top') %>
<%
  var panelsList = (typeof panels !== 'undefined' && Array.isArray(panels)) ? panels : [];
  var waNum = (typeof waNumber !== 'undefined' && waNumber) ? String(waNumber).replace(/[^0-9]/g,'') : '';
  var waGeneric = waNum ? ('https://wa.me/'+waNum+'?text='+encodeURIComponent('Hi! I want an IPTV reseller panel.')) : '#';
  function feats(f){ try{ return Array.isArray(f)?f:JSON.parse(f||'[]'); }catch(e){ return []; } }
  function tiersOf(t){ try{ var a = Array.isArray(t)?t:JSON.parse(t||'[]'); return a.filter(function(x){return x&&x.credits;}); }catch(e){ return []; } }
%>
<style>
  .rp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px}
  .rp-card{background:var(--surface,#111322);border:1px solid var(--line-2,rgba(255,255,255,.14));border-radius:18px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 60px -40px rgba(0,0,0,.7)}
  .rp-media{aspect-ratio:16/8;background:#0b1020 center/cover no-repeat;border-bottom:1px solid var(--line,rgba(255,255,255,.08))}
  .rp-body{padding:20px;display:flex;flex-direction:column;gap:12px;flex:1}
  .rp-badge{align-self:flex-start;font-size:11.5px;font-weight:700;letter-spacing:.3px;color:#cdd6ff;background:rgba(123,43,255,.16);border:1px solid rgba(123,43,255,.35);padding:4px 10px;border-radius:999px}
  .rp-name{font-family:var(--display,inherit);font-weight:800;font-size:20px;margin:0;color:var(--ink,#eef1ff)}
  .rp-tag{color:var(--ink-soft,#c4cae8);font-size:14px;line-height:1.5;margin:0}
  .rp-feats{list-style:none;padding:0;margin:2px 0;display:flex;flex-direction:column;gap:7px}
  .rp-feats li{display:flex;gap:9px;align-items:flex-start;color:var(--ink-soft,#c4cae8);font-size:14px;line-height:1.45}
  .rp-feats svg{flex:none;width:17px;height:17px;margin-top:1px;color:#3b82ff}
  .rp-slab{background:rgba(255,255,255,.03);border:1px solid var(--line,rgba(255,255,255,.08));border-radius:14px;padding:14px;margin-top:auto}
  .rp-slab-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:11px}
  .rp-slab-top .lbl{font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted,#8b93bb)}
  .rp-credits{font-family:var(--display,inherit);font-weight:800;font-size:18px;color:var(--ink,#eef1ff)}
  .rp-range{width:100%;-webkit-appearance:none;appearance:none;height:6px;border-radius:999px;background:var(--line-2,rgba(255,255,255,.16));outline:none;margin:0}
  .rp-range::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:#3b82ff;border:3px solid #0b1020;box-shadow:0 0 0 1px #3b82ff;cursor:pointer}
  .rp-range::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:#3b82ff;border:3px solid #0b1020;cursor:pointer}
  .rp-ticks{display:flex;justify-content:space-between;margin-top:8px;color:var(--muted,#8b93bb);font-size:11px;gap:4px}
  .rp-total-row{display:flex;justify-content:space-between;align-items:flex-end;margin-top:14px;gap:10px}
  .rp-total .t{font-size:12px;color:var(--muted,#8b93bb)}
  .rp-total .v{font-family:var(--display,inherit);font-weight:800;font-size:23px;color:var(--ink,#eef1ff)}
  .rp-per{font-size:12px;font-weight:700;color:#cdd6ff;background:rgba(59,130,255,.14);border:1px solid rgba(59,130,255,.3);padding:5px 10px;border-radius:999px;white-space:nowrap}
  .rp-cta{display:flex;flex-direction:column;gap:9px;margin-top:14px}
  .rp-empty{background:var(--surface,#111322);border:1px solid var(--line-2,rgba(255,255,255,.14));border-radius:18px;padding:34px 22px;text-align:center;max-width:460px;margin:0 auto}
</style>

<section class="section">
  <div class="wrap">
    <div class="sec-head"><div><span class="eyebrow"><span class="dot"></span>Choose your panel</span><h2>IPTV reseller panels</h2></div></div>

    <% if (!panelsList.length) { %>
      <div class="rp-empty">
        <h3 style="font-family:var(--display);font-weight:800;font-size:20px;margin:0 0 8px">Panels are being set up</h3>
        <p style="color:var(--ink-soft);font-size:14.5px;line-height:1.6;margin:0 0 18px">Message us on WhatsApp and we'll set you up with the right server, a free trial, and your reseller pricing.</p>
        <a class="btn btn-primary btn-lg" href="<%= waGeneric %>" target="_blank" rel="noopener">Ask on WhatsApp</a>
      </div>
    <% } else { %>
      <div class="rp-grid">
        <% panelsList.forEach(function(p){ var ts = tiersOf(p.tiers); var fs = feats(p.features); var cur = p.currency || 'PKR'; %>
          <div class="rp-card" data-name="<%= (p.name||'').replace(/"/g,'&quot;') %>" data-cur="<%= cur %>" data-watext="<%= (p.wa_text||'').replace(/"/g,'&quot;') %>" data-tiers='<%- JSON.stringify(ts).replace(/'/g,"&#39;") %>'>
            <% if (p.image_url) { %><div class="rp-media" style="background-image:url('<%= p.image_url %>')"></div><% } %>
            <div class="rp-body">
              <% if (p.badge) { %><span class="rp-badge"><%= p.badge %></span><% } %>
              <h3 class="rp-name"><%= p.name %></h3>
              <% if (p.tagline) { %><p class="rp-tag"><%= p.tagline %></p><% } %>
              <% if (fs.length) { %>
                <ul class="rp-feats">
                  <% fs.forEach(function(ft){ %><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><%= ft %></span></li><% }); %>
                </ul>
              <% } %>

              <% if (ts.length) { %>
                <div class="rp-slab">
                  <div class="rp-slab-top"><span class="lbl">Credits</span><span class="rp-credits js-credits"></span></div>
                  <input type="range" class="rp-range js-range" min="0" max="<%= ts.length-1 %>" step="1" value="0" <%= ts.length<2 ? 'disabled' : '' %>>
                  <div class="rp-ticks"><% ts.forEach(function(t){ %><span><%= t.credits %></span><% }); %></div>
                  <div class="rp-total-row">
                    <div class="rp-total"><div class="t">Total</div><div class="v js-total"></div></div>
                    <span class="rp-per js-per"></span>
                  </div>
                </div>
              <% } %>

              <div class="rp-cta">
                <a class="btn btn-primary js-getwa" href="#" target="_blank" rel="noopener">Get reseller access</a>
                <a class="btn btn-ghost" href="<%= waGeneric %>" target="_blank" rel="noopener">Ask on WhatsApp</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="sec-head"><div><span class="eyebrow"><span class="dot"></span>How it works</span><h2>Up and running in three steps</h2></div></div>
    <div class="pgrid" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr))">
      <div class="pcard" style="padding:24px"><div style="font-family:var(--display);font-weight:800;font-size:30px;color:var(--b);margin-bottom:8px">1</div><h3 style="font-family:var(--display);font-weight:800;font-size:17px;margin:0 0 6px">Pick a panel &amp; credits</h3><p style="color:var(--ink-soft);font-size:14.5px;line-height:1.6;margin:0">Choose a server and slide to the credit pack you want. Message us and we'll confirm and send a free trial.</p></div>
      <div class="pcard" style="padding:24px"><div style="font-family:var(--display);font-weight:800;font-size:30px;color:var(--b);margin-bottom:8px">2</div><h3 style="font-family:var(--display);font-weight:800;font-size:17px;margin:0 0 6px">Get your panel &amp; credits</h3><p style="color:var(--ink-soft);font-size:14.5px;line-height:1.6;margin:0">We hand over your reseller panel login and load your first credits. You're ready to sell.</p></div>
      <div class="pcard" style="padding:24px"><div style="font-family:var(--display);font-weight:800;font-size:30px;color:var(--b);margin-bottom:8px">3</div><h3 style="font-family:var(--display);font-weight:800;font-size:17px;margin:0 0 6px">Sell &amp; grow</h3><p style="color:var(--ink-soft);font-size:14.5px;line-height:1.6;margin:0">Create lines, set your prices, and top up credits as you grow. Better rates as your volume rises.</p></div>
    </div>
    <div style="margin-top:26px"><a class="btn btn-primary btn-lg" href="<%= waGeneric %>" target="_blank" rel="noopener">Get your IPTV panel</a></div>
  </div>
</section>

<script>
(function(){
  var WA = <%- JSON.stringify(waNum) %>;
  function fmt(n){ return Math.round(n).toLocaleString('en-US'); }
  function waHref(card, credits, total){
    var name = card.getAttribute('data-name') || 'reseller panel';
    var cur = card.getAttribute('data-cur') || '';
    var tmpl = card.getAttribute('data-watext') || '';
    var msg;
    if (credits != null){
      if (tmpl) msg = tmpl.replace(/\{panel\}/g,name).replace(/\{credits\}/g,credits).replace(/\{cur\}/g,cur).replace(/\{total\}/g,fmt(total));
      else msg = 'Hi! I want the '+name+' reseller panel — '+credits+' credits ('+cur+' '+fmt(total)+').';
    } else {
      msg = tmpl ? tmpl.replace(/\{panel\}/g,name) : ('Hi! I want the '+name+' reseller panel.');
    }
    return 'https://wa.me/'+WA+'?text='+encodeURIComponent(msg);
  }
  document.querySelectorAll('.rp-card').forEach(function(card){
    var tiers=[]; try{ tiers = JSON.parse(card.getAttribute('data-tiers')||'[]'); }catch(e){ tiers=[]; }
    var range = card.querySelector('.js-range');
    var getwa = card.querySelector('.js-getwa');
    if (!tiers.length){ if (getwa) getwa.href = waHref(card, null); return; }
    var cur = card.getAttribute('data-cur') || '';
    function paint(i){
      var t = tiers[i] || tiers[0];
      var total = t.credits * t.price;
      var cEl=card.querySelector('.js-credits'), tEl=card.querySelector('.js-total'), pEl=card.querySelector('.js-per');
      if(cEl) cEl.textContent = t.credits + ' credits';
      if(tEl) tEl.textContent = cur + ' ' + fmt(total);
      if(pEl) pEl.textContent = cur + ' ' + fmt(t.price) + ' / credit';
      if(getwa) getwa.href = waHref(card, t.credits, total);
    }
    if (range){ range.addEventListener('input', function(){ paint(parseInt(range.value,10)||0); }); }
    paint(0);
  });
})();
</script>
<%- include('partials/store_bottom') %>
