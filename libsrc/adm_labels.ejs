<%- include('_shell_top', { active:'labels', title:'Version names' }) %>
<p class="sub" style="margin-bottom:16px">Rename the version options customers see (e.g. show <b>Adult (XXX)</b> as <b>Adult 18+</b>). Leave a box blank to keep the default.</p>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<form method="post" action="/admin/labels/save">
  <% if (!rows.length) { %>
    <div class="card dempty" style="padding:22px">No products with version options are mapped yet. Once a product has a bot plan offering more than one version (like Family / Adult), it appears here.</div>
  <% } %>
  <% rows.forEach(function(b){ %>
    <div class="card">
      <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:12px">
        <h2 style="margin:0"><%= b.name %></h2>
        <code style="color:var(--muted);font-size:12px"><%= b.sku %></code>
      </div>
      <div style="display:grid;gap:12px">
        <% b.types.forEach(function(t){ %>
          <div style="display:grid;grid-template-columns:minmax(140px,220px) 1fr;gap:14px;align-items:center">
            <div>
              <div style="font-weight:600">Default: <%= t.botLabel %></div>
              <div style="color:var(--muted);font-size:12px">code: <%= t.key %></div>
            </div>
            <input type="text" name="l[<%= b.sku %>][<%= t.key %>]" value="<%= t.custom %>" placeholder="<%= t.botLabel %>" style="margin:0">
          </div>
        <% }); %>
      </div>
    </div>
  <% }); %>
  <% if (rows.length) { %><button class="btn btn-p" type="submit">Save version names</button><% } %>
</form>
<%- include('_shell_bottom') %>
