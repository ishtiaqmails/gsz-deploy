<%- include('_shell_top', { active:'reports', title:'Reports' }) %>
<style>
  .rp-head{margin:2px 0 16px}
  .rp-head h2{margin:0;font-size:20px;font-weight:800}
  .rp-head p{margin:3px 0 0;color:var(--muted);font-size:13px}
  .rp-trend{display:inline-flex;align-items:center;gap:3px;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:999px;margin-left:2px}
  .rp-trend.up{background:#e7f6ee;color:#16935c}
  .rp-trend.dn{background:#fdeaea;color:#b42318}
  .rp-graph{padding:18px 18px 10px;margin-top:2px}
  .rp-gtop{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .rp-gtitle{font-weight:800;font-size:15px;flex:1}
  .rp-seg{display:inline-flex;background:#eef2fb;border-radius:10px;padding:3px}
  .rp-seg button{border:0;background:transparent;color:#49527a;font-weight:700;font-size:12.5px;padding:6px 12px;border-radius:8px;cursor:pointer}
  .rp-seg button.on{background:#fff;color:var(--brand);box-shadow:0 1px 3px rgba(18,22,40,.12)}
  .rp-ranges{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
  .rp-ranges button{border:1px solid var(--hair);background:#fff;color:#49527a;font-weight:600;font-size:12.5px;padding:6px 11px;border-radius:999px;cursor:pointer}
  .rp-ranges button.on{background:var(--grad);color:#fff;border-color:transparent}
  .rp-chart{width:100%;height:260px;display:block}
  .rp-empty{color:var(--muted);font-size:13px;padding:30px;text-align:center}
  .rp-cols{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
  .rp-list h3{margin:0;font-weight:800;font-size:15px;padding:16px 16px 4px}
  .rp-row{display:flex;align-items:center;gap:12px;padding:11px 16px;border-top:1px solid var(--hair)}
  .rp-rank{width:26px;height:26px;border-radius:8px;flex:none;display:grid;place-items:center;font-weight:800;font-size:12px;background:#eef2fb;color:#5b6bb5}
  .rp-rank.g1{background:#fff4d6;color:#b7791f}.rp-rank.g2{background:#eef1f6;color:#5b6475}.rp-rank.g3{background:#f6e8df;color:#a5612f}
  .rp-rmeta{flex:1;min-width:0}
  .rp-rname{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rp-rsub{color:var(--muted);font-size:12px}
  .rp-rval{font-weight:800;font-size:14px;white-space:nowrap}
  @media(max-width:820px){ .rp-cols{grid-template-columns:1fr} }
</style>
<%
  function money(n){ return 'Rs ' + Number(n||0).toLocaleString('en-US'); }
  function pct(cur, prev){ cur=Number(cur||0); prev=Number(prev||0); if(prev<=0) return null; return Math.round((cur-prev)/prev*100); }
  function trend(p){ if(p===null) return ''; var up=p>=0; return '<span class="rp-trend '+(up?'up':'dn')+'">'+(up?'▲':'▼')+' '+Math.abs(p)+'%</span>'; }
  var s=stats||{};
  var tToday=pct(s.today_rev,s.yday_rev), tWeek=pct(s.week_rev,s.lastweek_rev), tMonth=pct(s.month_rev,s.lastmonth_rev);
%>

<div class="rp-head"><h2>Reports &amp; analytics</h2><p>Your store performance, live from real orders.</p></div>

<div class="dcards c3">
  <div class="dcard" style="--t:#16b765"><span class="dic"><svg viewBox="0 0 24 24"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
    <div class="dmeta"><span class="dlbl">Today's sales</span><b class="dval"><%= money(s.today_rev) %></b><span class="dsub"><%= s.today_orders||0 %> orders <%- trend(tToday) %></span></div></div>
  <div class="dcard" style="--t:#2a7bff"><span class="dic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
    <div class="dmeta"><span class="dlbl">This week</span><b class="dval"><%= money(s.week_rev) %></b><span class="dsub"><%= s.week_orders||0 %> orders <%- trend(tWeek) %></span></div></div>
  <div class="dcard" style="--t:#9a6cff"><span class="dic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 15h3"/></svg></span>
    <div class="dmeta"><span class="dlbl">This month</span><b class="dval"><%= money(s.month_rev) %></b><span class="dsub"><%= s.month_orders||0 %> orders <%- trend(tMonth) %></span></div></div>
  <div class="dcard" style="--t:#e0a93f"><span class="dic"><svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M5 4H3v2a3 3 0 0 0 3 3M19 4h2v2a3 3 0 0 1-3 3"/></svg></span>
    <div class="dmeta"><span class="dlbl">All-time sales</span><b class="dval"><%= money(s.all_rev) %></b><span class="dsub"><%= (s.all_orders||0).toLocaleString('en-US') %> orders</span></div></div>
  <div class="dcard" style="--t:#2a7bff"><span class="dic"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
    <div class="dmeta"><span class="dlbl">Total customers</span><b class="dval"><%= (s.customers||0).toLocaleString('en-US') %></b><span class="dsub">registered accounts</span></div></div>
  <div class="dcard" style="--t:#e0453f"><span class="dic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
    <div class="dmeta"><span class="dlbl">Open orders</span><b class="dval"><%= s.open_orders||0 %></b><span class="dsub"><%= money(s.open_value) %> awaiting</span></div></div>
</div>

<div class="card rp-graph">
  <div class="rp-gtop">
    <span class="rp-gtitle" id="rpTitle">Revenue</span>
    <span class="rp-seg"><button class="on" data-metric="rev" onclick="rpMetric(this)">Revenue</button><button data-metric="orders" onclick="rpMetric(this)">Orders</button></span>
  </div>
  <div class="rp-ranges" id="rpRanges">
    <button class="on" data-range="14d" onclick="rpRange(this)">14 Days</button>
    <button data-range="1m" onclick="rpRange(this)">1 Month</button>
    <button data-range="3m" onclick="rpRange(this)">3 Months</button>
    <button data-range="6m" onclick="rpRange(this)">6 Months</button>
    <button data-range="1y" onclick="rpRange(this)">1 Year</button>
    <button data-range="all" onclick="rpRange(this)">All Time</button>
  </div>
  <svg class="rp-chart" id="rpChart" viewBox="0 0 800 260" preserveAspectRatio="none" role="img"></svg>
  <div class="rp-empty" id="rpEmpty" style="display:none">No data for this range yet.</div>
</div>

<div class="rp-cols">
  <div class="card rp-list">
    <h3>🏆 Top products</h3>
    <% if(!prods.length){ %><div class="rp-empty">No sales yet.</div><% } %>
    <% prods.forEach(function(p,i){ %>
      <div class="rp-row"><span class="rp-rank <%= i<3?('g'+(i+1)):'' %>"><%= i+1 %></span>
        <div class="rp-rmeta"><div class="rp-rname"><%= p.name %></div><div class="rp-rsub"><%= p.sold %> sold</div></div>
        <span class="rp-rval">Rs <%= Number(p.rev).toLocaleString('en-US') %></span></div>
    <% }); %>
  </div>
  <div class="card rp-list">
    <h3>⭐ Top customers</h3>
    <% if(!custs.length){ %><div class="rp-empty">No customers yet.</div><% } %>
    <% custs.forEach(function(c,i){ %>
      <div class="rp-row"><span class="rp-rank <%= i<3?('g'+(i+1)):'' %>"><%= i+1 %></span>
        <div class="rp-rmeta"><div class="rp-rname"><%= c.name %></div><div class="rp-rsub"><%= c.orders %> orders</div></div>
        <span class="rp-rval">Rs <%= Number(c.spend).toLocaleString('en-US') %></span></div>
    <% }); %>
  </div>
</div>

<script>
(function(){
  var metric='rev', range='14d', data=[];
  var svg=document.getElementById('rpChart');
  var NS='http://www.w3.org/2000/svg';
  function el(n,a){ var e=document.createElementNS(NS,n); for(var k in a) e.setAttribute(k,a[k]); return e; }
  function fmtDate(iso){ var d=new Date(iso+'T00:00:00'); return d.toLocaleDateString('en-GB',{day:'numeric',month:'short'}); }
  function money(n){ return 'Rs '+Number(n||0).toLocaleString('en-US'); }

  function draw(){
    svg.innerHTML='';
    var empty=document.getElementById('rpEmpty');
    if(!data.length){ empty.style.display=''; return; } empty.style.display='none';
    var W=800,H=260,pL=52,pR=14,pT=16,pB=30;
    var vals=data.map(function(r){ return Number(metric==='rev'?r.rev:r.orders); });
    var max=Math.max.apply(null,vals.concat([1]));
    // round max up to a nice number
    var mag=Math.pow(10,Math.floor(Math.log10(max))); max=Math.ceil(max/mag)*mag;
    var n=data.length, iw=W-pL-pR, ih=H-pT-pB;
    var xAt=function(i){ return pL + (n<=1?iw/2:(i*iw/(n-1))); };
    var yAt=function(v){ return pT + ih - (v/max)*ih; };
    // gridlines + y labels
    for(var g=0;g<=4;g++){ var gy=pT+ih-(g/4)*ih; svg.appendChild(el('line',{x1:pL,y1:gy,x2:W-pR,y2:gy,stroke:'#eef1f8','stroke-width':1}));
      var lab=el('text',{x:pL-8,y:gy+4,'text-anchor':'end','font-size':11,fill:'#9aa3bd'}); lab.textContent=(metric==='rev'?('Rs '+Math.round(max*g/4).toLocaleString('en-US')):String(Math.round(max*g/4))); svg.appendChild(lab); }
    // area + line
    var dLine='', dArea='';
    data.forEach(function(r,i){ var x=xAt(i),y=yAt(vals[i]); dLine+=(i?'L':'M')+x.toFixed(1)+' '+y.toFixed(1)+' '; });
    dArea=dLine+'L'+xAt(n-1).toFixed(1)+' '+(pT+ih)+' L'+xAt(0).toFixed(1)+' '+(pT+ih)+' Z';
    var grad=el('linearGradient',{id:'rpg',x1:0,y1:0,x2:0,y2:1}); grad.appendChild(el('stop',{offset:'0%','stop-color':'#2a7bff','stop-opacity':.22})); grad.appendChild(el('stop',{offset:'100%','stop-color':'#2a7bff','stop-opacity':0}));
    var defs=el('defs',{}); defs.appendChild(grad); svg.appendChild(defs);
    svg.appendChild(el('path',{d:dArea,fill:'url(#rpg)'}));
    svg.appendChild(el('path',{d:dLine,fill:'none',stroke:'#2a7bff','stroke-width':2.4,'stroke-linejoin':'round','stroke-linecap':'round'}));
    // x labels (about 6)
    var step=Math.max(1,Math.ceil(n/6));
    for(var i=0;i<n;i+=step){ var t=el('text',{x:xAt(i),y:H-8,'text-anchor':'middle','font-size':11,fill:'#9aa3bd'}); t.textContent=fmtDate(data[i].d); svg.appendChild(t); }
    // last point dot
    if(n){ svg.appendChild(el('circle',{cx:xAt(n-1),cy:yAt(vals[n-1]),r:3.5,fill:'#2a7bff'})); }
  }

  function load(){
    fetch('/admin/reports/series.json?range='+range,{credentials:'include'})
      .then(function(r){return r.json();}).then(function(j){ data=(j&&j.series)||[]; draw(); })
      .catch(function(){ data=[]; draw(); });
  }
  window.rpMetric=function(b){ [].slice.call(b.parentElement.children).forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); metric=b.getAttribute('data-metric'); document.getElementById('rpTitle').textContent=metric==='rev'?'Revenue':'Orders'; draw(); };
  window.rpRange=function(b){ [].slice.call(document.querySelectorAll('#rpRanges button')).forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); range=b.getAttribute('data-range'); load(); };
  load();
})();
</script>
<%- include('_shell_bottom') %>
