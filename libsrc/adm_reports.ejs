<%- include('_shell_top', { active:'reports', title:'Reports' }) %>
<style>
  .rp-head{margin:2px 0 16px}
  .rp-head h2{margin:0;font-size:20px;font-weight:800}
  .rp-head p{margin:3px 0 0;color:var(--muted);font-size:13px}
  .rp-trend{display:inline-flex;align-items:center;gap:3px;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:999px;margin-left:2px}
  .rp-trend.up{background:#e7f6ee;color:#16935c}
  .rp-trend.dn{background:#fdeaea;color:#b42318}
  /* smart insights */
  .rp-ins{padding:16px 18px;margin-top:2px}
  .rp-ins h3{margin:0 0 12px;font-weight:800;font-size:15px;display:flex;align-items:center;gap:7px}
  .rp-igrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px}
  .rp-i{display:flex;gap:11px;align-items:flex-start;padding:12px;border:1px solid var(--hair);border-radius:12px;background:#fbfcff}
  .rp-i .ii{width:34px;height:34px;border-radius:10px;flex:none;display:grid;place-items:center;font-size:17px;background:#eef3ff}
  .rp-i b{font-weight:700;font-size:13px;display:block;line-height:1.3}
  .rp-i small{color:var(--muted);font-size:12px}
  /* graph */
  .rp-graph{padding:18px 18px 10px;margin-top:16px}
  .rp-gtop{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .rp-gtitle{font-weight:800;font-size:15px;flex:1}
  .rp-seg{display:inline-flex;background:#eef2fb;border-radius:10px;padding:3px}
  .rp-seg button{border:0;background:transparent;color:#49527a;font-weight:700;font-size:12.5px;padding:6px 12px;border-radius:8px;cursor:pointer}
  .rp-seg button.on{background:#fff;color:var(--brand);box-shadow:0 1px 3px rgba(18,22,40,.12)}
  .rp-ranges{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
  .rp-ranges button{border:1px solid var(--hair);background:#fff;color:#49527a;font-weight:600;font-size:12.5px;padding:6px 11px;border-radius:999px;cursor:pointer}
  .rp-ranges button.on{background:var(--grad);color:#fff;border-color:transparent}
  .rp-chart{width:100%;height:260px;display:block}
  .rp-empty{color:var(--muted);font-size:13px;padding:30px;text-align:center}
  /* lists / grids */
  .rp-cols{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
  .rp-list h3,.rp-cardttl{margin:0;font-weight:800;font-size:15px;padding:16px 16px 4px;display:flex;align-items:center;gap:7px}
  .rp-row{display:flex;align-items:center;gap:12px;padding:11px 16px;border-top:1px solid var(--hair)}
  .rp-rank{width:26px;height:26px;border-radius:8px;flex:none;display:grid;place-items:center;font-weight:800;font-size:12px;background:#eef2fb;color:#5b6bb5}
  .rp-rank.g1{background:#fff4d6;color:#b7791f}.rp-rank.g2{background:#eef1f6;color:#5b6475}.rp-rank.g3{background:#f6e8df;color:#a5612f}
  .rp-rmeta{flex:1;min-width:0}
  .rp-rname{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rp-rsub{color:var(--muted);font-size:12px}
  .rp-rval{font-weight:800;font-size:14px;white-space:nowrap}
  .rp-pill{font-size:11px;font-weight:800;padding:2px 9px;border-radius:999px;white-space:nowrap}
  .rp-pill.ok{background:#e7f6ee;color:#16935c}.rp-pill.low{background:#fff3e0;color:#b56a00}.rp-pill.out{background:#fdeaea;color:#b42318}
  /* chart cards */
  .rp-ctitle{margin:0;font-weight:800;font-size:14.5px;padding:15px 16px 2px;display:flex;align-items:center;gap:7px}
  .rp-csub{color:var(--muted);font-size:12px;padding:0 16px 8px}
  .rp-pad{padding:4px 14px 16px}
  .rp-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:16px}
  .rp-legend{display:flex;flex-wrap:wrap;gap:8px 14px;padding:4px 16px 14px}
  .rp-lg{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--ink)}
  .rp-lg i{width:10px;height:10px;border-radius:3px;display:inline-block}
  .rp-lg b{font-weight:800}
  .rp-lg small{color:var(--muted)}
  /* heatmap */
  .rp-heatwrap{padding:6px 16px 16px;overflow-x:auto}
  .rp-hscale{display:flex;align-items:center;gap:8px;padding:0 16px 12px;color:var(--muted);font-size:12px}
  .rp-hscale .sw{width:16px;height:12px;border-radius:3px}
  @media(max-width:960px){ .rp-3{grid-template-columns:1fr 1fr} }
  @media(max-width:820px){ .rp-cols{grid-template-columns:1fr} .rp-3{grid-template-columns:1fr} }
</style>
<%
  function money(n){ return 'Rs ' + Number(n||0).toLocaleString('en-US'); }
  function pct(cur, prev){ cur=Number(cur||0); prev=Number(prev||0); if(prev<=0) return null; return Math.round((cur-prev)/prev*100); }
  function trend(p){ if(p===null) return ''; var up=p>=0; return '<span class="rp-trend '+(up?'up':'dn')+'">'+(up?'▲':'▼')+' '+Math.abs(p)+'%</span>'; }
  var DOW=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  function h12(h){ if(h===null||h===undefined) return '—'; h=Number(h); var ap=h<12?'AM':'PM'; var hh=h%12; if(hh===0)hh=12; return hh+' '+ap; }
  var s=stats||{};
  var tToday=pct(s.today_rev,s.yday_rev), tWeek=pct(s.week_rev,s.lastweek_rev), tMonth=pct(s.month_rev,s.lastmonth_rev);
  var bestP=(prods&&prods[0])?prods[0]:null, topC=(custs&&custs[0])?custs[0]:null;
  var pk=peak||{hr:null,dow:null};
%>

<div class="rp-head"><h2>Reports &amp; analytics</h2><p>Your store performance, live from real orders · times shown in Pakistan time.</p></div>

<div class="dcards c3">
  <div class="dcard" style="--t:#16b765"><span class="dic"><svg viewBox="0 0 24 24"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
    <div class="dmeta"><span class="dlbl">Today's sales</span><b class="dval"><%= money(s.today_rev) %></b><span class="dsub"><%= s.today_orders||0 %> orders <%- trend(tToday) %></span></div></div>
  <div class="dcard" style="--t:#2a7bff"><span class="dic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
    <div class="dmeta"><span class="dlbl">This week</span><b class="dval"><%= money(s.week_rev) %></b><span class="dsub"><%= s.week_orders||0 %> orders <%- trend(tWeek) %></span></div></div>
  <div class="dcard" style="--t:#9a6cff"><span class="dic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 15h3"/></svg></span>
    <div class="dmeta"><span class="dlbl">This month</span><b class="dval"><%= money(s.month_rev) %></b><span class="dsub"><%= s.month_orders||0 %> orders <%- trend(tMonth) %></span></div></div>
  <div class="dcard" style="--t:#e0a93f"><span class="dic"><svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M5 4H3v2a3 3 0 0 0 3 3M19 4h2v2a3 3 0 0 1-3 3"/></svg></span>
    <div class="dmeta"><span class="dlbl">All-time sales</span><b class="dval"><%= money(s.all_rev) %></b><span class="dsub"><%= (s.all_orders||0).toLocaleString('en-US') %> orders</span></div></div>
  <div class="dcard" style="--t:#2a7bff"><span class="dic"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
    <div class="dmeta"><span class="dlbl">Total customers</span><b class="dval"><%= (s.customers||0).toLocaleString('en-US') %></b><span class="dsub">registered accounts</span></div></div>
  <div class="dcard" style="--t:#e0453f"><span class="dic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
    <div class="dmeta"><span class="dlbl">Open orders</span><b class="dval"><%= s.open_orders||0 %></b><span class="dsub"><%= money(s.open_value) %> awaiting</span></div></div>
</div>

<div class="card rp-ins">
  <h3>🔮 Smart insights</h3>
  <div class="rp-igrid">
    <% if(bestP){ %><div class="rp-i"><span class="ii">🏆</span><div><b><%= bestP.name %></b><small>Best seller — <%= money(bestP.rev) %> from <%= bestP.sold %> orders</small></div></div><% } %>
    <% if(topC){ %><div class="rp-i"><span class="ii">👑</span><div><b><%= topC.name %></b><small>Top customer — <%= topC.orders %> orders, <%= money(topC.spend) %></small></div></div><% } %>
    <% if(pk.hr!==null){ %><div class="rp-i"><span class="ii">⏰</span><div><b><%= h12(pk.hr) %> – <%= h12((Number(pk.hr)+1)%24) %></b><small>Peak order hour — plan promos &amp; staffing here</small></div></div><% } %>
    <% if(pk.dow!==null){ %><div class="rp-i"><span class="ii">📅</span><div><b><%= DOW[pk.dow]||'' %></b><small>Your busiest day of the week</small></div></div><% } %>
    <div class="rp-i"><span class="ii"><%= (tToday===null||tToday>=0)?'📈':'📉' %></span><div><b><%= (tToday===null)?'—':((tToday>=0?'+':'')+tToday+'% vs yesterday') %></b><small>Today is <%= money(s.today_rev) %> so far</small></div></div>
    <div class="rp-i"><span class="ii">🧾</span><div><b><%= money(s.open_value) %></b><small><%= s.open_orders||0 %> orders awaiting verification</small></div></div>
  </div>
</div>

<div class="card rp-graph">
  <div class="rp-gtop">
    <span class="rp-gtitle" id="rpTitle">Revenue</span>
    <span class="rp-seg"><button class="on" data-metric="rev" onclick="rpMetric(this)">Revenue</button><button data-metric="orders" onclick="rpMetric(this)">Orders</button></span>
  </div>
  <div class="rp-ranges" id="rpRanges">
    <button class="on" data-range="14d" onclick="rpRange(this)">14 Days</button>
    <button data-range="1m" onclick="rpRange(this)">1 Month</button>
    <button data-range="3m" onclick="rpRange(this)">3 Months</button>
    <button data-range="6m" onclick="rpRange(this)">6 Months</button>
    <button data-range="1y" onclick="rpRange(this)">1 Year</button>
    <button data-range="all" onclick="rpRange(this)">All Time</button>
  </div>
  <svg class="rp-chart" id="rpChart" viewBox="0 0 800 260" preserveAspectRatio="none" role="img"></svg>
  <div class="rp-empty" id="rpEmpty" style="display:none">No data for this range yet.</div>
</div>

<div class="rp-cols">
  <div class="card rp-list">
    <h3>🏆 Top products</h3>
    <% if(!prods.length){ %><div class="rp-empty">No sales yet.</div><% } %>
    <% prods.forEach(function(p,i){ %>
      <div class="rp-row"><span class="rp-rank <%= i<3?('g'+(i+1)):'' %>"><%= i+1 %></span>
        <div class="rp-rmeta"><div class="rp-rname"><%= p.name %></div><div class="rp-rsub"><%= p.sold %> sold</div></div>
        <span class="rp-rval">Rs <%= Number(p.rev).toLocaleString('en-US') %></span></div>
    <% }); %>
  </div>
  <div class="card rp-list">
    <h3>⭐ Top customers</h3>
    <% if(!custs.length){ %><div class="rp-empty">No customers yet.</div><% } %>
    <% custs.forEach(function(c,i){ %>
      <div class="rp-row"><span class="rp-rank <%= i<3?('g'+(i+1)):'' %>"><%= i+1 %></span>
        <div class="rp-rmeta"><div class="rp-rname"><%= c.name %></div><div class="rp-rsub"><%= c.orders %> orders</div></div>
        <span class="rp-rval">Rs <%= Number(c.spend).toLocaleString('en-US') %></span></div>
    <% }); %>
  </div>
</div>

<div class="rp-cols">
  <div class="card rp-list">
    <h3>⚠️ Low stock</h3>
    <% if(!low.length){ %><div class="rp-empty">All inventory plans are well stocked. ✓</div><% } %>
    <% low.forEach(function(l){ var a=Number(l.avail); %>
      <div class="rp-row"><span class="rp-rank" style="background:<%= a===0?'#fdeaea':'#fff3e0' %>;color:<%= a===0?'#b42318':'#b56a00' %>"><%= a %></span>
        <div class="rp-rmeta"><div class="rp-rname"><%= l.product %></div><div class="rp-rsub"><%= l.plan %></div></div>
        <span class="rp-pill <%= a===0?'out':'low' %>"><%= a===0?'Out of stock':(a+' left') %></span></div>
    <% }); %>
  </div>
  <div class="card">
    <h3 class="rp-ctitle">👤 Customer mix</h3>
    <div class="rp-csub">Paid orders by account type</div>
    <div class="rp-pad"><svg id="rpMix" viewBox="0 0 260 180" style="width:100%;height:180px;display:block"></svg></div>
    <div class="rp-legend" id="rpMixLeg"></div>
  </div>
</div>

<div class="card" style="margin-top:16px">
  <h3 class="rp-ctitle">🌡️ Order heatmap</h3>
  <div class="rp-csub">When orders come in — hour × day of week (last 30 days, Pakistan time)</div>
  <div class="rp-heatwrap"><svg id="rpHeat" viewBox="0 0 760 210" preserveAspectRatio="xMinYMin meet" style="width:100%;min-width:620px;height:210px;display:block"></svg></div>
  <div class="rp-hscale">Less <span class="sw" style="background:#eef2fb"></span><span class="sw" style="background:#bcd2ff"></span><span class="sw" style="background:#7aa6ff"></span><span class="sw" style="background:#2a7bff"></span><span class="sw" style="background:#163e8c"></span> More</div>
</div>

<div class="rp-3">
  <div class="card">
    <h3 class="rp-ctitle">💳 Payment methods</h3>
    <div class="rp-csub">Share of paid orders</div>
    <div class="rp-pad"><svg id="rpPay" viewBox="0 0 220 180" style="width:100%;height:180px;display:block"></svg></div>
    <div class="rp-legend" id="rpPayLeg"></div>
  </div>
  <div class="card">
    <h3 class="rp-ctitle">📅 Orders by weekday</h3>
    <div class="rp-csub">Last 30 days</div>
    <div class="rp-pad"><svg id="rpDow" viewBox="0 0 320 190" style="width:100%;height:190px;display:block"></svg></div>
  </div>
  <div class="card">
    <h3 class="rp-ctitle">⏰ Orders by hour</h3>
    <div class="rp-csub">Last 30 days (Pakistan time)</div>
    <div class="rp-pad"><svg id="rpHour" viewBox="0 0 320 190" style="width:100%;height:190px;display:block"></svg></div>
  </div>
</div>

<div class="rp-cols">
  <div class="card">
    <h3 class="rp-ctitle">📈 Cumulative revenue</h3>
    <div class="rp-csub">Running total, last 30 days</div>
    <div class="rp-pad"><svg id="rpCum" viewBox="0 0 520 220" preserveAspectRatio="none" style="width:100%;height:220px;display:block"></svg></div>
  </div>
  <div class="card">
    <h3 class="rp-ctitle">🎯 Order funnel</h3>
    <div class="rp-csub">Last 30 days — placed → paid → delivered</div>
    <div class="rp-pad"><svg id="rpFun" viewBox="0 0 520 210" style="width:100%;height:210px;display:block"></svg></div>
  </div>
</div>

<script>
window.RP = <%- JSON.stringify({ heat:heat, pay:pay, mix:mix, fun:fun, cum:cum }).replace(/</g,'\\u003c') %>;
(function(){
  var NS='http://www.w3.org/2000/svg';
  var PAL=['#2a7bff','#29d3ff','#9a6cff','#16b765','#e0a93f','#ff6cc4','#2fe0c0','#e0453f'];
  function el(n,a,t){ var e=document.createElementNS(NS,n); for(var k in a) e.setAttribute(k,a[k]); if(t!=null){ e.textContent=t; } return e; }
  function money(n){ return 'Rs '+Number(n||0).toLocaleString('en-US'); }
  var DOWS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  /* ---------- business graph (range-switchable) ---------- */
  (function(){
    var metric='rev', range='14d', data=[];
    var svg=document.getElementById('rpChart');
    function fmtDate(iso){ var d=new Date(iso+'T00:00:00'); return d.toLocaleDateString('en-GB',{day:'numeric',month:'short'}); }
    function draw(){
      svg.innerHTML=''; var empty=document.getElementById('rpEmpty');
      if(!data.length){ empty.style.display=''; return; } empty.style.display='none';
      var W=800,H=260,pL=54,pR=14,pT=16,pB=30;
      var vals=data.map(function(r){ return Number(metric==='rev'?r.rev:r.orders); });
      var max=Math.max.apply(null,vals.concat([1])); var mag=Math.pow(10,Math.floor(Math.log10(max))); max=Math.ceil(max/mag)*mag;
      var n=data.length, iw=W-pL-pR, ih=H-pT-pB;
      var xAt=function(i){ return pL+(n<=1?iw/2:(i*iw/(n-1))); }; var yAt=function(v){ return pT+ih-(v/max)*ih; };
      for(var g=0;g<=4;g++){ var gy=pT+ih-(g/4)*ih; svg.appendChild(el('line',{x1:pL,y1:gy,x2:W-pR,y2:gy,stroke:'#eef1f8','stroke-width':1}));
        svg.appendChild(el('text',{x:pL-8,y:gy+4,'text-anchor':'end','font-size':11,fill:'#9aa3bd'}, metric==='rev'?('Rs '+Math.round(max*g/4).toLocaleString('en-US')):String(Math.round(max*g/4)))); }
      var dLine=''; data.forEach(function(r,i){ dLine+=(i?'L':'M')+xAt(i).toFixed(1)+' '+yAt(vals[i]).toFixed(1)+' '; });
      var dArea=dLine+'L'+xAt(n-1).toFixed(1)+' '+(pT+ih)+' L'+xAt(0).toFixed(1)+' '+(pT+ih)+' Z';
      var grad=el('linearGradient',{id:'rpg',x1:0,y1:0,x2:0,y2:1}); grad.appendChild(el('stop',{offset:'0%','stop-color':'#2a7bff','stop-opacity':.22})); grad.appendChild(el('stop',{offset:'100%','stop-color':'#2a7bff','stop-opacity':0}));
      var defs=el('defs',{}); defs.appendChild(grad); svg.appendChild(defs);
      svg.appendChild(el('path',{d:dArea,fill:'url(#rpg)'}));
      svg.appendChild(el('path',{d:dLine,fill:'none',stroke:'#2a7bff','stroke-width':2.4,'stroke-linejoin':'round','stroke-linecap':'round'}));
      var step=Math.max(1,Math.ceil(n/6));
      for(var i=0;i<n;i+=step){ svg.appendChild(el('text',{x:xAt(i),y:H-8,'text-anchor':'middle','font-size':11,fill:'#9aa3bd'}, fmtDate(data[i].d))); }
      if(n){ svg.appendChild(el('circle',{cx:xAt(n-1),cy:yAt(vals[n-1]),r:3.5,fill:'#2a7bff'})); }
    }
    function load(){ fetch('/admin/reports/series.json?range='+range,{credentials:'include'}).then(function(r){return r.json();}).then(function(j){ data=(j&&j.series)||[]; draw(); }).catch(function(){ data=[]; draw(); }); }
    window.rpMetric=function(b){ [].slice.call(b.parentElement.children).forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); metric=b.getAttribute('data-metric'); document.getElementById('rpTitle').textContent=metric==='rev'?'Revenue':'Orders'; draw(); };
    window.rpRange=function(b){ [].slice.call(document.querySelectorAll('#rpRanges button')).forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); range=b.getAttribute('data-range'); load(); };
    load();
  })();

  /* ---------- donut helper ---------- */
  function donut(svg, segs, legId, fmt){
    svg.innerHTML=''; var total=segs.reduce(function(a,b){return a+Number(b.value||0);},0);
    var vb=svg.getAttribute('viewBox').split(' ').map(Number), W=vb[2], H=vb[3];
    var cx=W/2, cy=H/2, r=Math.min(W,H)/2-8, ir=r*0.58;
    if(total<=0){ svg.appendChild(el('text',{x:cx,y:cy,'text-anchor':'middle','font-size':13,fill:'#9aa3bd'},'No data yet')); if(legId) document.getElementById(legId).innerHTML=''; return; }
    var ang=-Math.PI/2;
    segs.forEach(function(sg,i){ var frac=Number(sg.value||0)/total; if(frac<=0) return; var a2=ang+frac*2*Math.PI;
      var x1=cx+r*Math.cos(ang), y1=cy+r*Math.sin(ang), x2=cx+r*Math.cos(a2), y2=cy+r*Math.sin(a2);
      var xi2=cx+ir*Math.cos(a2), yi2=cy+ir*Math.sin(a2), xi1=cx+ir*Math.cos(ang), yi1=cy+ir*Math.sin(ang);
      var large=(a2-ang)>Math.PI?1:0;
      var d='M'+x1+' '+y1+' A'+r+' '+r+' 0 '+large+' 1 '+x2+' '+y2+' L'+xi2+' '+yi2+' A'+ir+' '+ir+' 0 '+large+' 0 '+xi1+' '+yi1+' Z';
      svg.appendChild(el('path',{d:d,fill:PAL[i%PAL.length]})); ang=a2; });
    svg.appendChild(el('text',{x:cx,y:cy-2,'text-anchor':'middle','font-size':17,'font-weight':800,fill:'#18213f'}, String(total.toLocaleString('en-US'))));
    svg.appendChild(el('text',{x:cx,y:cy+14,'text-anchor':'middle','font-size':11,fill:'#9aa3bd'},'orders'));
    if(legId){ var L=document.getElementById(legId); L.innerHTML=''; segs.forEach(function(sg,i){ if(!Number(sg.value)) return; var pc=Math.round(Number(sg.value)/total*100);
      var sp=document.createElement('span'); sp.className='rp-lg'; sp.innerHTML='<i style="background:'+PAL[i%PAL.length]+'"></i><b>'+sg.label+'</b> <small>'+(fmt?fmt(sg):(sg.value+' · '+pc+'%'))+'</small>'; L.appendChild(sp); }); }
  }

  /* ---------- vertical bars helper ---------- */
  function bars(svg, items, color){
    svg.innerHTML=''; var vb=svg.getAttribute('viewBox').split(' ').map(Number), W=vb[2], H=vb[3];
    var pL=30,pR=8,pT=12,pB=26, n=items.length, iw=W-pL-pR, ih=H-pT-pB;
    var max=Math.max.apply(null,items.map(function(x){return x.v;}).concat([1]));
    var bw=iw/n*0.64, gap=iw/n;
    for(var g=0;g<=3;g++){ var gy=pT+ih-(g/3)*ih; svg.appendChild(el('line',{x1:pL,y1:gy,x2:W-pR,y2:gy,stroke:'#eef1f8','stroke-width':1})); svg.appendChild(el('text',{x:pL-5,y:gy+3.5,'text-anchor':'end','font-size':9.5,fill:'#9aa3bd'},String(Math.round(max*g/3)))); }
    items.forEach(function(it,i){ var h=(it.v/max)*ih, x=pL+i*gap+(gap-bw)/2, y=pT+ih-h;
      svg.appendChild(el('rect',{x:x,y:y,width:bw,height:Math.max(h,0),rx:3,fill:color, opacity: it.hot?1:0.82}));
      if(it.label!=null) svg.appendChild(el('text',{x:x+bw/2,y:H-9,'text-anchor':'middle','font-size':9.5,fill:'#9aa3bd'}, it.label)); });
  }

  /* ---------- heatmap ---------- */
  (function(){
    var svg=document.getElementById('rpHeat'); var grid=[]; for(var d=0;d<7;d++){ grid.push([]); for(var h=0;h<24;h++) grid[d].push(0); }
    (RP.heat||[]).forEach(function(r){ var d=Number(r.dow), h=Number(r.hr); if(d>=0&&d<7&&h>=0&&h<24) grid[d][h]=Number(r.n)||0; });
    var max=1; grid.forEach(function(row){ row.forEach(function(v){ if(v>max)max=v; }); });
    var W=760,H=210, pL=42, pT=18, cw=(W-pL-6)/24, ch=(H-pT-18)/7;
    function col(v){ if(v<=0) return '#eef2fb'; var t=v/max; if(t<0.25)return '#bcd2ff'; if(t<0.5)return '#7aa6ff'; if(t<0.78)return '#2a7bff'; return '#163e8c'; }
    for(var d=0;d<7;d++){ svg.appendChild(el('text',{x:pL-8,y:pT+d*ch+ch/2+3.5,'text-anchor':'end','font-size':10.5,fill:'#6b7493'}, DOWS[d]));
      for(var h=0;h<24;h++){ var v=grid[d][h]; var rc=el('rect',{x:pL+h*cw+1,y:pT+d*ch+1,width:cw-2,height:ch-2,rx:2.5,fill:col(v)}); rc.appendChild(el('title',{}, DOWS[d]+' '+((h%12===0?12:h%12))+(h<12?'AM':'PM')+' · '+v+' orders')); svg.appendChild(rc); } }
    for(var h2=0;h2<24;h2+=3){ svg.appendChild(el('text',{x:pL+h2*cw+cw/2,y:H-5,'text-anchor':'middle','font-size':9.5,fill:'#9aa3bd'}, (h2%12===0?12:h2%12)+(h2<12?'a':'p'))); }
  })();

  /* ---------- payment methods donut ---------- */
  donut(document.getElementById('rpPay'), (RP.pay||[]).map(function(p){ return {label:p.name, value:Number(p.n)||0, rev:Number(p.rev)||0}; }), 'rpPayLeg', function(sg){ return money(sg.rev); });

  /* ---------- customer mix donut ---------- */
  donut(document.getElementById('rpMix'), [ {label:'Registered', value:Number(RP.mix&&RP.mix.registered)||0}, {label:'Guest', value:Number(RP.mix&&RP.mix.guest)||0} ], 'rpMixLeg', null);

  /* ---------- orders by weekday + by hour (from heatmap) ---------- */
  (function(){
    var byDow=[0,0,0,0,0,0,0], byHr=[]; for(var i=0;i<24;i++) byHr.push(0);
    (RP.heat||[]).forEach(function(r){ var d=Number(r.dow),h=Number(r.hr),n=Number(r.n)||0; if(d>=0&&d<7)byDow[d]+=n; if(h>=0&&h<24)byHr[h]+=n; });
    var dmax=Math.max.apply(null,byDow), hmax=Math.max.apply(null,byHr);
    bars(document.getElementById('rpDow'), byDow.map(function(v,i){ return {v:v,label:DOWS[i],hot:v===dmax&&v>0}; }), '#9a6cff');
    bars(document.getElementById('rpHour'), byHr.map(function(v,i){ return {v:v,label:(i%6===0?((i%12===0?12:i%12)+(i<12?'a':'p')):''),hot:v===hmax&&v>0}; }), '#29a3ff');
  })();

  /* ---------- cumulative revenue line ---------- */
  (function(){
    var svg=document.getElementById('rpCum'); var rows=RP.cum||[]; svg.innerHTML='';
    if(!rows.length){ svg.appendChild(el('text',{x:260,y:110,'text-anchor':'middle','font-size':13,fill:'#9aa3bd'},'No data yet')); return; }
    var W=520,H=220,pL=58,pR=14,pT=14,pB=28, run=0, pts=rows.map(function(r){ run+=Number(r.rev)||0; return {d:r.d, v:run}; });
    var max=Math.max.apply(null,pts.map(function(p){return p.v;}).concat([1])); var mag=Math.pow(10,Math.floor(Math.log10(max))); max=Math.ceil(max/mag)*mag;
    var n=pts.length, iw=W-pL-pR, ih=H-pT-pB; var xAt=function(i){return pL+(n<=1?iw/2:i*iw/(n-1));}, yAt=function(v){return pT+ih-(v/max)*ih;};
    for(var g=0;g<=4;g++){ var gy=pT+ih-(g/4)*ih; svg.appendChild(el('line',{x1:pL,y1:gy,x2:W-pR,y2:gy,stroke:'#eef1f8','stroke-width':1})); svg.appendChild(el('text',{x:pL-7,y:gy+3.5,'text-anchor':'end','font-size':10,fill:'#9aa3bd'},'Rs '+Math.round(max*g/4).toLocaleString('en-US'))); }
    var dLine=''; pts.forEach(function(p,i){ dLine+=(i?'L':'M')+xAt(i).toFixed(1)+' '+yAt(p.v).toFixed(1)+' '; });
    var dArea=dLine+'L'+xAt(n-1).toFixed(1)+' '+(pT+ih)+' L'+xAt(0).toFixed(1)+' '+(pT+ih)+' Z';
    var grad=el('linearGradient',{id:'rpc',x1:0,y1:0,x2:0,y2:1}); grad.appendChild(el('stop',{offset:'0%','stop-color':'#16b765','stop-opacity':.2})); grad.appendChild(el('stop',{offset:'100%','stop-color':'#16b765','stop-opacity':0}));
    var defs=el('defs',{}); defs.appendChild(grad); svg.appendChild(defs);
    svg.appendChild(el('path',{d:dArea,fill:'url(#rpc)'}));
    svg.appendChild(el('path',{d:dLine,fill:'none',stroke:'#16b765','stroke-width':2.4,'stroke-linejoin':'round'}));
    var step=Math.max(1,Math.ceil(n/6));
    for(var i=0;i<n;i+=step){ var dd=new Date(pts[i].d+'T00:00:00'); svg.appendChild(el('text',{x:xAt(i),y:H-8,'text-anchor':'middle','font-size':10,fill:'#9aa3bd'}, dd.toLocaleDateString('en-GB',{day:'numeric',month:'short'}))); }
    svg.appendChild(el('circle',{cx:xAt(n-1),cy:yAt(pts[n-1].v),r:3.5,fill:'#16b765'}));
  })();

  /* ---------- funnel ---------- */
  (function(){
    var svg=document.getElementById('rpFun'); var f=RP.fun||{placed:0,paid:0,delivered:0}; svg.innerHTML='';
    var stages=[{label:'Placed',v:Number(f.placed)||0,c:'#2a7bff'},{label:'Paid',v:Number(f.paid)||0,c:'#9a6cff'},{label:'Delivered',v:Number(f.delivered)||0,c:'#16b765'}];
    var W=520,H=210,pL=14,pR=14,pT=14, bw=W-pL-pR, bh=46, gap=16, max=Math.max(stages[0].v,1);
    stages.forEach(function(s,i){ var w=Math.max((s.v/max)*bw, s.v>0?70:46), x=pL+(bw-w)/2, y=pT+i*(bh+gap);
      svg.appendChild(el('rect',{x:x,y:y,width:w,height:bh,rx:10,fill:s.c}));
      svg.appendChild(el('text',{x:x+16,y:y+bh/2+5,'font-size':13,'font-weight':700,fill:'#fff'}, s.label));
      svg.appendChild(el('text',{x:x+w-14,y:y+bh/2+5,'text-anchor':'end','font-size':14,'font-weight':800,fill:'#fff'}, String(s.v.toLocaleString('en-US'))));
      if(i>0){ var prev=stages[i-1].v; var pc=prev>0?Math.round(s.v/prev*100):0; svg.appendChild(el('text',{x:W/2,y:y-4,'text-anchor':'middle','font-size':10.5,fill:'#9aa3bd'}, pc+'% of previous')); }
    });
  })();
})();
</script>
