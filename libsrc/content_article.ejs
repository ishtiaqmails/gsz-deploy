<%- include('partials/store_top') %>
<link rel="stylesheet" href="/static/css/content.css?v=1">
<div class="cs-prog" id="csProg"></div>
<section class="section" style="padding-top:0">
  <div class="wrap">
    <% var __notLive = post.status==='draft' || (post.status==='scheduled' && (!post.scheduled_at || new Date(post.scheduled_at) > new Date())); %>
    <% if (__notLive) { %><div style="margin:14px 0;padding:10px 16px;border-radius:12px;background:rgba(255,186,8,.12);border:1px solid rgba(255,186,8,.35);color:#ffd24d;font-weight:600;font-size:14px">Preview — this <%= post.status %> post is not visible to the public yet.</div><% } %>
    <div class="cs-head">
      <div class="cs-crumb"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/<%= prefix %>"><%= prefixTitle %></a></div>
      <span class="cs-eye"><span class="d"></span><%= typeLabel %></span>
      <h1 class="cs-title-h"><%= post.title %></h1>
      <div class="cs-meta-top">
        <span class="av"><%= (authorName||'G').trim().charAt(0).toUpperCase() %></span>
        <span><%= authorName %></span><span>·</span>
        <span><%= post.reading_time %> min read</span>
        <% if (updated) { %><span>·</span><span>Updated <%= updated %></span><% } %>
      </div>
      <% if (post.featured_image) { %><div class="cs-hero-img"><img src="<%= post.featured_image %>" alt="<%= post.title %>" onerror="var p=this.closest('.cs-hero-img'); if(p) p.style.display='none'"></div><% } %>
    </div>
    <div class="cs-layout">
      <article class="cs-article">
        <% if (tocHtml) { %><div class="cs-toc-mob"><%- tocHtml %></div><% } %>
        <%- bodyHtml %>
        <%- relatedHtml %>
      </article>
      <aside class="cs-side"><%- tocHtml %></aside>
    </div>
  </div>
</section>
<script>/*reading progress*/(function(){var p=document.getElementById('csProg'),a=document.querySelector('.cs-article');if(!p||!a)return;function u(){var h=a.offsetHeight-window.innerHeight,top=a.offsetTop;var d=h>0?((window.scrollY-top)/h):0;p.style.width=(Math.min(1,Math.max(0,d))*100)+'%';}window.addEventListener('scroll',u,{passive:true});window.addEventListener('resize',u);u();})();</script>
<%- include('partials/store_bottom') %>
