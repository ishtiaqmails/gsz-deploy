<% /* In-model Buy Now / Checkout — site-wide (included from app_nav, so it's on every page incl. product pages).
      Sheet on phones/tablets, pop-up on desktop. Reuses GET /account/tools/buy-info + /account/tools/pay-methods
      and the existing POST /checkout. Guest-friendly (collects email/WhatsApp when logged out). */
   var _gbwn = String((typeof settings!=='undefined'&&settings&&settings.wa_number)?settings.wa_number:(typeof waNumber!=='undefined'?waNumber:'')).replace(/[^0-9]/g,''); %>
<style>
  .gbuy{--gb-ink:#eef2fb;--gb-mut:#9aa6c0;--gb-p:#111a2e;--gb-p2:#0e1627;--gb-ln:rgba(255,255,255,.12);--gb-grad:linear-gradient(135deg,#2f7bff,#29d3ff)}
  .gbuy{position:fixed;inset:0;z-index:650;display:none}
  .gbuy.on{display:block}
  .gbuy-scrim{position:absolute;inset:0;background:rgba(3,6,14,.72);backdrop-filter:blur(4px)}
  .gbuy-card{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(520px,calc(100vw - 28px));max-height:min(90vh,780px);display:flex;flex-direction:column;background:#111a2e;border:1px solid rgba(255,255,255,.14);border-radius:20px;box-shadow:0 34px 90px -22px rgba(0,0,0,.85);overflow:hidden;color:var(--gb-ink)}
  @media(max-width:860px),(max-width:1366px) and (pointer:coarse){.gbuy-card{left:0;right:0;top:auto;bottom:0;transform:none;width:100vw;max-height:92vh;border-radius:20px 20px 0 0}}
  .gbuy-x{position:absolute;right:14px;top:14px;width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:#0e1627;color:#9aa6c0;font-size:16px;cursor:pointer;z-index:2}
  .gbuy-head{padding:20px 22px 12px}
  .gbuy-head h3{font-family:var(--display,inherit);font-weight:800;font-size:18px;margin:0}
  .gbuy-head p{color:var(--gb-mut);font-size:13px;margin:4px 0 0}
  .gbuy-body{padding:14px 22px 22px;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;border-top:1px solid rgba(255,255,255,.08)}
  .gbuy-f{margin-bottom:12px}
  .gbuy-f label{display:block;font-size:12.5px;color:var(--gb-mut);font-weight:600;margin-bottom:6px}
  .gbuy input[type=text],.gbuy input[type=email],.gbuy input[type=password],.gbuy input[type=tel],.gbuy input[type=number],.gbuy input[type=file],.gbuy select{width:100%;background:#0e1627;border:1px solid var(--gb-ln);border-radius:11px;color:var(--gb-ink);padding:11px 13px;font-family:inherit;font-size:14px}
  .gbuy input[type=file]{padding:6px}
  .gbuy input[type=file]::file-selector-button,.gbuy input[type=file]::-webkit-file-upload-button{padding:8px 12px;margin-right:10px;border:0;border-radius:8px;background:#16203a;color:var(--gb-ink);font-family:inherit;font-size:13px;font-weight:700;cursor:pointer}
  .gbuy .gb-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;cursor:pointer;font-weight:800;font-size:14px;padding:12px 16px;border-radius:12px;font-family:inherit}
  .gbuy .gb-p{background:var(--gb-grad);color:#fff} .gbuy .gb-g{background:#16203a;color:var(--gb-ink);border:1px solid var(--gb-ln)}
  .gbuy .gb-m{display:flex;align-items:center;gap:9px;padding:10px 12px;border:1px solid rgba(255,255,255,.1);border-radius:10px;margin-bottom:8px;cursor:pointer;font-size:13.5px}
  .gbuy .gb-m input{accent-color:#2f7bff}
  .gbuy .gb-mtiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .gbuy .gb-mtile{position:relative;display:flex;flex-direction:column;align-items:center;gap:7px;padding:13px 7px 11px;min-height:122px;border:1.5px solid var(--gb-ln);border-radius:13px;background:#0e1627;cursor:pointer;text-align:center;transition:border-color .12s,background .12s}
  .gbuy .gb-mtile.sel{border-color:#2f7bff;background:rgba(47,123,255,.12)}
  .gbuy .gb-mlogo{width:40px;height:40px;border-radius:10px;object-fit:contain;background:#fff;padding:3px;flex:none}
  .gbuy .gb-mmono{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;background:linear-gradient(135deg,#2f7bff,#29d3ff);color:#fff;flex:none}
  .gbuy .gb-mname{font-size:11px;font-weight:700;line-height:1.25;letter-spacing:.2px;color:var(--gb-ink)}
  .gbuy .gb-mpay{font-size:12px;color:#29d3ff;font-weight:800;margin-top:auto;padding-top:3px}
  .gbuy .muted{color:var(--gb-mut);font-size:12.5px} .gbuy .errmsg{color:#f0554e}
  .gbuy .gb-acct pre{margin:0;white-space:pre-wrap;background:#0e1627;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px;font-size:13px}
  .gbuy-load{text-align:center;color:var(--gb-mut);padding:26px}
  .gbuy-sum{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#0e1627;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:12px;margin-bottom:14px}
  .gbuy-sum b{font-size:14px} .gbuy-sum .pr{font-weight:800;color:#29d3ff}
  .gbuy-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
  .gbuy-chip{padding:7px 13px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:#0e1627;color:var(--gb-mut);font-weight:700;font-size:12.5px;cursor:pointer}
  .gbuy-chip.on{background:var(--gb-grad);color:#fff;border-color:transparent}
  .gbuy-now{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-bottom:10px;padding:13px 18px;border:0;border-radius:13px;cursor:pointer;font-family:inherit;font-weight:800;font-size:15px;background:linear-gradient(135deg,#2f7bff,#29d3ff);color:#fff;box-shadow:0 12px 26px -12px rgba(41,211,255,.7)}
  .gbuy-now svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}
</style>

<div class="gbuy" id="gbuy" aria-hidden="true">
  <div class="gbuy-scrim" data-gbclose></div>
  <div class="gbuy-card" role="dialog" aria-modal="true" aria-label="Checkout">
    <button class="gbuy-x" data-gbclose aria-label="Close">✕</button>
    <div class="gbuy-head"><h3 id="gbuyTitle">Checkout</h3><p id="gbuySub">Pay securely — no page change.</p></div>
    <div class="gbuy-body" id="gbuyBody"><div class="gbuy-load">Loading…</div></div>
  </div>
</div>
<script>
(function(){
  var modal=document.getElementById('gbuy'); if(!modal) return;
  var body=document.getElementById('gbuyBody'), ttl=document.getElementById('gbuyTitle'), sub=document.getElementById('gbuySub');
  var WANUM=<%- JSON.stringify(_gbwn) %>;
  function esc(s){var d=document.createElement('div');d.textContent=(s==null?'':String(s));return d.innerHTML;}
  function money(n){ return 'Rs '+Math.round(Number(n||0)).toLocaleString('en-US'); }
  function isIn(){ return (typeof window.__GSZAUTH!=='undefined')?!!window.__GSZAUTH:false; }
  window.__gszScrollLock = window.__gszScrollLock || (function(){ var n=0,y=0; return {
    lock:function(){ if(n++>0) return; y=window.scrollY||window.pageYOffset||0; var b=document.body; b.style.position='fixed'; b.style.top=(-y)+'px'; b.style.left='0'; b.style.right='0'; b.style.width='100%'; b.style.overflow='hidden'; },
    unlock:function(){ if(n>0)n--; if(n>0) return; var b=document.body; b.style.position=''; b.style.top=''; b.style.left=''; b.style.right=''; b.style.width=''; b.style.overflow=''; window.scrollTo(0,y); } }; })();
  function open(){ modal.classList.add('on'); window.__gszScrollLock.lock(); }
  function close(){ modal.classList.remove('on'); window.__gszScrollLock.unlock(); }
  modal.querySelectorAll('[data-gbclose]').forEach(function(x){ x.addEventListener('click',close); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape' && modal.classList.contains('on')) close(); });

  var INFO=null, CHOSEN={ type:'' };
  window.__gszBuy=function(opts){ opts=opts||{}; if(!opts.slug){ return; } open(); body.innerHTML='<div class="gbuy-load">Loading…</div>'; ttl.textContent='Checkout'; sub.textContent='Pay securely — no page change.';
    fetch('/account/tools/buy-info?slug='+encodeURIComponent(opts.slug)+'&plan='+encodeURIComponent(opts.planIdx!=null?opts.planIdx:0),{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      if(!j||!j.ok){ body.innerHTML='<div class="gbuy-load errmsg">'+esc((j&&j.error)||'Couldn’t load this product.')+'</div>'; return; }
      if(!j.available){ body.innerHTML='<div class="gbuy-load">This plan is currently out of stock. Please try another plan or <a href="https://wa.me/'+WANUM+'" style="color:#29d3ff">message us</a>.</div>'; return; }
      INFO=j; CHOSEN={ type:(j.typeOptions&&j.typeOptions.length?j.typeOptions[0].key:'') };
      form();
    }).catch(function(){ body.innerHTML='<div class="gbuy-load errmsg">Couldn’t load right now.</div>'; });
  };

  function form(){
    var j=INFO;
    ttl.textContent=j.name; sub.textContent=j.planLabel+' · '+money(j.price_pkr);
    var h='<div class="gbuy-sum"><div><b>'+esc(j.name)+'</b><div class="muted">'+esc(j.planLabel)+'</div></div><div class="pr">'+money(j.price_pkr)+'</div></div>';
    if(j.typeOptions && j.typeOptions.length>1){ h+='<div class="gbuy-f"><label>Choose type</label><div class="gbuy-chips" id="gbTypes">'+j.typeOptions.map(function(t,i){ return '<button type="button" class="gbuy-chip'+(i===0?' on':'')+'" data-type="'+esc(t.key)+'">'+esc(t.label)+'</button>'; }).join('')+'</div></div>'; }
    if(!isIn()){
      h+='<div class="gbuy-f"><label>Email</label><input type="email" id="gbEmail" placeholder="you@email.com"></div>'
       +'<div class="gbuy-f"><label>WhatsApp number</label><input type="text" id="gbWa" placeholder="03xx… (add +code if outside Pakistan)"></div>';
    }
    (j.needFields||[]).forEach(function(f){
      if(f==='mac') h+='<div class="gbuy-f"><label>Device MAC address</label><input type="text" id="gbMac" placeholder="AA:BB:CC:DD:EE:FF"></div>';
      if(f==='link') h+='<div class="gbuy-f"><label>Target link</label><input type="text" id="gbLink" placeholder="https://…"></div>';
      if(f==='qty') h+='<div class="gbuy-f"><label>Quantity</label><input type="text" id="gbQty" placeholder="e.g. 100"></div>';
    });
    if(j.wantsActEmail){ var _ael=(j.deliveryType==='vendor_invite')?'Email to receive your invite':(j.deliveryType==='portal')?'Email for your account login':(j.deliveryType==='amember')?'Email for your account access':'Email for activation'; h+='<div class="gbuy-f"><label>'+_ael+'</label><input type="email" id="gbActEmail" placeholder="you@email.com"></div>'; }
    h+='<div class="gbuy-f"><label>Payment method</label><div id="gbMethods"><div class="muted">Loading payment options…</div></div></div>'
     +'<div id="gbAcct"></div>'
     +'<div class="gbuy-f"><label>Coupon code <span class="muted">(optional)</span></label><input type="text" id="gbCoupon" style="text-transform:uppercase"></div>'
     +'<div class="gbuy-f"><label>Upload payment receipt</label><input type="file" id="gbProof" accept="image/*,application/pdf"></div>'
     +'<div id="gbOut"></div><button class="gb-btn gb-p" style="width:100%" id="gbGo">Place Order</button>'
     +'<p class="muted" style="text-align:center;margin:10px 0 0">You pay first, then we verify &amp; deliver. Need help? <a href="https://wa.me/'+WANUM+'" target="_blank" rel="noopener" style="color:#29d3ff">WhatsApp us</a>.</p>';
    body.innerHTML=h;
    var tp=document.getElementById('gbTypes'); if(tp) tp.querySelectorAll('[data-type]').forEach(function(b){ b.addEventListener('click',function(){ tp.querySelectorAll('[data-type]').forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); CHOSEN.type=b.getAttribute('data-type'); }); });
    loadPayAmt(INFO.price_pkr);
    document.getElementById('gbGo').addEventListener('click',submit);
  }

  var METHODS=[], CURAMT=0;
  function loadPayAmt(amount){ CURAMT=Number(amount)||0;
    fetch('/account/tools/pay-methods?amount='+encodeURIComponent(CURAMT),{headers:{'X-Requested-With':'fetch'},credentials:'same-origin',cache:'no-store'}).then(function(r){return r.json();}).then(function(j){
      METHODS=(j&&j.methods)||[]; var box=document.getElementById('gbMethods'); if(!box) return;
      if(!METHODS.length){ box.innerHTML='<div class="muted errmsg">No payment methods available — please contact support.</div>'; return; }
      box.innerHTML='<div class="gb-mtiles">'+METHODS.map(function(m,i){ var lg=m.logo?('<img class="gb-mlogo" src="/static/img/'+esc(m.logo)+'" alt="">'):('<span class="gb-mmono">'+esc((m.name||'?').charAt(0).toUpperCase())+'</span>'); return '<label class="gb-mtile'+(i===0?' sel':'')+'"><input type="radio" name="gbm" value="'+esc(m.key)+'"'+(i===0?' checked':'')+' style="position:absolute;opacity:0;width:0;height:0">'+lg+'<span class="gb-mname">'+esc(m.name)+'</span><span class="gb-mpay">'+esc(m.pay||'')+'</span></label>'; }).join('')+'</div>';
      box.querySelectorAll('input[name=gbm]').forEach(function(r){ r.addEventListener('change',function(){ box.querySelectorAll('.gb-mtile').forEach(function(t){t.classList.remove('sel');}); var t=r.closest('.gb-mtile'); if(t) t.classList.add('sel'); acct(); }); });
      acct();
    }).catch(function(){ var box=document.getElementById('gbMethods'); if(box) box.innerHTML='<div class="muted errmsg">Couldn’t load payment options.</div>'; });
  }
  function acct(){ var k=(body.querySelector('input[name=gbm]:checked')||{}).value; var m=METHODS.filter(function(x){return x.key===k;})[0]; var box=document.getElementById('gbAcct'); if(!box) return; if(!m||!(m.title||m.account||m.details)){ box.innerHTML=''; return; } var lines=m.details||((m.title?('Title: '+m.title):'')+(m.account?('\nAccount: '+m.account):'')); var cpVal=m.account||lines;
    box.innerHTML='<div class="gbuy-f gb-acct"><div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:4px"><span class="muted">Send '+esc(m.pay||money(CURAMT))+' to:</span><button type="button" class="gb-btn gb-g gb-copy" style="padding:5px 12px;font-size:12px">Copy '+(m.account?'number':'details')+'</button></div><pre>'+esc(lines)+'</pre>'+(m.instructions?('<div class="muted" style="margin-top:6px">'+esc(m.instructions)+'</div>'):'')+'</div>';
    var cpb=box.querySelector('.gb-copy'); if(cpb) cpb.addEventListener('click',function(){ try{ navigator.clipboard.writeText(cpVal); cpb.textContent='Copied ✓'; setTimeout(function(){ cpb.textContent='Copy '+(m.account?'number':'details'); },1400); }catch(e){} }); }

  function val(id){ var e=document.getElementById(id); return e?String(e.value||'').trim():''; }
  function submit(){
    var out=document.getElementById('gbOut'), go=document.getElementById('gbGo');
    function err(m){ out.innerHTML='<div class="muted errmsg" style="margin:0 0 10px">'+esc(m)+'</div>'; }
    var method=(body.querySelector('input[name=gbm]:checked')||{}).value;
    var pf=(document.getElementById('gbProof')||{}).files; pf=pf&&pf[0];
    if(!isIn()){ var em=val('gbEmail'), wa=val('gbWa'); if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)){ err('Enter a valid email.'); return; } if(wa.replace(/[^0-9]/g,'').length<8){ err('Enter a valid WhatsApp number.'); return; } }
    if(INFO.wantsActEmail && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val('gbActEmail'))){ err('Enter the email for this product.'); return; }
    if((INFO.needFields||[]).indexOf('mac')>=0 && val('gbMac').replace(/[^0-9a-zA-Z]/g,'').length<12){ err('Enter the device MAC address.'); return; }
    if((INFO.needFields||[]).indexOf('link')>=0 && !val('gbLink')){ err('Enter the target link.'); return; }
    if((INFO.needFields||[]).indexOf('qty')>=0 && !/^[0-9]+$/.test(val('gbQty'))){ err('Enter a valid quantity.'); return; }
    if(!method){ err('Choose a payment method.'); return; }
    if(!pf){ err('Please upload your payment receipt.'); return; }
    var fd=new FormData();
    fd.append('product',INFO.slug); fd.append('plan',INFO.planIdx); fd.append('region','PK'); fd.append('method',method);
    if(CHOSEN.type) fd.append('type',CHOSEN.type);
    var coupon=val('gbCoupon'); if(coupon) fd.append('coupon',coupon);
    if(!isIn()){ fd.append('email',val('gbEmail')); fd.append('whatsapp',val('gbWa')); }
    if((INFO.needFields||[]).indexOf('mac')>=0) fd.append('mac',val('gbMac'));
    if((INFO.needFields||[]).indexOf('link')>=0) fd.append('link',val('gbLink'));
    if((INFO.needFields||[]).indexOf('qty')>=0) fd.append('qty',val('gbQty'));
    if(INFO.wantsActEmail) fd.append('act_email',val('gbActEmail'));
    fd.append('proof',pf);
    go.disabled=true; go.textContent='Placing order…'; out.innerHTML='';
    fetch('/checkout',{method:'POST',body:fd,credentials:'same-origin'}).then(function(r){
      var m=String(r.url||'').match(/\/order\/([^\/?#]+)/); var no=m?decodeURIComponent(m[1]):null;
      if(!no){ return r.text().then(function(t){ var em=(t.match(/Order error:\s*([^<]+)/)||[])[1]; err(em?em.trim():'Couldn’t place the order. Please check your details and try again.'); go.disabled=false; go.textContent='Place Order'; }); }
      body.innerHTML='<div class="gbuy-load"><div style="font-size:34px">✅</div><div style="font-weight:800;font-size:16px;color:#33d98a;margin-top:6px">Order placed</div><p class="muted">We’re verifying your payment — you’ll get your '+esc(INFO.name)+' shortly on WhatsApp &amp; email.</p><a class="gb-btn gb-p" style="margin-top:8px" href="/order/'+encodeURIComponent(no)+'">View order '+esc(no)+'</a></div>';
    }).catch(function(){ err('Couldn’t place the order right now. Please try again.'); go.disabled=false; go.textContent='Place Order'; });
  }

  // ---- CART: in-model multi-item checkout (hijacks the cart's Proceed to Checkout) ----
  var CARTCTX=null;
  window.__gszCartCheckout=function(){
    var items=(window.GSZCart && window.GSZCart.get && window.GSZCart.get())||[];
    if(!items.length){ return; }
    open(); ttl.textContent='Checkout'; sub.textContent='Your cart'; body.innerHTML='<div class="gbuy-load">Loading…</div>';
    Promise.all(items.map(function(it){ return fetch('/account/tools/buy-info?slug='+encodeURIComponent(it.slug)+'&plan='+encodeURIComponent(it.planIdx||0),{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).catch(function(){return null;}); })).then(function(infos){ cartForm(items, infos); }).catch(function(){ body.innerHTML='<div class="gbuy-load errmsg">Couldn’t load your cart.</div>'; });
  };
  function cartForm(items, infos){
    var total=0; items.forEach(function(it){ total += (Number(it.pricePkr)||0)*(Number(it.qty)||1); });
    var h='<div style="margin-bottom:6px">'+items.map(function(it){ return '<div class="gbuy-sum"><div><b>'+esc(it.name||it.slug)+'</b><div class="muted">'+esc(it.planLabel||'')+((Number(it.qty)||1)>1?(' × '+it.qty):'')+'</div></div><div class="pr">'+money((Number(it.pricePkr)||0)*(Number(it.qty)||1))+'</div></div>'; }).join('')+'</div>';
    items.forEach(function(it,i){ var inf=infos[i]||{}; var nf=inf.needFields||[]; var wae=!!inf.wantsActEmail; if(!nf.length && !wae) return;
      h+='<div class="gbuy-f"><label>'+esc(it.name||'Item')+' — details</label>';
      if(nf.indexOf('mac')>=0) h+='<input type="text" id="ci'+i+'mac" placeholder="Device MAC (AA:BB:CC:DD:EE:FF)" style="margin-bottom:6px">';
      if(nf.indexOf('link')>=0) h+='<input type="text" id="ci'+i+'link" placeholder="Target link (https://…)" style="margin-bottom:6px">';
      if(nf.indexOf('qty')>=0) h+='<input type="text" id="ci'+i+'qty" placeholder="Quantity" style="margin-bottom:6px">';
      if(wae) h+='<input type="email" id="ci'+i+'email" placeholder="'+((inf.deliveryType==='vendor_invite')?'Email to receive your invite':(inf.deliveryType==='portal')?'Email for your account login':'Email for your account access')+'">';
      h+='</div>';
    });
    if(!isIn()){ h+='<div class="gbuy-f"><label>Email</label><input type="email" id="gbEmail" placeholder="you@email.com"></div><div class="gbuy-f"><label>WhatsApp number</label><input type="text" id="gbWa" placeholder="03xx… (add +code if outside Pakistan)"></div>'; }
    h+='<div class="gbuy-f"><label>Payment method</label><div id="gbMethods"><div class="muted">Loading payment options…</div></div></div><div id="gbAcct"></div>'
     +'<div class="gbuy-f"><label>Coupon code <span class="muted">(optional)</span></label><input type="text" id="gbCoupon" style="text-transform:uppercase"></div>'
     +'<div class="gbuy-f"><label>Upload payment receipt</label><input type="file" id="gbProof" accept="image/*,application/pdf"></div>'
     +'<div id="gbOut"></div><button class="gb-btn gb-p" style="width:100%" id="gbGo">Place Order · '+money(total)+'</button>'
     +'<p class="muted" style="text-align:center;margin:10px 0 0">You pay first, then we verify &amp; deliver.</p>';
    sub.textContent=items.length+' item'+(items.length>1?'s':'')+' · '+money(total);
    body.innerHTML=h;
    CARTCTX={items:items, infos:infos, total:total};
    loadPayAmt(total);
    document.getElementById('gbGo').addEventListener('click',submitCart);
  }
  function submitCart(){
    var out=document.getElementById('gbOut'), go=document.getElementById('gbGo');
    function err(m){ out.innerHTML='<div class="muted errmsg" style="margin:0 0 10px">'+esc(m)+'</div>'; }
    var items=CARTCTX.items, infos=CARTCTX.infos;
    var method=(body.querySelector('input[name=gbm]:checked')||{}).value;
    var pf=(document.getElementById('gbProof')||{}).files; pf=pf&&pf[0];
    if(!isIn()){ var em=val('gbEmail'), wa=val('gbWa'); if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)){ err('Enter a valid email.'); return; } if(wa.replace(/[^0-9]/g,'').length<8){ err('Enter a valid WhatsApp number.'); return; } }
    for(var i=0;i<items.length;i++){ var nf=(infos[i]&&infos[i].needFields)||[]; var wae=!!(infos[i]&&infos[i].wantsActEmail); if(nf.indexOf('mac')>=0 && val('ci'+i+'mac').replace(/[^0-9a-zA-Z]/g,'').length<12){ err('Enter the MAC for "'+(items[i].name||'item')+'".'); return; } if(nf.indexOf('link')>=0 && !val('ci'+i+'link')){ err('Enter the link for "'+(items[i].name||'item')+'".'); return; } if(nf.indexOf('qty')>=0 && !/^[0-9]+$/.test(val('ci'+i+'qty'))){ err('Enter a valid quantity for "'+(items[i].name||'item')+'".'); return; } if(wae && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val('ci'+i+'email'))){ err('Enter the email for "'+(items[i].name||'item')+'".'); return; } }
    if(!method){ err('Choose a payment method.'); return; }
    if(!pf){ err('Please upload your payment receipt.'); return; }
    var cartJson=JSON.stringify(items.map(function(it){ return { slug:it.slug, planIdx:(Number(it.planIdx)||0), type:it.type||'', qty:(Number(it.qty)||1) }; }));
    var fd=new FormData(); fd.append('cart',cartJson); fd.append('region','PK'); fd.append('method',method);
    var coupon=val('gbCoupon'); if(coupon) fd.append('coupon',coupon);
    if(!isIn()){ fd.append('email',val('gbEmail')); fd.append('whatsapp',val('gbWa')); }
    items.forEach(function(it,i){ var nf=(infos[i]&&infos[i].needFields)||[]; if(nf.indexOf('mac')>=0) fd.append('li_'+i+'_mac',val('ci'+i+'mac')); if(nf.indexOf('link')>=0) fd.append('li_'+i+'_link',val('ci'+i+'link')); if(nf.indexOf('qty')>=0) fd.append('li_'+i+'_qty',val('ci'+i+'qty')); if(infos[i]&&infos[i].wantsActEmail) fd.append('li_'+i+'_email',val('ci'+i+'email')); });
    fd.append('proof',pf);
    go.disabled=true; go.textContent='Placing order…'; out.innerHTML='';
    fetch('/cart/place',{method:'POST',body:fd,credentials:'same-origin'}).then(function(r){
      var m=String(r.url||'').match(/\/order\/([^\/?#]+)/); var no=m?decodeURIComponent(m[1]):null;
      if(!no){ err('Couldn’t place the order. Please check your details and try again.'); go.disabled=false; go.textContent='Place Order'; return; }
      try{ if(window.GSZCart&&window.GSZCart.clear) window.GSZCart.clear(); }catch(e){}
      body.innerHTML='<div class="gbuy-load"><div style="font-size:34px">✅</div><div style="font-weight:800;font-size:16px;color:#33d98a;margin-top:6px">Order placed</div><p class="muted">We’re verifying your payment — you’ll get your items shortly on WhatsApp &amp; email.</p><a class="gb-btn gb-p" style="margin-top:8px" href="/order/'+encodeURIComponent(no)+'">View order '+esc(no)+'</a></div>';
    }).catch(function(){ err('Couldn’t place the order right now. Please try again.'); go.disabled=false; go.textContent='Place Order'; });
  }

  // ---- wire the product page "Buy now" to the in-model checkout (uses the selected plan pill) ----
  function openBuy(slug){ var pill=document.querySelector('.ppill.sel')||document.querySelector('.ppill'); var idx=pill?parseInt(pill.getAttribute('data-idx'),10):0; if(isNaN(idx))idx=0; window.__gszBuy({ slug: slug, planIdx: idx }); }
  function injectBuyNow(){
    if(!/^\/product\//.test(location.pathname||'')) return;
    var slugM=(location.pathname.match(/\/product\/([^\/?#]+)/)||[])[1]; if(!slugM) return; var slug=decodeURIComponent(slugM);
    // Prefer the page's own "Buy now" button so there's only ONE. Replace it (clone to drop its old
    // handler/href) and wire it to the in-model checkout.
    var native=document.getElementById('buyBtn');
    if(native){ if(native.getAttribute('data-gbwired')) return; var clone=native.cloneNode(true); clone.removeAttribute('onclick'); clone.removeAttribute('href'); clone.setAttribute('data-gbwired','1'); native.parentNode.replaceChild(clone, native); clone.addEventListener('click',function(e){ e.preventDefault(); openBuy(slug); }); return; }
    // Fallback: no native buy button -> add one next to Add to cart.
    var add=document.getElementById('addCartBtn'); if(!add || document.getElementById('gbBuyNow')) return;
    var btn=document.createElement('button'); btn.type='button'; btn.id='gbBuyNow'; btn.className='gbuy-now';
    btn.innerHTML='<svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg> Buy Now';
    add.parentNode.insertBefore(btn, add);
    btn.addEventListener('click',function(){ openBuy(slug); });
  }
  if(document.readyState!=='loading') injectBuyNow(); else document.addEventListener('DOMContentLoaded',injectBuyNow);

  // hijack the cart's "Proceed to checkout" -> in-model cart checkout
  document.addEventListener('click',function(e){ var go=e.target.closest?e.target.closest('.gszcart-go'):null; if(go){ e.preventDefault(); e.stopPropagation(); try{ if(window.GSZCart&&window.GSZCart.close) window.GSZCart.close(); }catch(x){} window.__gszCartCheckout(); } }, true);
})();
</script>
