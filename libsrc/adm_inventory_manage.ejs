<%- include('_shell_top', { active:'inventory', title:'Stock — '+plan.label }) %>
<style>
  .im-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}
  .im-top h2{margin:0;font-size:18px}
  .im-filters{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}
  .im-bulk{display:none;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;padding:13px 16px}
  .im-bulk.on{display:flex}
  .im-bulk .sp{flex:1}
  .im-bulk select{margin:0}
  table.imtbl{width:100%;border-collapse:collapse}
  table.imtbl th{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);text-align:left;padding:10px 14px;font-weight:700;border-bottom:1px solid var(--hair)}
  table.imtbl td{padding:12px 14px;border-top:1px solid var(--hair);font-size:13.5px;vertical-align:top}
  .im-cred{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;white-space:pre-wrap;line-height:1.5;color:var(--ink)}
  .im-pill{font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px}
  .im-pill.ok{background:#e7f8ef;color:#16935c}.im-pill.sold{background:#eef2fb;color:#49527a}
  .im-ledger{color:var(--muted);font-size:12px;margin-top:3px}
  .im-act{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap}
  .im-act .btn{padding:6px 10px}
  .im-lock{color:var(--muted);font-size:12.5px}
  .ivm-scrim{position:fixed;inset:0;background:rgba(18,22,40,.5);backdrop-filter:blur(2px);z-index:60;display:none;align-items:flex-start;justify-content:center;overflow:auto;padding:28px 14px}
  .ivm-scrim.on{display:flex}
  .ivm-card{background:#fff;border-radius:18px;width:100%;max-width:520px;box-shadow:0 24px 60px rgba(18,22,40,.25);padding:22px}
  .ivm-h{font-weight:800;font-size:18px;margin:0 0 14px}
  .ivm-col{margin-bottom:11px}.ivm-col label{display:block;font-weight:700;font-size:12.5px;margin:0 0 5px}
  .ivm-foot{display:flex;gap:10px;justify-content:flex-end;margin-top:16px}
  @media(max-width:760px){
    table.imtbl thead{display:none}
    table.imtbl tbody,table.imtbl tr,table.imtbl td{display:block;width:auto}
    table.imtbl tr{border-top:1px solid var(--hair);padding:12px 14px;position:relative}
    table.imtbl td{border:0;padding:3px 0}
    table.imtbl td.sel{position:absolute;top:12px;right:12px;padding:0}
    .im-act{justify-content:stretch;margin-top:9px}.im-act .btn{flex:1;justify-content:center}
  }
</style>
<% function money(n){ return 'Rs ' + Math.round(Number(n||0)).toLocaleString('en-US'); }
   var tot = counts.avail + counts.sold; %>

<div class="im-top">
  <a class="btn btn-g" href="/admin/inventory">← Back</a>
  <h2>📦 <%= plan.product_name %> · <%= plan.label %></h2>
</div>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

<div class="dcards c3">
  <div class="dcard" style="--t:#2a7bff"><span class="dic"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5"/></svg></span>
    <div class="dmeta"><span class="dlbl">Total stock</span><b class="dval"><%= tot %></b><span class="dsub"><%= money(tot*price) %></span></div></div>
  <div class="dcard" style="--t:#16b765"><span class="dic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></span>
    <div class="dmeta"><span class="dlbl">Available</span><b class="dval"><%= counts.avail %></b><span class="dsub"><%= money(counts.avail*price) %></span></div></div>
  <div class="dcard" style="--t:#9a6cff"><span class="dic"><svg viewBox="0 0 24 24"><path d="M9 11l3 3 8-8"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
    <div class="dmeta"><span class="dlbl">Sold</span><b class="dval"><%= counts.sold %></b><span class="dsub"><%= money(counts.sold*price) %></span></div></div>
</div>

<div class="im-filters">
  <a class="chip <%= filter==='all'?'on':'' %>" href="?f=all">All <span class="n"><%= tot %></span></a>
  <a class="chip <%= filter==='available'?'on':'' %>" href="?f=available">Available <span class="n"><%= counts.avail %></span></a>
  <a class="chip <%= filter==='sold'?'on':'' %>" href="?f=sold">Sold <span class="n"><%= counts.sold %></span></a>
  <div style="flex:1"></div>
  <% if (counts.avail) { %><button class="btn btn-g" style="color:#b42318" type="button" onclick="imClear()">Clear available</button><% } %>
</div>

<div class="card im-bulk" id="imBulk">
  <span id="imCnt">0 selected</span><b>Bulk</b>
  <div class="sp"></div>
  <% if (targets.length) { %>
  <select id="imMoveTo"><option value="">Move to…</option><% targets.forEach(function(t){ %><option value="<%= t.id %>"><%= t.label %></option><% }); %></select>
  <button class="btn btn-g" type="button" onclick="imMove()">Move</button>
  <% } %>
  <button class="btn btn-g" style="color:#b42318" type="button" onclick="imBulkDelete()">Delete selected</button>
</div>

<div class="card" style="padding:0;overflow:hidden">
  <table class="imtbl">
    <thead><tr>
      <th style="width:30px"><input type="checkbox" id="imAll" onclick="imToggleAll(this)"></th>
      <th style="width:34px">#</th><th>Credentials</th><th>Status</th><th>Sold to</th><th>Date</th><th></th>
    </tr></thead>
    <tbody>
    <% if (!items.length) { %>
      <tr><td colspan="7" style="padding:26px 16px;color:var(--muted)">No units<%= filter!=='all'?(' in “'+filter+'”'):'' %> yet.</td></tr>
    <% } %>
    <% items.forEach(function(it, idx){ var avail = it.status==='available'; var vals = (it.fields && typeof it.fields==='object' && !Array.isArray(it.fields)) ? it.fields : {}; %>
      <tr>
        <td class="sel"><% if (avail) { %><input type="checkbox" class="imChk" value="<%= it.id %>" onclick="imCount()"><% } %></td>
        <td><%= idx+1 %></td>
        <td><div class="im-cred"><%= it.payload %></div><% if (it.vendor || it.cost_pkr!=null) { %><div class="im-ledger"><%= it.vendor ? ('Vendor: '+it.vendor) : '' %><%= (it.vendor && it.cost_pkr!=null)?' · ':'' %><%= it.cost_pkr!=null ? ('Cost '+money(it.cost_pkr)) : '' %></div><% } %></td>
        <td><% if (avail) { %><span class="im-pill ok">Available</span><% } else { %><span class="im-pill sold">Sold</span><% } %></td>
        <td><%= avail ? '—' : ((it.o_whatsapp||it.o_email||it.order_no)||'—') %></td>
        <td><%= it.delivered_at ? String(it.delivered_at).slice(0,10) : '—' %></td>
        <td>
          <div class="im-act">
            <% if (avail) { %>
              <button class="btn btn-g" type="button" onclick='imEdit(<%= it.id %>, <%= JSON.stringify(vals).replace(/'/g,"&#39;") %>)'>Edit</button>
              <button class="btn btn-g" style="color:#b42318" type="button" onclick="imDelete(<%= it.id %>)">Delete</button>
            <% } else { %>
              <span class="im-lock">🔒 Locked</span>
            <% } %>
          </div>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
</div>

<!-- edit modal -->
<div class="ivm-scrim" id="imEditScrim">
  <form class="ivm-card" method="post" id="imEditForm">
    <div class="ivm-h">Edit unit</div>
    <input type="hidden" name="plan_id" value="<%= plan.id %>">
    <div id="imEditCols"></div>
    <div class="ivm-foot">
      <button class="btn btn-g" type="button" onclick="document.getElementById('imEditScrim').classList.remove('on')">Cancel</button>
      <button class="btn btn-p" type="submit">Save</button>
    </div>
  </form>
</div>

<script>
(function(){
  var PLAN=<%= plan.id %>; var FIELDS=<%- JSON.stringify(plan.fields||[]) %>;
  function esc(s){var d=document.createElement('div');d.textContent=(s==null?'':String(s));return d.innerHTML;}
  function post(action, pairs){ var f=document.createElement('form'); f.method='post'; f.action=action; pairs.forEach(function(p){ var i=document.createElement('input'); i.type='hidden'; i.name=p[0]; i.value=p[1]; f.appendChild(i); }); document.body.appendChild(f); f.submit(); }
  function checked(){ return [].slice.call(document.querySelectorAll('.imChk:checked')).map(function(c){return c.value;}); }

  window.imCount=function(){ var n=checked().length; document.getElementById('imCnt').textContent=n+' selected'; document.getElementById('imBulk').classList.toggle('on', n>0); };
  window.imToggleAll=function(cb){ [].slice.call(document.querySelectorAll('.imChk')).forEach(function(c){c.checked=cb.checked;}); imCount(); };
  window.imBulkDelete=function(){ var ids=checked(); if(!ids.length) return; if(!confirm('Delete '+ids.length+' selected unit(s)?')) return; post('/admin/inventory/bulk-delete', [['plan_id',PLAN]].concat(ids.map(function(id){return ['ids',id];}))); };
  window.imMove=function(){ var ids=checked(); var to=document.getElementById('imMoveTo').value; if(!ids.length||!to) return; post('/admin/inventory/move', [['plan_id',PLAN],['to_plan_id',to]].concat(ids.map(function(id){return ['ids',id];}))); };
  window.imDelete=function(id){ if(!confirm('Delete this unit?')) return; post('/admin/inventory/item/'+id+'/delete', [['plan_id',PLAN]]); };
  window.imClear=function(){ if(!confirm('Delete ALL available units for this plan? Sold units are kept.')) return; post('/admin/inventory/plan/'+PLAN+'/clear', []); };

  window.imEdit=function(id, vals){
    vals=vals||{};
    document.getElementById('imEditForm').action='/admin/inventory/item/'+id+'/edit';
    document.getElementById('imEditCols').innerHTML=FIELDS.map(function(f,i){
      var v=(vals[f]!=null?vals[f]:''); return '<div class="ivm-col"><label>'+esc(f)+'</label><input type="text" name="f'+i+'" value="'+esc(v)+'" style="width:100%"></div>';
    }).join('');
    document.getElementById('imEditScrim').classList.add('on');
  };
  [].slice.call(document.querySelectorAll('.ivm-scrim')).forEach(function(m){ m.addEventListener('click',function(e){ if(e.target===m) m.classList.remove('on'); }); });
})();
</script>
<%- include('_shell_bottom') %>
