<style>
  .gna,.gna-sheet,.gna-scrim,.gna-ticker{--gna-ink:#eef1ff;--gna-mut:#8b93b0;--gna-cyan:#28d6ff;--gna-ln:rgba(255,255,255,.09);--gna-grad:linear-gradient(100deg,#8b45ff,#3b82ff 55%,#28d6ff)}
  .gna{display:none}
  @media(max-width:860px){
    body{padding-bottom:calc(68px + env(safe-area-inset-bottom))}
    .gszcart-fab{display:none}
    #drawer{padding-bottom:calc(86px + env(safe-area-inset-bottom))}
    .gna{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:100;align-items:flex-end;justify-content:space-around;
      background:rgba(10,13,24,.82);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-top:1px solid var(--gna-ln);
      padding:7px 6px calc(7px + env(safe-area-inset-bottom));box-shadow:0 -10px 30px -20px rgba(0,0,0,.95)}
  }
  .gna-i{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:0;cursor:pointer;color:var(--gna-mut);font-family:inherit;font-size:10.5px;font-weight:600;text-decoration:none;padding:4px 2px;position:relative;-webkit-tap-highlight-color:transparent;transition:color .15s,transform .1s}
  .gna-i svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .gna-i.on{color:var(--gna-cyan)}
  .gna-i:active{transform:translateY(1px)}
  .gna-c{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;transform:translateY(-18px)}
  .gna-cbtn{width:54px;height:54px;border-radius:50%;background:var(--gna-grad);display:grid;place-items:center;border:0;cursor:pointer;color:#fff;box-shadow:0 12px 26px -8px rgba(59,130,255,.75),0 0 0 5px rgba(10,13,24,.92);transition:transform .12s}
  .gna-cbtn:active{transform:scale(.95)}
  .gna-cbtn svg{width:25px;height:25px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .gna-clbl{font-size:10.5px;font-weight:700;color:var(--gna-ink);margin-top:4px}
  .gna-badge{position:absolute;top:0;right:calc(50% - 22px);min-width:16px;height:16px;border-radius:9px;background:#f0554e;color:#fff;font-size:10px;font-weight:800;align-items:center;justify-content:center;padding:0 4px;line-height:1;display:none}
  .gna-badge.show{display:flex}
  .gna-scrim{position:fixed;inset:0;background:rgba(3,6,14,.62);backdrop-filter:blur(3px);z-index:495;display:none}
  .gna-scrim.on{display:block}
  .gna-sheet{position:fixed;left:0;right:0;bottom:0;z-index:496;background:#0e1326;border-top:1px solid var(--gna-ln);border-radius:22px 22px 0 0;padding:12px 16px calc(20px + env(safe-area-inset-bottom));transform:translateY(100%);transition:transform .26s cubic-bezier(.22,1,.36,1);color:var(--gna-ink);max-height:82vh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
  .gna-sheet.on{transform:translateY(0)}
  .gna-grip{width:38px;height:4px;border-radius:3px;background:rgba(255,255,255,.18);margin:2px auto 12px}
  .gna-sheet h4{margin:0 0 4px;font-size:15px;font-weight:800;font-family:var(--display,inherit)}
  .gna-sheet .gna-sub{margin:0 0 14px;font-size:12.5px;color:var(--gna-mut)}
  /* quick-access tool grid */
  .gna-tgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .gna-tile{display:flex;align-items:center;gap:11px;padding:13px;border:1px solid var(--gna-ln);border-radius:14px;background:#111a2e;color:var(--gna-ink);text-decoration:none;cursor:pointer;font-family:inherit;text-align:left;transition:border-color .15s,transform .1s}
  .gna-tile:active{transform:translateY(1px)}
  .gna-tz{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;flex:none}
