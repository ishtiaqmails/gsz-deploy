<script>
(function(){
  var nav=document.querySelector('.gna'); if(!nav) return;
  window.__gszScrollLock = window.__gszScrollLock || (function(){ var n=0,y=0; return {
    lock:function(){ if(n++>0) return; y=window.scrollY||window.pageYOffset||0; var b=document.body; b.style.position='fixed'; b.style.top=(-y)+'px'; b.style.left='0'; b.style.right='0'; b.style.width='100%'; b.style.overflow='hidden'; },
    unlock:function(){ if(n>0)n--; if(n>0) return; var b=document.body; b.style.position=''; b.style.top=''; b.style.left=''; b.style.right=''; b.style.width=''; b.style.overflow=''; window.scrollTo(0,y); } }; })();
  var scrim=document.getElementById('gnaScrim');
  var tsheet=document.getElementById('gnaToolsSheet'), ssheet=document.getElementById('gnaStoreSheet');
  var openEl=null;
  function openSheet(el){ if(!el||!scrim) return; if(openEl===el) return; if(openEl){ openEl.classList.remove('on'); } else { window.__gszScrollLock.lock(); } openEl=el; scrim.classList.add('on'); requestAnimationFrame(function(){ el.classList.add('on'); }); }
  function closeSheet(){ if(!openEl) return; openEl.classList.remove('on'); scrim.classList.remove('on'); openEl=null; window.__gszScrollLock.unlock(); }
  if(scrim) scrim.addEventListener('click',closeSheet);
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeSheet(); });

  function tools(tab){ closeSheet(); if(typeof window.__gszTools==='function'){ window.__gszTools(tab||'purchases'); } else { location.href='/?tool='+encodeURIComponent(tab||'purchases'); } }
  // self-aware auth row inside the Hub sheet (Sign In + Create Account / Sign Out)
  function gnaSignOut(){ var b=document.getElementById('gnaSignOut'); if(b){ b.disabled=true; b.textContent='Signing out…'; } fetch('/logout',{method:'POST',credentials:'same-origin',headers:{'X-Requested-With':'fetch'}}).then(function(){ location.reload(); }).catch(function(){ var fm=document.createElement('form'); fm.method='POST'; fm.action='/logout'; document.body.appendChild(fm); fm.submit(); }); }
  function renderAuth(){ var a=document.getElementById('gnaAuth'); if(!a) return; var isIn=(typeof window.__GSZAUTH!=='undefined')?!!window.__GSZAUTH:false;
    if(isIn){ a.innerHTML='<button class="gna-abtn out" id="gnaSignOut"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>Sign Out</button>'; var so=document.getElementById('gnaSignOut'); if(so) so.addEventListener('click',gnaSignOut); }
    else { a.innerHTML='<button class="gna-abtn in" id="gnaSignIn"><svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5M15 12H3"/></svg>Sign In</button><a class="gna-abtn reg" href="/signup"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>Create Account</a>'; var si=document.getElementById('gnaSignIn'); if(si) si.addEventListener('click',function(){ location.href='/login?next='+encodeURIComponent(location.pathname||'/'); }); } }
  // center -> Quick Access sheet
  var tb=document.getElementById('gnaTools'); if(tb) tb.addEventListener('click',function(){ renderAuth(); openSheet(tsheet); });
  // store -> categories sheet
  var st=nav.querySelector('[data-nav=store]'); if(st) st.addEventListener('click',function(){ openSheet(ssheet); });
  // cart -> site drawer
  var cart=nav.querySelector('[data-nav=cart]'); if(cart) cart.addEventListener('click',function(){ var b=document.getElementById('gszCartBtn'); if(b){ b.click(); } else { location.href='/'; } });
  // support -> Hub support chooser (Live Chat + WhatsApp)
  var sup=nav.querySelector('[data-nav=support]'); if(sup) sup.addEventListener('click',function(){ tools('support'); });
  // tool tiles
  tsheet.querySelectorAll('.gna-tile[data-act]').forEach(function(t){ t.addEventListener('click',function(){
    var a=t.getAttribute('data-act');
    if(a==='store'){ openSheet(ssheet); return; }
    if(a==='currency'){ closeSheet(); var cb=document.getElementById('curBtn'); if(cb){ cb.click(); } else { location.href='/account'; } return; }
    tools(a);
  }); });
  ssheet.querySelectorAll('a').forEach(function(a){ a.addEventListener('click',closeSheet); });

  // active tab by path
  var p=location.pathname||'/';
  function mark(sel){ var el=nav.querySelector(sel); if(el) el.classList.add('on'); }
  if(p==='/'||p==='') mark('[data-nav=home]'); else if(/^\/category\//.test(p)) mark('[data-nav=store]');

  // cart badge mirror
  function syncCart(){ var b=document.getElementById('gnaCartN'); if(!b) return; var src=document.querySelector('.gszcart-badge'); var n=src?(parseInt((src.textContent||'0').replace(/[^0-9]/g,''),10)||0):0; if(n>0){ b.textContent=n>99?'99+':String(n); b.classList.add('show'); } else { b.classList.remove('show'); } }
  syncCart();
  try{ var cb=document.querySelector('.gszcart-badge'); if(cb){ new MutationObserver(syncCart).observe(cb,{childList:true,characterData:true,subtree:true}); } }catch(e){}
  document.addEventListener('click',function(){ setTimeout(syncCart,320); });

  // offers / announcement ticker — flashes global announcements above the bar (phones only)
  (function(){
    var tick=document.getElementById('gnaTicker'), msg=document.getElementById('gnaTmsg'); if(!tick||!msg) return;
    function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
    function line(a){ var t=esc(a.title||'').trim(), b=esc(a.body||'').trim(), code=String(a.coupon||'').trim();
      var h=''; if(t) h+='<b>'+t+'</b>'; if(t&&b) h+=' — '; if(b) h+=b; if(!h) h='New update available';
      if(code) h+='<span class="gna-tcode">'+esc(code)+'</span>'; return h; }
    fetch('/api/announcements',{credentials:'same-origin'}).then(function(r){ return r.ok?r.json():null; }).then(function(d){
      var items=(d&&d.items)||[]; if(!items.length) return;
      document.body.classList.add('gna-has-ticker');
      var i=0; msg.innerHTML=line(items[0]); msg.dataset.code=items[0].coupon||'';
      requestAnimationFrame(function(){ tick.classList.add('on'); });
      if(items.length>1){ setInterval(function(){ msg.classList.add('fade'); setTimeout(function(){ i=(i+1)%items.length; msg.innerHTML=line(items[i]); msg.dataset.code=items[i].coupon||''; msg.classList.remove('fade'); },260); }, 5000); }
      tick.addEventListener('click',function(){ var code=msg.dataset.code||''; if(code){ try{ navigator.clipboard.writeText(code); }catch(e){} var prev=msg.innerHTML; msg.classList.add('fade'); setTimeout(function(){ msg.innerHTML='<b>Copied '+esc(code)+'</b> — paste it at checkout'; msg.classList.remove('fade'); },260); setTimeout(function(){ msg.classList.add('fade'); setTimeout(function(){ msg.innerHTML=prev; msg.classList.remove('fade'); },260); },2200); } else if(typeof window.__gszTools==='function'){ window.__gszTools('purchases'); } });
    }).catch(function(){});
  })();
})();
</script>
