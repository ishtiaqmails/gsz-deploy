  .gna-tile b{font-size:13px;font-weight:700;display:block;line-height:1.15}
  .gna-tile small{font-size:10.5px;color:var(--gna-mut)}
  .gna-authrow{display:flex;gap:9px;margin-top:14px;padding-top:14px;border-top:1px solid var(--gna-ln)}
  .gna-authrow:empty{display:none}
  .gna-abtn{flex:1;min-width:0;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:12px 14px;border-radius:12px;font-weight:800;font-size:13.5px;cursor:pointer;border:0;font-family:inherit;text-decoration:none;white-space:nowrap}
  .gna-abtn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .gna-abtn.in{background:linear-gradient(135deg,#33d98a,#1fb457);color:#05240f}
  .gna-abtn.reg{background:#111a2e;color:var(--gna-ink);border:1px solid rgba(255,255,255,.18)}
  .gna-abtn.out{background:#111a2e;color:#ff8f8a;border:1px solid rgba(240,85,78,.4);max-width:280px;margin:0 auto}
  /* categories list */
  .gna-cat{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--gna-ln);border-radius:13px;margin-bottom:9px;color:var(--gna-ink);text-decoration:none;background:#111a2e;transition:border-color .15s}
  .gna-cat:active{border-color:rgba(40,214,255,.5)}
  .gna-ci{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:rgba(40,214,255,.12);color:var(--gna-cyan);flex:none}
  .gna-ci svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.85;stroke-linecap:round;stroke-linejoin:round}
  .gna-cat b{font-size:13.5px;font-weight:700;display:block}
  .gna-cat small{font-size:11.5px;color:var(--gna-mut)}
  .gna-ar{margin-left:auto;color:var(--gna-mut)}
  /* offers / announcement ticker — sits just above the bottom bar, phones only */
  .gna-ticker{display:none}
  @media(max-width:860px){
    .gna-ticker{position:fixed;left:0;right:0;bottom:calc(68px + env(safe-area-inset-bottom));z-index:99;
      align-items:center;gap:9px;padding:7px 14px;background:var(--gna-grad);color:#fff;cursor:pointer;
      font-family:inherit;box-shadow:0 -8px 22px -16px rgba(0,0,0,.9);transform:translateY(120%);transition:transform .3s cubic-bezier(.22,1,.36,1);-webkit-tap-highlight-color:transparent}
    .gna-ticker.on{display:flex;transform:translateY(0)}
    body.gna-has-ticker{padding-bottom:calc(104px + env(safe-area-inset-bottom))}
  }
  .gna-tpin{flex:none;display:grid;place-items:center;width:18px;height:18px;opacity:.95}
  .gna-tpin svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .gna-tmsg{flex:1;min-width:0;font-size:12px;font-weight:600;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:opacity .25s}
  .gna-tmsg.fade{opacity:0}
  .gna-tmsg b{font-weight:800}
  .gna-tmsg .gna-tcode{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:6px;background:rgba(255,255,255,.22);font-weight:800;letter-spacing:.4px}
</style>

