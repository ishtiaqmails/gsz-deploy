<% /* Customer Tools — Quick Access band + consolidated pop-up, self-contained, dark. Include on home.
      Backend: GET /account/tools/orders, POST /account/tools/claim, /account/order/:no/otp, /subscription. */
   var _wanum = String((typeof settings!=='undefined' && settings && settings.wa_number) ? settings.wa_number : (typeof waNumber!=='undefined'?waNumber:'')).replace(/[^0-9]/g,''); %>
<style>
  .cth{--p:#111a2e;--p2:#0e1627;--ph:#16203a;--ln:rgba(255,255,255,.08);--ln2:rgba(255,255,255,.14);--ink:#eef2fb;--ink2:#9aa6c0;--b:#2f7bff;--b2:#29d3ff;--grad:linear-gradient(135deg,#2f7bff,#29d3ff);--ok:#33d98a;--warn:#f4b64c;--bad:#f0554e;--pur:#9a6cff;--pink:#ff6cc4}
  .cth{max-width:1200px;margin:18px auto 0;padding:0 20px}
  .cth-band{background:linear-gradient(135deg,rgba(47,123,255,.13),rgba(41,211,255,.03));border:1px solid var(--ln2);border-radius:20px;padding:22px 24px}
  .cth-h{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap}
  .cth-kick{color:var(--b2);font-weight:800;font-size:11.5px;letter-spacing:.09em}
  .cth-h h2{font-family:var(--display,inherit);font-weight:800;font-size:20px;letter-spacing:-.01em;margin:3px 0 0;color:var(--ink)}
  .cth-sub{color:var(--ink2);font-size:12.5px;text-align:right;max-width:240px}
  .cth-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  @media(max-width:1060px){.cth-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:760px){.cth-grid{grid-template-columns:repeat(2,1fr)}.cth-sub{display:none}}
  @media(max-width:430px){.cth-grid{grid-template-columns:1fr}}
  .cth-tile{display:flex;align-items:center;gap:12px;padding:14px;border-radius:14px;background:var(--p);border:1px solid var(--ln);transition:.16s;cursor:pointer;text-align:left;color:var(--ink);text-decoration:none;font-family:inherit}
  .cth-tile:hover{border-color:rgba(47,123,255,.45);transform:translateY(-2px);box-shadow:0 10px 22px -14px rgba(0,0,0,.7)}
  .cth-tile .ci{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;flex:none}
  .cth-tile .ci svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.85;stroke-linecap:round;stroke-linejoin:round}
  .cth-tile .cx{min-width:0}
  .cth-tile .ctt{font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cth-tile .ctd{font-size:11.5px;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  /* modal */
  .cthm{position:fixed;inset:0;z-index:600;display:none}
  .cthm.on{display:block}
  .cthm-scrim{position:absolute;inset:0;background:rgba(3,6,14,.72);backdrop-filter:blur(4px)}
  .cthm-card{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,calc(100vw - 28px));max-height:min(88vh,760px);display:flex;flex-direction:column;background:#111a2e;border:1px solid rgba(255,255,255,.14);border-radius:20px;box-shadow:0 34px 90px -22px rgba(0,0,0,.85);overflow:hidden;color:#eef2fb}
  @media(max-width:560px){.cthm-card{left:0;right:0;top:auto;bottom:0;transform:none;width:100vw;max-height:92vh;border-radius:20px 20px 0 0}}
  .cthm-x{position:absolute;right:14px;top:14px;width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:#0e1627;color:#9aa6c0;font-size:16px;cursor:pointer;z-index:2}
  .cthm-head{padding:22px 22px 14px}
  .cthm-head h3{font-family:var(--display,inherit);font-weight:800;font-size:19px;margin:0 0 4px}
  .cthm-head p{color:#9aa6c0;font-size:13px;margin:0;max-width:92%}
  .cthm-tabs{display:flex;gap:8px;padding:0 22px 14px}
  .cthm-tab{flex:1;padding:9px 6px;border-radius:10px;border:1px solid rgba(255,255,255,.08);background:#0e1627;color:#9aa6c0;font-weight:700;font-size:12.5px;cursor:pointer;white-space:nowrap}
  .cthm-tab.on{background:linear-gradient(135deg,#2f7bff,#29d3ff);color:#fff;border-color:transparent}
  .cthm-body{padding:16px 22px 22px;overflow-y:auto;border-top:1px solid rgba(255,255,255,.08)}
  .cthm-row{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid rgba(255,255,255,.08);border-radius:12px;margin-bottom:10px}
  .cthm .onm{font-weight:700;font-size:14px} .cthm .osub{font-size:12px;color:#9aa6c0}
  .cthm-empty{color:#9aa6c0;text-align:center;padding:30px 10px}
  .cthm-pill{display:inline-block;font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px}
  .cthm-pill.ok{color:#33d98a;background:rgba(51,217,138,.14)} .cthm-pill.wait{color:#f4b64c;background:rgba(244,182,76,.15)} .cthm-pill.bad{color:#f0554e;background:rgba(240,85,78,.14)}
  .cthm-f{margin-bottom:12px}
  .cthm-f label{display:block;font-size:12.5px;color:#9aa6c0;font-weight:600;margin-bottom:6px}
  .cthm select,.cthm textarea{width:100%;background:#0e1627;border:1px solid rgba(255,255,255,.14);border-radius:11px;color:#eef2fb;padding:11px 13px;font-family:inherit;font-size:14px}
  .cthm textarea{min-height:92px;resize:vertical}
  .cthm .cbtn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;cursor:pointer;font-weight:700;font-size:13.5px;padding:10px 16px;border-radius:11px;text-decoration:none;font-family:inherit}
  .cthm .cbtn-p{background:linear-gradient(135deg,#2f7bff,#29d3ff);color:#fff} .cthm .cbtn-g{background:#16203a;color:#eef2fb;border:1px solid rgba(255,255,255,.14)}
  .cthm .codebox{font-family:ui-monospace,Menlo,monospace;font-size:21px;font-weight:800;letter-spacing:3px;background:#0e1627;border:1px solid rgba(255,255,255,.14);border-radius:12px;padding:12px 16px;text-align:center;color:#29d3ff}
  .cthm .muted{color:#9aa6c0;font-size:12.5px} .cthm .okmsg{color:#33d98a;font-weight:700} .cthm .errmsg{color:#f0554e}
  .cthm-load{text-align:center;color:#9aa6c0;padding:26px}
  .cthm-chips{display:flex;gap:8px;margin-bottom:12px}
  .cthm-chip{padding:6px 14px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:#0e1627;color:#9aa6c0;font-weight:700;font-size:12.5px;cursor:pointer}
  .cthm-chip.on{background:linear-gradient(135deg,#2f7bff,#29d3ff);color:#fff;border-color:transparent}
  .cthm-ord{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:13px;border:1px solid rgba(255,255,255,.08);border-radius:12px;margin-bottom:10px;background:#0e1627;color:#eef2fb;cursor:pointer;font-family:inherit}
  .cthm-ord:hover{border-color:rgba(47,123,255,.4)}
  .cthm-back{background:none;border:0;color:#29d3ff;font-weight:700;font-size:13px;cursor:pointer;padding:0 0 10px;font-family:inherit}
  .cthm-meta{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 14px}
  .cthm-meta .muted{font-size:11.5px} .cthm-meta>div>div{font-weight:600;font-size:13.5px;margin-top:2px}
  .cthm-cred{margin:0 0 14px}
  .cthm-acts{display:flex;gap:8px;flex-wrap:wrap}
  .cthm-acts .cbtn{flex:1;min-width:90px}
  .cthm .co-m{display:flex;align-items:center;gap:9px;padding:10px 12px;border:1px solid rgba(255,255,255,.1);border-radius:10px;margin-bottom:8px;cursor:pointer;font-size:13.5px}
  .cthm .co-m input{accent-color:#2f7bff}
  .cthm .co-acct{margin:0 0 12px}
  .cthm input[type=text],.cthm input[type=file]{width:100%;background:#0e1627;border:1px solid rgba(255,255,255,.14);border-radius:11px;color:#eef2fb;padding:10px 12px;font-family:inherit;font-size:14px}
  .cthm-note{color:#9aa6c0;font-size:13px;background:#0e1627;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:14px;margin-bottom:12px}
  .cthm-sep{font-size:11.5px;font-weight:800;letter-spacing:.07em;color:#9aa6c0;text-transform:uppercase;margin:18px 0 10px;padding-top:14px;border-top:1px solid rgba(255,255,255,.08)}
  .cthm-claim{border:1px solid rgba(255,255,255,.08);border-radius:13px;padding:13px;margin-bottom:10px;background:#0e1627}
  .cthm-resp{margin-top:9px;border-left:2px solid #2f7bff;padding:2px 0 2px 11px}
  .cthm-resp>div{font-size:13px;margin-top:2px}
  .cthm-cred2{margin-top:10px}
  .cthm-cred2 pre{margin:0;white-space:pre-wrap;word-break:break-word;background:#111a2e;border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px;font-size:13px}
  .cthm-shot{display:inline-block;margin-top:9px;color:#29d3ff;font-weight:700;font-size:12.5px;text-decoration:none}
</style>

<section class="cth">
  <div class="cth-band">
    <div class="cth-h">
      <div><div class="cth-kick">QUICK ACCESS</div><h2>Customer Tools</h2></div>
      <div class="cth-sub">Everything in one place — orders, codes, renewals, trials &amp; support. No page hopping.</div>
    </div>
    <div class="cth-grid">
      <a class="cth-tile" href="/account" data-tool="purchases"><span class="ci" style="color:#29d3ff;background:rgba(47,123,255,.15)"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg></span><span class="cx"><div class="ctt">My Orders</div><div class="ctd">Purchases &amp; status</div></span></a>
      <a class="cth-tile" href="/account" data-tool="purchases"><span class="ci" style="color:#9a6cff;background:rgba(154,108,255,.15)"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></span><span class="cx"><div class="ctt">My Subscriptions</div><div class="ctd">Active services</div></span></a>
      <a class="cth-tile" href="/account" data-tool="code"><span class="ci" style="color:#29d3ff;background:rgba(41,211,255,.14)"><svg viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.3-9.3"/><path d="m16 7 3 3"/><path d="m18 5 3 3"/></svg></span><span class="cx"><div class="ctt">Get Login Code</div><div class="ctd">Sign-in &amp; OTP codes</div></span></a>
      <a class="cth-tile" href="/account" data-tool="renew"><span class="ci" style="color:#33d98a;background:rgba(51,217,138,.14)"><svg viewBox="0 0 24 24"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></span><span class="cx"><div class="ctt">Renew Service</div><div class="ctd">Extend before expiry</div></span></a>
      <button class="cth-tile trial-open" type="button"><span class="ci" style="color:#f4b64c;background:rgba(244,182,76,.15)"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="m17 2-5 5-5-5"/></svg></span><span class="cx"><div class="ctt">Free IPTV Trials</div><div class="ctd">Claim on WhatsApp</div></span></button>
      <a class="cth-tile" href="/account" data-tool="claim"><span class="ci" style="color:#ff6cc4;background:rgba(255,108,196,.14)"><svg viewBox="0 0 24 24"><path d="m12 2 8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span><span class="cx"><div class="ctt">Claim / Replace</div><div class="ctd">Report or replace</div></span></a>
      <a class="cth-tile" href="/"><span class="ci" style="color:#2f7bff;background:rgba(47,123,255,.13)"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></span><span class="cx"><div class="ctt">Browse Store</div><div class="ctd">Find new services</div></span></a>
      <a class="cth-tile" href="https://wa.me/<%= _wanum %>" target="_blank" rel="noopener"><span class="ci" style="color:#25d366;background:rgba(37,211,102,.14)"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="cx"><div class="ctt">WhatsApp Support</div><div class="ctd">Chat with us 24/7</div></span></a>
    </div>
  </div>
</section>

<div class="cthm" id="cthm" aria-hidden="true">
  <div class="cthm-scrim" data-close></div>
  <div class="cthm-card" role="dialog" aria-modal="true">
    <button class="cthm-x" data-close aria-label="Close">✕</button>
    <div class="cthm-head"><h3>Customer Tools</h3><p>View credentials, fetch sign-in codes, renew &amp; claim replacements.</p></div>
    <div class="cthm-tabs">
      <button class="cthm-tab" data-tab="purchases">Purchases</button>
      <button class="cthm-tab" data-tab="code">Get Code</button>
      <button class="cthm-tab" data-tab="renew">Renew</button>
      <button class="cthm-tab" data-tab="claim">Claim</button>
    </div>
    <div class="cthm-body" id="cthmBody"><div class="cthm-load">Loading…</div></div>
  </div>
</div>
<script>
(function(){
  var modal=document.getElementById('cthm'); if(!modal) return;
  var body=document.getElementById('cthmBody');
  var tabs=modal.querySelectorAll('.cthm-tab');
  var cache=null, authed=true, ordFilter='all';
  var WANUM=<%- JSON.stringify(_wanum) %>;
  function esc(s){var d=document.createElement('div');d.textContent=(s==null?'':String(s));return d.innerHTML;}
  function money(n){ return 'Rs '+Math.round(Number(n||0)).toLocaleString('en-US'); }
  function open(tab){ modal.classList.add('on'); document.body.style.overflow='hidden'; setTab(tab||'purchases'); }
  function close(){ modal.classList.remove('on'); document.body.style.overflow=''; }
  function setTab(tab){ tabs.forEach(function(t){ t.classList.toggle('on', t.getAttribute('data-tab')===tab); }); render(tab); }
  function loadOrders(){ if(cache) return Promise.resolve(cache);
    return fetch('/account/tools/orders',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){ if(r.redirected && /\/login/.test(r.url)){ authed=false; return {orders:[]}; } return r.json(); }).then(function(j){ if(j&&j.auth===false) authed=false; cache=(j&&j.orders)||[]; return cache; }).catch(function(){ cache=[]; return []; }); }
  function pc(s){ s=String(s||'').toLowerCase(); if(s==='delivered'||s==='completed'||s==='done') return 'ok'; if(s==='failed'||s==='rejected'||s==='cancelled') return 'bad'; return 'wait'; }
  function signin(){ body.innerHTML='<div class="cthm-empty"><div style="font-size:30px">🔒</div><div style="font-weight:700;margin-top:6px">Sign in to use your tools</div><p class="muted">View orders, get codes, renew &amp; claim replacements.</p><a class="cbtn cbtn-p" style="margin-top:6px" href="/login">Sign in / Register</a></div>'; }
  function render(tab){ body.innerHTML='<div class="cthm-load">Loading…</div>'; loadOrders().then(function(o){ if(!authed){ signin(); return; } if(tab==='purchases') pur(o); else if(tab==='code') code(o); else if(tab==='renew') renew(o); else claim(o); }); }
  function fmtd(iso){ if(!iso) return '—'; try{ return new Date(iso).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}); }catch(e){ return '—'; } }
  function subPill(o){ var s=o.sub_status; if(s==='active') return '<span class="cthm-pill ok">Active</span>'; if(s==='expiring') return '<span class="cthm-pill wait">Expiring soon</span>'; if(s==='expired') return '<span class="cthm-pill bad">Expired</span>'; return '<span class="cthm-pill wait">'+esc((o.status||'Pending').charAt(0).toUpperCase()+(o.status||'Pending').slice(1))+'</span>'; }
  function pur(orders){
    if(!orders.length){ body.innerHTML='<div class="cthm-empty">No orders yet.<br><a href="/" style="color:#29d3ff;font-weight:600">Browse products →</a></div>'; return; }
    var f=ordFilter;
    var list=orders.filter(function(o){ if(f==='active') return o.sub_status==='active'||o.sub_status==='expiring'; if(f==='expired') return o.sub_status==='expired'; return true; });
    var chips='<div class="cthm-chips">'+['all','active','expired'].map(function(k){ return '<button class="cthm-chip'+(f===k?' on':'')+'" data-f="'+k+'">'+(k==='all'?'All':k==='active'?'Active':'Expired')+'</button>'; }).join('')+'</div>';
    var rows=list.length? list.map(function(o){
      return '<button class="cthm-ord" data-ord="'+esc(o.order_no)+'"><span style="flex:1;min-width:0"><span class="onm" style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(o.product_name||'Order')+'</span><span class="osub">'+esc(o.order_no)+' · '+fmtd(o.purchased)+(o.expiry?(' · exp '+fmtd(o.expiry)):'')+'</span></span>'+subPill(o)+'<svg viewBox="0 0 24 24" width="16" height="16" style="stroke:#9aa6c0;fill:none;stroke-width:2;flex:none"><path d="m9 18 6-6-6-6"/></svg></button>';
    }).join('') : '<div class="cthm-empty">No '+esc(f)+' orders.</div>';
    body.innerHTML=chips+rows;
    body.querySelectorAll('.cthm-chip').forEach(function(b){ b.addEventListener('click',function(){ ordFilter=b.getAttribute('data-f'); pur(cache); }); });
    body.querySelectorAll('.cthm-ord').forEach(function(b){ b.addEventListener('click',function(){ var o=cache.filter(function(x){return x.order_no===b.getAttribute('data-ord');})[0]; if(o) detail(o); }); });
  }
  function detail(o){
    var warr=o.under_warranty?('<span class="cthm-pill ok">Under warranty'+(o.warranty_days?(' · '+o.warranty_days+'d'):'')+'</span>'):(o.warranty_days?'<span class="cthm-pill bad">Warranty ended</span>':'');
    var dl=(o.days_left!=null)?('<span class="muted"> ('+(o.days_left>=0?(o.days_left+' days left'):(Math.abs(o.days_left)+' days ago'))+')</span>'):'';
    var cred=o.credentials?('<div class="cthm-cred"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><span class="muted">Your credentials</span><button class="cbtn cbtn-g" style="padding:5px 12px;font-size:12px" id="cpyCred">Copy</button></div><pre style="margin:0;white-space:pre-wrap;word-break:break-word;background:#0e1627;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px;font-size:13px">'+esc(o.credentials)+'</pre></div>'):'';
    body.innerHTML='<button class="cthm-back" id="dBack">← Back to orders</button>'
      +'<div style="margin:2px 0 14px"><div style="font-weight:800;font-size:16px">'+esc(o.product_name||'Order')+'</div><div class="muted">'+esc(o.plan_label||'')+'</div></div>'
      +'<div class="cthm-meta"><div><span class="muted">Order</span><div>'+esc(o.order_no)+'</div></div><div><span class="muted">Purchased</span><div>'+fmtd(o.purchased)+'</div></div><div><span class="muted">Expiry</span><div>'+(o.expiry?fmtd(o.expiry):'No expiry')+dl+'</div></div><div><span class="muted">Status</span><div style="display:flex;gap:6px;flex-wrap:wrap">'+subPill(o)+warr+'</div></div></div>'
      +cred
      +'<div class="cthm-acts"><button class="cbtn cbtn-g" data-go="code">Get Code</button><button class="cbtn cbtn-g" data-go="renew">Renew</button><button class="cbtn cbtn-p" data-go="claim">Claim / Replace</button></div>';
    document.getElementById('dBack').addEventListener('click',function(){ setTab('purchases'); });
    var cp=document.getElementById('cpyCred'); if(cp) cp.addEventListener('click',function(){ try{ navigator.clipboard.writeText(o.credentials); cp.textContent='Copied ✓'; setTimeout(function(){cp.textContent='Copy';},1500); }catch(e){} });
    body.querySelectorAll('[data-go]').forEach(function(b){ b.addEventListener('click',function(){ setTab(b.getAttribute('data-go')); }); });
  }
  function reasonMsg(j,act){ var r=(j&&j.reason)||'error'; if(r==='waiting') return 'No '+(act==='link'?'link':'code')+' yet — tap again in a moment.'; if(r==='limit') return 'You’ve reached the limit'+((j&&j.used&&j.limit)?(' ('+j.used+'/'+j.limit+')'):'')+'. Contact support.'; if(r==='not_supported') return 'Not available for this product yet.'; if(r==='not_owner') return 'We couldn’t match this to your account.'; if(r==='expired') return 'The window has closed — contact support.'; return 'Couldn’t complete right now.'; }
  function doAct(no,act,tries){
    var out=body.querySelector('.act-out[data-for="'+no+'"]'); if(!out) return;
    out.innerHTML='<div class="muted" style="margin:8px 0 2px">'+(tries>0?('Waiting for '+(act==='link'?'link':'code')+'…'):'Working…')+'</div>';
    var url=(act==='household')?('/account/tools/household/'+encodeURIComponent(no)):('/account/order/'+encodeURIComponent(no)+'/'+act);
    fetch(url,{method:'POST',headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      if(act==='household'){ out.innerHTML=(j&&j.ok)?'<div class="okmsg" style="margin:8px 0 2px">✅ Household Updated</div>':'<div class="muted errmsg" style="margin:8px 0 2px">'+esc(reasonMsg(j,act))+'</div>'; return; }
      if(j&&j.ok&&j.value){
        if(act==='link'||j.kind==='link'){ out.innerHTML='<div style="margin:8px 0 2px"><a class="cbtn cbtn-p" target="_blank" rel="noopener" href="'+esc(j.value)+'">Open Login Link</a></div>'; }
        else { out.innerHTML='<div class="codebox" style="margin:8px 0 6px">'+esc(j.value)+'</div><button class="cbtn cbtn-g" style="padding:6px 12px;font-size:12px" id="cpA">Copy code</button>'; var cb=out.querySelector('#cpA'); if(cb) cb.addEventListener('click',function(){ try{ navigator.clipboard.writeText(j.value); cb.textContent='Copied ✓'; }catch(e){} }); }
        return;
      }
      var rz=(j&&j.reason)||'error';
      if(rz==='waiting' && tries<6){ setTimeout(function(){ doAct(no,act,tries+1); },4000); return; }
      out.innerHTML='<div class="muted errmsg" style="margin:8px 0 2px">'+esc(reasonMsg(j,act))+'</div>';
    }).catch(function(){ out.innerHTML='<div class="muted errmsg" style="margin:8px 0 2px">Couldn’t fetch right now.</div>'; });
  }
  function code(){
    body.innerHTML='<div class="cthm-load">Loading…</div>';
    fetch('/account/tools/retrievable',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      var list=(j&&j.orders)||[];
      if(!list.length){ body.innerHTML='<div class="cthm-empty">No code/link actions needed.<br><span class="muted">These appear only for products that use a sign-in code, link or household update.</span></div>'; return; }
      body.innerHTML='<p class="muted" style="margin:0 0 12px">Instant access for your eligible products — one tap.</p>'+list.map(function(o){
        var btns='';
        if(o.caps.otp) btns+='<button class="cbtn cbtn-g" data-act="otp" data-no="'+esc(o.order_no)+'">Get Code'+(o.caps.otp.limit?(' · max '+o.caps.otp.limit):'')+'</button>';
        if(o.caps.link) btns+='<button class="cbtn cbtn-g" data-act="link" data-no="'+esc(o.order_no)+'">Get Link</button>';
        if(o.caps.household) btns+='<button class="cbtn cbtn-g" data-act="household" data-no="'+esc(o.order_no)+'">Update Household</button>';
        return '<div class="cthm-row" style="flex-direction:column;align-items:stretch;gap:10px"><div><div class="onm">'+esc(o.product_name||'Order')+'</div><div class="osub">'+esc(o.order_no)+(o.plan_label?(' · '+esc(o.plan_label)):'')+'</div></div><div class="cthm-acts">'+btns+'</div><div class="act-out" data-for="'+esc(o.order_no)+'"></div></div>';
      }).join('');
      body.querySelectorAll('button[data-act]').forEach(function(b){ b.addEventListener('click',function(){ doAct(b.getAttribute('data-no'), b.getAttribute('data-act'), 0); }); });
    }).catch(function(){ body.innerHTML='<div class="cthm-empty errmsg">Couldn’t load right now.</div>'; });
  }
  function renew(orders){
    if(!orders.length){ body.innerHTML='<div class="cthm-empty">No subscriptions to renew yet.</div>'; return; }
    body.innerHTML='<p class="muted" style="margin:0 0 12px">Check a subscription and renew it — pay right here, no page change.</p>'+orders.map(function(o){
      return '<div class="cthm-row"><div style="flex:1;min-width:0"><div class="onm">'+esc(o.product_name||'Order')+'</div><div class="osub">'+esc(o.order_no)+'</div></div><button class="cbtn cbtn-g" data-renew="'+esc(o.order_no)+'">Check &amp; renew</button></div><div class="renew-out" data-for="'+esc(o.order_no)+'"></div>';
    }).join('');
    body.querySelectorAll('button[data-renew]').forEach(function(b){ b.addEventListener('click',function(){
      var no=b.getAttribute('data-renew'); var out=body.querySelector('.renew-out[data-for="'+no+'"]');
      out.innerHTML='<div class="muted" style="margin:6px 0 10px">Checking…</div>';
      fetch('/account/order/'+encodeURIComponent(no)+'/subscription',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
        if(!j||!j.ok||(!j.active&&!j.renewable)){ out.innerHTML='<div class="muted" style="margin:6px 0 10px">No renewable subscription for this order.</div>'; return; }
        var h='';
        if(j.expires_at){ var dl=(j.days_left!=null)?(' ('+(j.days_left>=0?(j.days_left+'d left'):(Math.abs(j.days_left)+'d ago'))+')'):''; h+='<div class="muted" style="margin:6px 0 8px">Expires '+esc(String(j.expires_at).slice(0,10))+dl+'</div>'; }
        if(j.renewable && j.slug && j.options && j.options.length){ h+=j.options.map(function(op){
          var price=(op.price_pkr!=null)?money(op.price_pkr):''; var dis=(op.idx==null||op.idx<0||op.price_pkr==null);
          return '<button class="cbtn cbtn-p" style="width:100%;margin-bottom:8px;justify-content:space-between"'+(dis?' disabled':(' data-ren-no="'+esc(no)+'" data-slug="'+esc(j.slug)+'" data-idx="'+op.idx+'" data-price="'+op.price_pkr+'" data-label="'+esc(op.label)+'"'))+'>'+esc(op.label)+'<span>'+price+'</span></button>';
        }).join(''); } else { h+='<a class="cbtn cbtn-p" style="width:100%" target="_blank" rel="noopener" href="https://wa.me/'+WANUM+'?text='+encodeURIComponent('Renew '+no)+'">Renew on WhatsApp</a>'; }
        out.innerHTML='<div style="margin:6px 0 10px">'+h+'</div>';
        out.querySelectorAll('button[data-ren-no]').forEach(function(ob){ ob.addEventListener('click',function(){ coStep({ no:ob.getAttribute('data-ren-no'), slug:ob.getAttribute('data-slug'), idx:ob.getAttribute('data-idx'), price:Number(ob.getAttribute('data-price'))||0, label:ob.getAttribute('data-label') }); }); });
      }).catch(function(){ out.innerHTML='<div class="muted errmsg" style="margin:6px 0 10px">Couldn’t check right now.</div>'; });
    }); });
  }
  function coStep(p){
    body.innerHTML='<button class="cthm-back" id="coBack">← Back</button><div style="margin:2px 0 12px"><div style="font-weight:800;font-size:16px">Renew — '+esc(p.label)+'</div><div class="muted">Order '+esc(p.no)+' · '+money(p.price)+'</div></div><div class="cthm-load">Loading payment options…</div>';
    document.getElementById('coBack').addEventListener('click',function(){ setTab('renew'); });
    fetch('/account/tools/pay-methods?amount='+encodeURIComponent(p.price),{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      var ms=(j&&j.methods)||[]; var load=body.querySelector('.cthm-load');
      if(!ms.length){ if(load) load.outerHTML='<div class="muted errmsg">No payment methods available — contact support.</div>'; return; }
      var html='<div class="cthm-f"><label>Payment method</label><div>'+ms.map(function(m,i){ return '<label class="co-m"><input type="radio" name="com" value="'+esc(m.key)+'"'+(i===0?' checked':'')+'><span>'+esc(m.name)+'</span><span class="muted" style="margin-left:auto">'+esc(m.pay||'')+'</span></label>'; }).join('')+'</div></div>'
        +'<div id="coAcct"></div>'
        +'<div class="cthm-f"><label>Transaction ID / sender name</label><input id="coTxn" type="text" placeholder="e.g. TID or who sent it"></div>'
        +'<div class="cthm-f"><label>Upload payment receipt</label><input id="coProof" type="file" accept="image/*,application/pdf"></div>'
        +'<div id="coOut"></div><button class="cbtn cbtn-p" style="width:100%" id="coSubmit">Submit Payment</button>';
      if(load) load.outerHTML=html;
      function acct(){ var k=(body.querySelector('input[name=com]:checked')||{}).value; var m=ms.filter(function(x){return x.key===k;})[0]; var box=document.getElementById('coAcct'); if(!box) return; if(!m||!(m.title||m.account||m.details)){ box.innerHTML=''; return; } var lines=m.details||((m.title?('Title: '+m.title):'')+(m.account?('\nAccount: '+m.account):'')); box.innerHTML='<div class="co-acct"><div class="muted" style="margin-bottom:4px">Send '+esc(m.pay||money(p.price))+' to:</div><pre style="margin:0;white-space:pre-wrap;background:#0e1627;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px;font-size:13px">'+esc(lines)+'</pre>'+(m.instructions?('<div class="muted" style="margin-top:6px">'+esc(m.instructions)+'</div>'):'')+'</div>'; }
      acct(); body.querySelectorAll('input[name=com]').forEach(function(r){ r.addEventListener('change',acct); });
      document.getElementById('coSubmit').addEventListener('click',function(){ submitRenew(p); });
    }).catch(function(){ var l=body.querySelector('.cthm-load'); if(l) l.outerHTML='<div class="muted errmsg">Couldn’t load payment options.</div>'; });
  }
  function submitRenew(p){
    var out=document.getElementById('coOut'), btn=document.getElementById('coSubmit');
    var method=(body.querySelector('input[name=com]:checked')||{}).value;
    var txn=(document.getElementById('coTxn')||{}).value||'';
    var pf=(document.getElementById('coProof')||{}).files; pf=pf&&pf[0];
    if(!method){ out.innerHTML='<div class="muted errmsg" style="margin:0 0 10px">Choose a payment method.</div>'; return; }
    if(!pf){ out.innerHTML='<div class="muted errmsg" style="margin:0 0 10px">Please upload your payment receipt.</div>'; return; }
    var fd=new FormData(); fd.append('product',p.slug); fd.append('plan',p.idx); fd.append('region','PK'); fd.append('method',method); fd.append('txn',txn); fd.append('renew',p.no); fd.append('proof',pf);
    btn.disabled=true; btn.textContent='Submitting…'; out.innerHTML='';
    fetch('/checkout',{method:'POST',body:fd,credentials:'same-origin'}).then(function(r){
      var m=String(r.url||'').match(/\/order\/([^\/?#]+)/); var newNo=m?decodeURIComponent(m[1]):null;
      if(!newNo){ out.innerHTML='<div class="muted errmsg">Submitted — check My Orders shortly.</div>'; btn.style.display='none'; return; }
      body.innerHTML='<div class="cthm-empty"><div class="cthm-load" id="coPoll">⏳ Payment submitted — verifying &amp; applying your renewal…</div></div>';
      pollRenew(newNo, p.no, 0);
    }).catch(function(){ out.innerHTML='<div class="muted errmsg">Couldn’t submit. Please try again.</div>'; btn.disabled=false; btn.textContent='Submit Payment'; });
  }
  function pollRenew(newNo, origNo, tries){
    fetch('/account/tools/order-status/'+encodeURIComponent(newNo),{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      if(j&&j.done){
        fetch('/account/order/'+encodeURIComponent(origNo)+'/subscription',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(s){
          var exp=(s&&s.expires_at)?(' New expiry: '+String(s.expires_at).slice(0,10)):'';
          body.innerHTML='<div class="cthm-empty"><div style="font-size:34px">✅</div><div class="okmsg" style="font-size:16px;margin-top:6px">Renewal applied</div><p class="muted">Your line has been extended.'+esc(exp)+'</p></div>';
        }).catch(function(){ body.innerHTML='<div class="cthm-empty"><div style="font-size:34px">✅</div><div class="okmsg" style="font-size:16px;margin-top:6px">Renewal applied</div></div>'; });
        return;
      }
      if(j && String(j.status||'').toLowerCase()==='failed'){ body.innerHTML='<div class="cthm-empty"><div class="errmsg" style="font-weight:700">Renewal couldn’t complete</div><p class="muted">If you paid, contact support and we’ll fix it.</p></div>'; return; }
      if(tries<40){ setTimeout(function(){ pollRenew(newNo,origNo,tries+1); },3000); }
      else { var el=document.getElementById('coPoll'); if(el) el.innerHTML='Still verifying — we’ll message you on WhatsApp once done. You can close this.'; }
    }).catch(function(){ if(tries<40) setTimeout(function(){ pollRenew(newNo,origNo,tries+1); },3000); });
  }
  function clBadge(st){ st=String(st||'').toLowerCase(); if(st==='replaced') return '<span class="cthm-pill ok">Replaced</span>'; if(st==='resolved') return '<span class="cthm-pill ok">Fixed</span>'; if(st==='rejected') return '<span class="cthm-pill bad">Declined</span>'; return '<span class="cthm-pill wait">In review</span>'; }
  function clElig(o){ var done=['delivered','completed','done'].indexOf(String(o.status||'').toLowerCase())>=0; return done && (o.under_warranty || !o.warranty_days); }
  function claimFeed(){
    var feed=document.getElementById('clFeed'); if(!feed) return;
    fetch('/account/tools/claims',{headers:{'X-Requested-With':'fetch'},credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
      var cl=(j&&j.claims)||[]; if(!cl.length) return;
      feed.innerHTML='<div class="cthm-sep">Your replacement requests</div>'+cl.map(function(i){
        var resp=i.admin_response?('<div class="cthm-resp"><span class="muted" style="font-size:11.5px">Our response</span><div>'+esc(i.admin_response)+'</div></div>'):'';
        var cred=i.credentials?('<div class="cthm-cred2"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><span class="muted">New access</span><button class="cbtn cbtn-g" style="padding:4px 11px;font-size:11.5px" data-cpy="'+esc(i.credentials)+'">Copy</button></div><pre>'+esc(i.credentials)+'</pre></div>'):'';
        var shot=i.has_shot?('<a class="cthm-shot" href="/account/tools/issue-file/'+i.id+'" target="_blank" rel="noopener">View attached proof →</a>'):'';
        return '<div class="cthm-claim"><div style="display:flex;justify-content:space-between;align-items:center;gap:8px"><div class="onm" style="font-size:13.5px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(i.product_name||i.order_no)+'</div>'+clBadge(i.status)+'</div><div class="osub" style="margin:2px 0 7px">'+esc(i.order_no)+' · '+fmtd(i.created_at)+'</div><div class="muted" style="white-space:pre-wrap">'+esc(i.message)+'</div>'+resp+cred+shot+'</div>';
      }).join('');
      feed.querySelectorAll('[data-cpy]').forEach(function(b){ b.addEventListener('click',function(){ try{ navigator.clipboard.writeText(b.getAttribute('data-cpy')); b.textContent='Copied ✓'; setTimeout(function(){b.textContent='Copy';},1400);}catch(e){} }); });
    }).catch(function(){});
  }
  function claim(orders){
    var elig=orders.filter(clElig);
    var form;
    if(!elig.length){ form='<div class="cthm-note">No orders are eligible for replacement right now. Only delivered items still under warranty can be replaced. Need help anyway? <a href="https://wa.me/'+WANUM+'" target="_blank" rel="noopener" style="color:#29d3ff;font-weight:600">Message us →</a></div>'; }
    else {
      var opts=elig.map(function(o){ return '<option value="'+esc(o.order_no)+'">'+esc(o.product_name||'Order')+' · '+esc(o.order_no)+'</option>'; }).join('');
      form='<div class="cthm-f"><label>Which order?</label><select id="clO">'+opts+'</select></div>'
        +'<div class="cthm-f"><label>What went wrong?</label><textarea id="clM" placeholder="Tell us what happened — e.g. password changed, screen limit, not loading…"></textarea></div>'
        +'<div class="cthm-f"><label>Screenshot <span class="muted">(optional — helps us fix it faster)</span></label><input id="clF" type="file" accept="image/*"></div>'
        +'<div id="clOut"></div><button class="cbtn cbtn-p" style="width:100%" id="clS">Submit Replacement</button>';
    }
    body.innerHTML='<p class="muted" style="margin:0 0 12px">Something not working? Request a free replacement — our team reviews every request and responds right here.</p>'+form+'<div id="clFeed"></div>';
    if(elig.length){
      document.getElementById('clS').addEventListener('click',function(){
        var btn=this,out=document.getElementById('clOut');
        var ono=document.getElementById('clO').value, msg=document.getElementById('clM').value;
        var f=(document.getElementById('clF')||{}).files; f=f&&f[0];
        if(!msg.trim()){ out.innerHTML='<div class="muted errmsg" style="margin:0 0 10px">Please describe the issue.</div>'; return; }
        var fd=new FormData(); fd.append('order_no',ono); fd.append('message',msg); if(f) fd.append('shot',f);
        btn.disabled=true; btn.textContent='Submitting…';
        fetch('/account/tools/claim',{method:'POST',body:fd,credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
          if(j&&j.ok){ body.innerHTML='<div class="cthm-empty"><div style="font-size:34px">✅</div><div class="okmsg" style="font-size:16px;margin-top:6px">Replacement requested</div><p class="muted">Our team is on it. You’ll see the decision here and we’ll message you on WhatsApp.</p><button class="cbtn cbtn-g" id="clDone" style="margin-top:6px">View my requests</button></div>'; var d=document.getElementById('clDone'); if(d) d.addEventListener('click',function(){ setTab('claim'); }); }
          else { out.innerHTML='<div class="muted errmsg" style="margin:0 0 10px">'+esc((j&&j.error)||'Could not submit. Please try again.')+'</div>'; btn.disabled=false; btn.textContent='Submit Replacement'; }
        }).catch(function(){ out.innerHTML='<div class="muted errmsg" style="margin:0 0 10px">Could not submit. Please try again.</div>'; btn.disabled=false; btn.textContent='Submit Replacement'; });
      });
    }
    claimFeed();
  }
  document.querySelectorAll('.cth-tile[data-tool]').forEach(function(el){ el.addEventListener('click',function(e){ e.preventDefault(); open(el.getAttribute('data-tool')); }); });
  tabs.forEach(function(t){ t.addEventListener('click',function(){ setTab(t.getAttribute('data-tab')); }); });
  modal.querySelectorAll('[data-close]').forEach(function(x){ x.addEventListener('click',close); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  // app-nav hook: open the tools modal from anywhere (bottom bar), and auto-open via ?tool=
  window.__gszTools=function(tab){ open(['purchases','code','renew','claim'].indexOf(tab)>=0?tab:'purchases'); };
  try{ var _qp=new URLSearchParams(location.search); var _t=_qp.get('tool'); if(_t){ open(['purchases','code','renew','claim'].indexOf(_t)>=0?_t:'purchases'); if(history.replaceState) history.replaceState(null,'',location.pathname); } }catch(e){}
})();
</script>
