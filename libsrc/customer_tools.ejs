<% /* Quick Access band — HOME ONLY. The Hub pop-up + all its JS live in hub_model.ejs (site-wide, included via app_nav). */ %>
<style>
  .cth{--p:#111a2e;--p2:#0e1627;--ph:#16203a;--ln:rgba(255,255,255,.08);--ln2:rgba(255,255,255,.14);--ink:#eef2fb;--ink2:#9aa6c0;--b:#2f7bff;--b2:#29d3ff;--grad:linear-gradient(135deg,#2f7bff,#29d3ff);--ok:#33d98a;--warn:#f4b64c;--bad:#f0554e;--pur:#9a6cff;--pink:#ff6cc4}
  .cth{max-width:1200px;margin:34px auto 38px;padding:0 20px}
  .cth-band{background:linear-gradient(135deg,rgba(47,123,255,.22),rgba(138,69,255,.15) 52%,rgba(41,211,255,.10));border:1px solid rgba(130,165,255,.32);border-radius:20px;padding:22px 24px;box-shadow:0 24px 58px -28px rgba(59,130,246,.55),inset 0 1px 0 rgba(255,255,255,.05);position:relative;overflow:hidden}
  .cth-band:before{content:"";position:absolute;top:-40%;right:-10%;width:360px;height:360px;background:radial-gradient(circle,rgba(41,211,255,.18),transparent 62%);pointer-events:none}
  .cth-h{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap}
  .cth-kick{color:var(--b2);font-weight:800;font-size:11.5px;letter-spacing:.09em}
  .cth-h h2{font-family:var(--display,inherit);font-weight:800;font-size:20px;letter-spacing:-.01em;margin:3px 0 0;color:var(--ink)}
  .cth-sub{color:var(--ink2);font-size:12.5px;text-align:right;max-width:240px}
  .cth-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  @media(max-width:760px){
    .cth{padding:0 14px}
    .cth-band{padding:18px 16px}
    .cth-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .cth-sub{display:none}
    .cth-grid .cth-tile{min-width:0;padding:12px;gap:10px}
    .cth-grid .cth-tile .cx{min-width:0;overflow:hidden}
    .cth-grid .cth-tile .ci{width:38px;height:38px}
    .cth-grid .cth-tile .ctt{white-space:normal;font-size:12.5px;line-height:1.2}
    .cth-grid .cth-tile .ctd{white-space:normal;font-size:10.5px;line-height:1.15}
  }
  .cth-tile{display:flex;align-items:center;gap:12px;padding:14px;border-radius:14px;background:var(--p);border:1px solid var(--ln);transition:.16s;cursor:pointer;text-align:left;color:var(--ink);text-decoration:none;font-family:inherit}
  .cth-tile:hover{border-color:rgba(47,123,255,.45);transform:translateY(-2px);box-shadow:0 10px 22px -14px rgba(0,0,0,.7)}
  .cth-tile .ci{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;flex:none}
  .cth-tile .ci svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.85;stroke-linecap:round;stroke-linejoin:round}
  .cth-tile .cx{min-width:0}
  .cth-tile .ctt{font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cth-tile .ctd{font-size:11.5px;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
</style>

<section class="cth">
  <div class="cth-band">
    <div class="cth-h">
      <div><div class="cth-kick">QUICK ACCESS</div><h2>Galaxy Hub</h2></div>
      <div class="cth-sub">Everything in one place — orders, access, renewals, trials &amp; support. No page hopping.</div>
    </div>
    <div class="cth-grid">
      <a class="cth-tile" href="/account" data-tool="purchases"><span class="ci" style="color:#9a6cff;background:rgba(154,108,255,.15)"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></span><span class="cx"><div class="ctt">My Subscriptions</div><div class="ctd">Orders &amp; active services</div></span></a>
      <a class="cth-tile" href="/account" data-tool="code"><span class="ci" style="color:#29d3ff;background:rgba(41,211,255,.14)"><svg viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.3-9.3"/><path d="m16 7 3 3"/><path d="m18 5 3 3"/></svg></span><span class="cx"><div class="ctt">Get Access</div><div class="ctd">Codes, links &amp; household</div></span></a>
      <a class="cth-tile" href="/account" data-tool="renew"><span class="ci" style="color:#33d98a;background:rgba(51,217,138,.14)"><svg viewBox="0 0 24 24"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></span><span class="cx"><div class="ctt">Renew Service</div><div class="ctd">Extend before expiry</div></span></a>
      <a class="cth-tile" href="/account" data-tool="iptvrenew"><span class="ci" style="color:#2fe0c0;background:rgba(47,224,192,.14)"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><path d="M16.5 8a3.5 3.5 0 1 0 .8 3.6"/><path d="M17 5v3h-3"/></svg></span><span class="cx"><div class="ctt">IPTV Renewal</div><div class="ctd">Renew any IPTV by username</div></span></a>
      <a class="cth-tile" href="/account" data-tool="trials"><span class="ci" style="color:#f4b64c;background:rgba(244,182,76,.15)"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="m17 2-5 5-5-5"/></svg></span><span class="cx"><div class="ctt">Free IPTV Trials</div><div class="ctd">Credentials, extend &amp; upgrade</div></span></a>
      <a class="cth-tile" href="/account" data-tool="claim"><span class="ci" style="color:#ff6cc4;background:rgba(255,108,196,.14)"><svg viewBox="0 0 24 24"><path d="m12 2 8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span><span class="cx"><div class="ctt">Claim / Replace</div><div class="ctd">Report or replace</div></span></a>
      <a class="cth-tile" href="/account" data-tool="account"><span class="ci" style="color:#5b8bff;background:rgba(91,139,255,.14)"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></span><span class="cx"><div class="ctt">My Account</div><div class="ctd">Details &amp; settings</div></span></a>
    </div>
  </div>
</section>
