<%- include('_shell_top', { active:'orders', title: (o.order_no || ('Order #'+o.id)) }) %>
<%
  var SB={ delivered:['#e7f8ee','#0b7a42'], delivering:['#e8f0ff','#1f5fd0'], approved:['#e8f0ff','#1f5fd0'], paid:['#e8f0ff','#1f5fd0'],
           verifying:['#fff2db','#b26a00'], pending:['#fff2db','#b26a00'], rejected:['#fdecec','#b42318'], cancelled:['#eef1f6','#667'] };
  var sc=SB[o.status]||['#eef1f6','#667'];
  function amt(){ return o.currency==='Rs' ? ('Rs '+Math.round(o.amount_display).toLocaleString('en-US')) : (o.currency+' '+Number(o.amount_display)); }
%>
<a class="btn btn-g" href="/admin/orders" style="margin-bottom:14px">← All orders</a>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

<div class="card" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
  <div style="flex:1;min-width:0">
    <div style="font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);font-weight:700">Order</div>
    <h1 style="font-size:24px;margin:2px 0 4px"><%= o.order_no || ('#'+o.id) %></h1>
    <div style="color:var(--muted);font-size:13.5px"><%= new Date(o.created_at).toLocaleString('en-GB') %></div>
  </div>
  <div style="text-align:right">
    <div style="font-family:'Schibsted Grotesk',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.02em"><%= amt() %></div>
    <span class="spill" style="background:<%= sc[0] %>;color:<%= sc[1] %>;font-size:12.5px;margin-top:4px"><%= o.status %></span>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 330px;gap:18px;align-items:start">
  <div>
    <div class="card">
      <h2 style="margin-bottom:10px">Order details</h2>
      <table><tbody>
        <tr><td style="color:var(--muted);width:150px">Product</td><td style="font-weight:600"><%= o.product_name %> — <%= o.plan_label %></td></tr>
        <tr><td style="color:var(--muted)">Quantity</td><td><%= o.qty %></td></tr>
        <tr><td style="color:var(--muted)">Amount</td><td style="font-weight:700"><%= amt() %> <span style="color:var(--muted);font-weight:500">(≈ $<%= Number(o.amount_usd) %> · Rs <%= Math.round(o.amount_pkr).toLocaleString('en-US') %>)</span></td></tr>
        <% if (o.discount_pkr && Number(o.discount_pkr)>0) { %><tr><td style="color:var(--muted)">Discount</td><td style="color:#0b7a42">− Rs <%= Math.round(o.discount_pkr).toLocaleString('en-US') %><%= o.coupon_code?(' · '+o.coupon_code):'' %></td></tr><% } %>
        <tr><td style="color:var(--muted)">Region</td><td><%= o.region || '—' %></td></tr>
        <tr><td style="color:var(--muted)">Method</td><td><%= o.method_name || '—' %></td></tr>
        <tr><td style="color:var(--muted)">Txn reference</td><td><%= o.txn_ref || '—' %></td></tr>
        <% if (o.note) { %><tr><td style="color:var(--muted)">Customer note</td><td><%= o.note %></td></tr><% } %>
      </tbody></table>
    </div>

    <div class="card">
      <h2 style="margin-bottom:10px">Customer</h2>
      <table><tbody>
        <tr><td style="color:var(--muted);width:150px">Email</td><td><%= o.email || '—' %></td></tr>
        <tr><td style="color:var(--muted)">WhatsApp</td><td><%= o.whatsapp || '—' %></td></tr>
      </tbody></table>
    </div>

    <% if (o.delivered_credentials) { %>
    <div class="card">
      <h2 style="margin-bottom:10px">Delivered credentials</h2>
      <pre style="white-space:pre-wrap;font-family:ui-monospace,Menlo,monospace;font-size:13px;background:#f7f9fe;border:1px solid var(--hair);border-radius:11px;padding:14px;margin:0"><%= o.delivered_credentials %></pre>
    </div>
    <% } %>

    <div class="card">
      <h2 style="margin-bottom:10px">Payment proof</h2>
      <% if (o.proof_file) { %>
        <a href="/admin/orders/proof/<%= o.proof_file %>" target="_blank">
          <img src="/admin/orders/proof/<%= o.proof_file %>" style="max-width:100%;border-radius:11px;border:1px solid var(--hair)" onerror="this.outerHTML='<p>Open proof file ↗</p>'">
        </a>
      <% } else { %><p class="hint" style="margin:0">No proof uploaded. Reference: <%= o.txn_ref || '—' %></p><% } %>
    </div>
  </div>

  <div>
    <div class="card">
      <h2 style="margin-bottom:12px">Update status</h2>
      <form method="post" action="/admin/orders/<%= o.id %>/status" style="display:flex;flex-direction:column;gap:9px">
        <label class="fld" style="margin:0 0 4px">Credentials / details to send (optional)</label>
        <textarea name="delivered_credentials" rows="3" placeholder="Login details, invite confirmation, or any note to include with the delivery…"><%= o.delivered_credentials || '' %></textarea>
        <button class="btn btn-p" name="status" value="delivered" type="submit" style="justify-content:center">Deliver &amp; notify customer</button>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px">
          <button class="btn btn-g" name="status" value="paid" type="submit" style="justify-content:center">Mark paid</button>
          <button class="btn btn-g" name="status" value="approved" type="submit" style="justify-content:center">Approve</button>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px">
          <button class="btn btn-g" name="status" value="pending" type="submit" style="justify-content:center">Pending</button>
          <button class="btn btn-g" style="color:#b42318;justify-content:center" name="status" value="rejected" type="submit">Reject</button>
        </div>
      </form>
      <p class="hint" style="margin:14px 0 0">“Deliver &amp; notify” marks the order delivered, messages the customer on WhatsApp and emails their order with the details above. Use it for vendor-invite orders the bot can’t auto-close.</p>
    </div>
    <div class="card">
      <h2 style="margin-bottom:10px">Contact</h2>
      <a class="btn btn-p" style="width:100%;justify-content:center" target="_blank" href="https://wa.me/<%= (o.whatsapp||'').replace(/[^0-9]/g,'') %>">Message on WhatsApp</a>
    </div>
  </div>
</div>
<style>@media(max-width:820px){div[style*="grid-template-columns:1fr 330px"]{grid-template-columns:1fr !important}}</style>
<%- include('_shell_bottom') %>
