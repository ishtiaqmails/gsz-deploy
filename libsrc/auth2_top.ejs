<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof title!=='undefined'?title:'Account' %> · Galaxy Subz × Zayron</title>
<link rel="icon" href="/static/img/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Schibsted+Grotesk:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root{--ink:#0f1836;--muted:#6b7490;--hair:#e6eaf3;--brand:#2f7bff;--brand2:#29d3ff;--grad:linear-gradient(135deg,#2f7bff,#29d3ff);--ok:#16a66a}
  *{box-sizing:border-box}
  body{margin:0;font-family:'Hanken Grotesk',system-ui,'Segoe UI',sans-serif;color:var(--ink);min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:24px;
    background:#f3f7fd;background-image:radial-gradient(1100px 520px at 14% -12%,rgba(47,123,255,.12),transparent 60%),radial-gradient(1000px 460px at 110% 118%,rgba(41,211,255,.14),transparent 55%)}
  .aw-wrap{width:100%;max-width:420px;animation:rise .5s cubic-bezier(.2,.7,.3,1) both}
  @keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .aw-card{background:#fff;border-radius:22px;box-shadow:0 2px 6px rgba(15,24,54,.05),0 30px 60px -32px rgba(15,24,54,.35);padding:32px 28px 28px}
  .aw-brand{display:flex;justify-content:center;margin-bottom:16px}
  .aw-brand img{height:50px;width:auto;max-width:230px;object-fit:contain;display:block}
  h1{font-family:'Schibsted Grotesk',sans-serif;font-size:23px;margin:0 0 5px;text-align:center;letter-spacing:-.02em}
  .aw-sub{color:var(--muted);font-size:14px;margin:0 auto 22px;text-align:center;max-width:320px;line-height:1.5}
  label,.fld{display:block;font-size:13px;font-weight:600;margin:0 0 7px}
  input,select{width:100%;padding:12px 13px;border-radius:11px;border:1px solid var(--hair);background:#f7fafe;font-size:14.5px;margin-bottom:15px;font-family:inherit;color:var(--ink);transition:.15s}
  input::placeholder{color:#aab2c8}
  input:focus,select:focus{outline:none;border-color:var(--brand);background:#fff;box-shadow:0 0 0 3px rgba(47,123,255,.14)}
  .aw-code{letter-spacing:.35em;font-weight:700;font-size:18px;text-align:center}
  .aw-btn{width:100%;background:var(--grad);color:#fff;font-weight:700;font-size:15px;border:0;border-radius:12px;padding:13px;cursor:pointer;margin-top:2px;box-shadow:0 14px 26px -12px rgba(47,123,255,.6);transition:.15s;font-family:inherit}
  .aw-btn:hover{filter:brightness(1.05)}.aw-btn:active{transform:translateY(1px)}
  .aw-err{background:#fdecec;color:#b42318;border:1px solid #f6c9c4;border-radius:11px;padding:11px 13px;font-size:13.5px;font-weight:600;margin-bottom:16px}
  .aw-ok{background:#eaf7f0;color:#12824f;border:1px solid #bfe6cf;border-radius:11px;padding:11px 13px;font-size:13.5px;font-weight:600;margin-bottom:16px}
  .aw-hint{color:var(--muted);font-size:12.5px;margin:-8px 0 14px}
  .aw-alt{text-align:center;color:var(--muted);font-size:13.5px;margin:14px 0 0}
  .aw-alt a{color:var(--brand);font-weight:700;text-decoration:none}
  .aw-row{display:flex;gap:8px;align-items:flex-start}
  .aw-row select{max-width:168px}
  .aw-back{display:block;text-align:center;color:var(--muted);font-size:12.5px;margin-top:16px;text-decoration:none;font-weight:600}
  .aw-back:hover{color:var(--brand)}
  @media(max-width:430px){ .aw-card{padding:26px 20px 22px;border-radius:18px} h1{font-size:21px} }
</style></head><body>
<div class="aw-wrap">
  <div class="aw-card">
    <a href="/" class="aw-brand"><img src="/static/img/logo.png" alt="Galaxy Subz × Zayron" onerror="this.style.display='none'"></a>
    <h1><%= typeof heading!=='undefined'?heading:'Account' %></h1>
    <% if (typeof sub!=='undefined' && sub) { %><p class="aw-sub"><%= sub %></p><% } %>
