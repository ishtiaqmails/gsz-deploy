<%- include('../partials/store_top') %>
<%- include('../partials/auth_style') %>
<main class="auth">
  <div class="wrap" style="display:flex;justify-content:center">
    <div class="auth-card">
      <span class="auth-badge"><span class="dot"></span>One quick step</span>
      <h1>Verify your email</h1>
      <p class="lead">We sent a 6-digit code to <b style="color:var(--ink)"><%= email %></b>. Enter it below to activate your account.</p>
      <% if (sent) { %><div class="okmsg">A fresh code is on its way — check your inbox (and spam).</div><% } %>
      <% if (!mailOn) { %><div class="note">Email isn't configured on the server yet, so the code can't be delivered. Add SMTP settings and tap “Resend code”, or verify from the admin side for now.</div><% } %>
      <% if (error) { %><div class="err"><%= error %></div><% } %>
      <form method="post" action="/account/verify-email">
        <label class="fld" for="code">Verification code</label>
        <input id="code" class="code-in" type="text" name="code" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code" required>
        <button class="btn btn-p btn-full" type="submit">Verify email</button>
      </form>
      <div class="linkrow">
        <form method="post" action="/account/verify-email/resend" style="margin:0"><button class="ghostbtn" type="submit">Resend code</button></form>
        <a class="ghostbtn" href="/account" style="text-decoration:none">Skip for now →</a>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/store_bottom') %>
