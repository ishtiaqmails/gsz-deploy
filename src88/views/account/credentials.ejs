<%- include('../partials/store_top') %>
<%- include('../partials/auth_style') %>
<main class="dash">
  <div class="wrap">
    <div class="dash-head">
      <div>
        <h1>Order credentials</h1>
        <p class="sub">Your login details, visible only to you.</p>
      </div>
      <a class="btn btn-g" href="/account">← Back to account</a>
    </div>

    <div class="dash-grid">
      <% if (denied) { %>
        <div class="dash-card"><div class="err" style="margin:0">This order isn't on your account. If you believe this is a mistake, contact support from your account.</div></div>
      <% } else if (!o) { %>
        <div class="dash-card"><div class="note" style="margin:0">We couldn't find that order.</div></div>
      <% } else { %>
        <div class="dash-card">
          <h2><%= o.product_name || 'Order' %><%= o.plan_label ? (' · '+o.plan_label) : '' %></h2>
          <div class="drow"><span class="k">Order</span><span class="v"><%= o.order_no %></span></div>
          <div class="drow"><span class="k">Status</span><span class="v"><span class="vbadge <%= (['delivered','completed','done'].indexOf(String(o.status||'').toLowerCase())>=0)?'ok':'no' %>"><%= o.status || 'pending' %></span></span></div>
          <% if (o.delivered_credentials) { %>
            <p class="fld" style="margin:18px 0 8px">Your details</p>
            <div style="background:var(--bg0);border:1px solid var(--line-2);border-radius:12px;padding:14px 15px;color:var(--ink);font-size:14.5px;line-height:1.6;white-space:pre-wrap;word-break:break-word;font-family:var(--display,monospace)"><%= o.delivered_credentials %></div>
            <p class="hint" style="margin-top:12px">Keep these private. This page is only visible when you're signed in to your account.</p>
          <% } else { %>
            <div class="note" style="margin-top:16px">Your order isn't delivered yet — your details will appear here as soon as it's ready. We'll message you on WhatsApp.</div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/store_bottom') %>
